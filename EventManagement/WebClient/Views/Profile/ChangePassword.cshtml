@model WebClient.DTOs.Request.ChangePasswordDTO
@{
    ViewData["Title"] = "Change Password";
    Layout = "_LayoutProfile";
}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/js/common/toast.js"></script>
<script src="~/js/common/loading.js"></script>

@if (TempData["ToastMessage"] != null)
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            showToast("@TempData["ToastType"]", "@TempData["ToastMessage"]");
        });
    </script>
}

<style>
    .profile-content {
        background: white;
        border-radius: 16px;
        padding: 2.5rem;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }

    .section-title {
        font-family: 'Poppins', sans-serif;
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .section-title::before {
            content: '';
            display: block;
            width: 4px;
            height: 24px;
            background: #6366f1;
            border-radius: 2px;
        }

    .form-label {
        font-weight: 600;
        color: #475569;
    }

    .input-group .form-control {
        border-right: none;
        border-radius: 10px 0 0 10px;
    }

    .input-group .btn-outline-secondary {
        border: 1px solid #e2e8f0;
        border-left: none;
        border-radius: 0 10px 10px 0;
        background: transparent;
        color: #94a3b8;
    }

    .btn-save {
        background: #6366f1;
        color: white;
        padding: 0.8rem 2rem;
        border-radius: 10px;
        font-weight: 600;
        border: none;
        transition: 0.3s;
    }

        .btn-save:hover {
            background: #4f46e5;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
        }
</style>

<div class="profile-content">
    <h4 class="section-title">Change Password</h4>
    <p class="text-muted mb-4">Please enter your current password and choose a strong new password.</p>

    <form asp-action="ChangePassword" method="post" id="changePasswordForm">
        @Html.AntiForgeryToken()

        <div class="row g-4">
            <div class="col-12">
                <label class="form-label">Current Password</label>
                <div class="input-group">
                    <input type="password" asp-for="CurrentPassword" class="form-control" placeholder="••••••••" required>
                    <button class="btn btn-outline-secondary toggle-pass" type="button"><i class="fa-solid fa-eye"></i></button>
                </div>
            </div>

            <div class="col-md-6">
                <label class="form-label">New Password</label>
                <div class="input-group">
                    <input type="password" id="NewPassword" asp-for="NewPassword" class="form-control" placeholder="Minimum 6 characters" required>
                    <button class="btn btn-outline-secondary toggle-pass" type="button"><i class="fa-solid fa-eye"></i></button>
                </div>
            </div>

            <div class="col-md-6">
                <label class="form-label">Confirm Password</label>
                <div class="input-group">
                    <input type="password" id="ConfirmPassword" asp-for="ConfirmPassword" class="form-control" placeholder="Repeat new password" required>
                    <button class="btn btn-outline-secondary toggle-pass" type="button"><i class="fa-solid fa-eye"></i></button>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end mt-5 pt-3 border-top">
            <a asp-action="Index" class="btn btn-light me-2 px-4" style="border-radius: 10px;">Cancel</a>
            <button type="submit" class="btn btn-save">Update Password</button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        // Password Visibility Toggle
        document.querySelectorAll('.toggle-pass').forEach(btn => {
            btn.addEventListener('click', function() {
                const input = this.parentElement.querySelector('input');
                const icon = this.querySelector('i');
                input.type = input.type === 'password' ? 'text' : 'password';
                icon.classList.toggle('fa-eye');
                icon.classList.toggle('fa-eye-slash');
            });
        });

        // Client-side Match Validation & Loading
        document.getElementById('changePasswordForm').addEventListener('submit', function(e) {
            const newPass = document.getElementById('NewPassword').value;
            const confirmPass = document.getElementById('ConfirmPassword').value;

            if (newPass !== confirmPass) {
                e.preventDefault();
                showToast("error", "The new password and confirmation do not match!");
                return;
            }

            if (typeof showLoading === "function") showLoading();
        });
    </script>
}