@model WebClient.DTOs.Response.ProfileDTO
@{
    ViewData["Title"] = "Profile Information";
    Layout = "_LayoutProfile";
}

@* Import các thư viện dùng chung *@
<script src="~/js/common/toast.js"></script>
<script src="~/js/common/loading.js"></script>

@if (TempData["ToastMessage"] != null)
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            showToast("@TempData["ToastType"]", "@TempData["ToastMessage"]");
        });
    </script>
}

<style>
    .profile-content {
        background: white;
        border-radius: 16px;
        padding: 2.5rem;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        height: 100%;
    }

    .section-title {
        font-family: 'Poppins', sans-serif;
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .section-title::before {
            content: '';
            display: block;
            width: 4px;
            height: 24px;
            background: #6366f1;
            border-radius: 2px;
        }

    .form-label {
        font-weight: 600;
        font-size: 0.9rem;
        color: #475569;
    }

    .form-control {
        border-radius: 10px;
        padding: 0.75rem 1rem;
        border: 1px solid #e2e8f0;
    }

        .form-control:focus {
            border-color: #6366f1;
            box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1);
        }

    .btn-save {
        background: #6366f1;
        color: white;
        border: none;
        padding: 0.8rem 2rem;
        border-radius: 10px;
        font-weight: 600;
        transition: 0.3s;
    }

        .btn-save:hover {
            background: #4f46e5;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
            color: white;
        }

    .avatar-wrapper {
        position: relative;
        width: 120px;
        height: 120px;
        margin: 0 auto 1.5rem;
        cursor: pointer;
    }

    .avatar-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.5);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        opacity: 0;
        transition: 0.2s;
    }

    .avatar-wrapper:hover .avatar-overlay {
        opacity: 1;
    }

    .drop-zone {
        border: 2px dashed #cbd5e1;
        background-color: #f8fafc;
        border-radius: 16px;
        padding: 3rem 1rem;
        text-align: center;
        cursor: pointer;
    }
</style>

<div class="profile-content">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="section-title mb-0">Personal Information</h4>
        <span class="badge @(Model.IsEmailVerified == true ? "bg-success-subtle text-success" : "bg-warning-subtle text-warning") p-2">
            <i class="fa-solid @(Model.IsEmailVerified == true ? "fa-user-check" : "fa-user-clock") me-1"></i>
            @(Model.IsEmailVerified == true ? "Verified Account" : "Unverified")
        </span>
    </div>

    <div class="text-center mb-4">
        <div class="avatar-wrapper shadow-sm" data-bs-toggle="modal" data-bs-target="#avatarUploadModal">
            <img src="@(string.IsNullOrEmpty(Model.AvatarUrl) ? "/images/default-avatar.png" : Model.AvatarUrl)"
                 class="w-100 h-100 rounded-circle object-fit-cover" id="main-profile-img">
            <div class="avatar-overlay">
                <i class="fa-solid fa-camera fa-lg"></i>
            </div>
        </div>
    </div>

    <form asp-action="UpdateProfile" method="post" id="formUpdateProfile">
        @Html.AntiForgeryToken()
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Full Name</label>
                <input type="text" name="FullName" class="form-control" value="@Model.FullName" placeholder="Your name" required>
            </div>
            <div class="col-md-6">
                <label class="form-label">Phone Number</label>
                <input type="tel" name="PhoneNumber" class="form-control" value="@Model.PhoneNumber" placeholder="Your phone number">
            </div>
            <div class="col-12">
                <label class="form-label">Email Address</label>
                <input type="email" class="form-control bg-light" value="@Model.Email" readonly disabled>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
            <p class="text-muted mb-0 small"><i class="fa-solid fa-calendar me-1"></i> Member since: @Model.CreatedAt?.ToString("MMM dd, yyyy")</p>
            <button type="submit" class="btn btn-save">Save Changes</button>
        </div>
    </form>
</div>

@* Modal Upload Avatar *@
<div class="modal fade" id="avatarUploadModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-bottom-0">
                <h5 class="modal-title fw-bold">Update Profile Picture</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <form asp-action="UploadAvatar" method="post" enctype="multipart/form-data" id="formUploadAvatar">
                    @Html.AntiForgeryToken()
                    <div id="dropZone" class="drop-zone">
                        <i class="fa-solid fa-cloud-arrow-up fa-3x mb-3 text-secondary"></i>
                        <h6 class="fw-bold">Drag & Drop image here</h6>
                        <p class="text-muted small">or click to browse</p>
                        <input type="file" id="fileInput" name="avatarFile" class="d-none" accept="image/*" />
                    </div>
                    <div id="previewZone" class="text-center d-none">
                        <img id="imagePreview" class="rounded-circle mb-3 object-fit-cover" style="width:150px; height:150px; border: 4px solid #eee;">
                        <div class="d-flex justify-content-center gap-2">
                            <button type="button" id="btnCancel" class="btn btn-light">Cancel</button>
                            <button type="submit" class="btn btn-save">Upload Now</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/lib/jquery/dist/jquery.min.js"></script>

<script src="~/js/common/toast.js"></script>
<script src="~/js/common/loading.js"></script>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Loading Overlay Trigger
            const forms = ['formUpdateProfile', 'formUploadAvatar'];
            forms.forEach(id => {
                document.getElementById(id).addEventListener('submit', () => {
                    if (typeof showLoading === "function") showLoading();
                });
            });

            // Avatar Logic
            const dropZone = document.getElementById('dropZone');
            const fileInput = document.getElementById('fileInput');
            const previewZone = document.getElementById('previewZone');
            const imagePreview = document.getElementById('imagePreview');

            dropZone.onclick = () => fileInput.click();
            fileInput.onchange = function() { if(this.files[0]) handlePreview(this.files[0]); };

            function handlePreview(file) {
                const reader = new FileReader();
                reader.onload = (e) => {
                    imagePreview.src = e.target.result;
                    dropZone.classList.add('d-none');
                    previewZone.classList.remove('d-none');
                };
                reader.readAsDataURL(file);
            }

            document.getElementById('btnCancel').onclick = () => {
                fileInput.value = '';
                previewZone.classList.add('d-none');
                dropZone.classList.remove('d-none');
            };
        });
    </script>
}