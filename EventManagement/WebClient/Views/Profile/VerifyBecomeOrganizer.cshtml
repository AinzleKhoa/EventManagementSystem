@model WebClient.DTOs.Request.VerifyOrganizerOtpDTO
@{
    ViewData["Title"] = "Verify Organizer Account";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-sm">
                <div class="card-body p-5 text-center">
                    <h4 class="card-title mb-4">Enter Verification Code</h4>
                    <p class="text-muted mb-4">
                        We have sent a 6-digit code to your email. This code is valid for 5 minutes.
                    </p>

                    <form asp-action="VerifyBecomeOrganizer" method="post">
                        <div class="form-group mb-4">
                            <input asp-for="OtpCode" class="form-control form-control-lg text-center font-weight-bold"
                                   placeholder="------" maxlength="6" autocomplete="off" required
                                   style="letter-spacing: 0.5rem; font-size: 1.5rem;" />
                        </div>
                        <button type="submit" class="btn btn-success btn-lg w-100">
                            Verify and Upgrade
                        </button>
                    </form>

                    <div class="mt-4">
                        <span class="text-muted">Didn't receive the code?</span>
                        <form asp-action="RequestBecomeOrganizerOtp" method="post" class="d-inline">
                            <button type="submit" class="btn btn-link p-0 m-0 align-baseline text-decoration-none">
                                Resend
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>