@model WebClient.DTOs.Response.ReadOrderDTO
@using System.Text.Json

@{
    ViewData["Title"] = "Order Details";
    Layout = "_LayoutProfile";
    var payment = Context.Request.Query["payment"].ToString();

    // Phân loại màu trạng thái từ Model
    var statusColor = Model.Status == "Paid" || Model.Status == "Completed" ? "success" :
                      Model.Status == "Pending" ? "warning" : "danger";
}

<style>
    /* Ticket Stub Design */
    .ticket-stub {
        background: #fff;
        border: 1px solid #dee2e6;
        border-radius: 0.75rem;
        position: relative;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        border-left: 6px solid var(--ticket-color);
    }

        .ticket-stub:hover {
            transform: translateY(-2px);
            box-shadow: 0 0.25rem 0.75rem rgba(0, 0, 0, 0.08);
        }

    .ticket-left {
        padding: 1rem;
        border-bottom: 2px dashed #dee2e6;
        background-color: #f8f9fa;
        text-align: center;
    }

    .ticket-right {
        padding: 1rem;
        flex-grow: 1;
    }

    @@media (min-width: 768px) {
        .ticket-stub {
            flex-direction: row;
        }

        .ticket-left {
            border-bottom: none;
            border-right: 2px dashed #dee2e6;
            width: 150px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }
    }

    .qr-container {
        width: 90px;
        height: 90px;
        margin: 0 auto;
        border-radius: 8px;
        background: #fff;
        padding: 4px;
        border: 1px solid #e9ecef;
    }

    /* Làm mờ QR nếu chưa thanh toán (Pending) */
    .qr-blur {
        filter: blur(5px);
        user-select: none;
        pointer-events: none;
    }

    /* Scrollable Container */
    .ticket-scroll-box {
        max-height: 600px;
        overflow-y: auto;
        overflow-x: hidden;
        padding-right: 10px;
    }

        .ticket-scroll-box::-webkit-scrollbar {
            width: 6px;
        }

        .ticket-scroll-box::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 10px;
        }

        .ticket-scroll-box::-webkit-scrollbar-thumb {
            background: #c1c1c1;
            border-radius: 10px;
        }

            .ticket-scroll-box::-webkit-scrollbar-thumb:hover {
                background: #a8a8a8;
            }
    /* Star Rating Custom CSS */
    .star-rating {
        display: flex;
        flex-direction: row-reverse;
        justify-content: center;
        gap: 0.5rem;
    }

        .star-rating input[type="radio"] {
            display: none;
        }

        .star-rating label {
            font-size: 2.5rem;
            color: #e4e5e9;
            cursor: pointer;
            transition: color 0.2s ease, transform 0.2s ease;
        }
            /* Hiệu ứng hover và khi được chọn */
            .star-rating input[type="radio"]:checked ~ label,
            .star-rating label:hover,
            .star-rating label:hover ~ label {
                color: #ffc107; /* Màu vàng sao */
            }

            .star-rating label:active {
                transform: scale(0.9);
            }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <a asp-action="MyOrders" class="text-decoration-none text-muted fw-semibold">
        <i class="bi bi-arrow-left me-1"></i> Back to Orders
    </a>

   
</div>
@if (Model != null)
{
    <div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-5">
        <div class="row g-0">
            <div class="col-md-4 col-lg-3 bg-light">
                <img src="@Model.PosterUrl"
                     class="img-fluid h-100 w-100 object-fit-cover"
                     style="min-height: 200px;"
                     alt="@Model.EventName">
            </div>

            <div class="col-md-8 col-lg-9 p-4">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <h4 class="fw-bold mb-1 text-dark">@Model.EventName</h4>
                        <div class="text-muted small">
                            <span>Order #@Model.OrderId</span> •
                            <span>@Model.OrderDate?.ToString("MMM dd, yyyy HH:mm")</span>
                        </div>
                    </div>
                    <span class="badge bg-@(statusColor)-subtle text-@statusColor px-3 py-2 rounded-pill fw-semibold border border-@(statusColor)-subtle">
                        <i class="bi bi-circle-fill me-1" style="font-size: 0.45rem; vertical-align: middle;"></i>
                        @Model.Status
                    </span>
                </div>

                <div class="row mt-4">
                    <div class="col-sm-6 mb-3 mb-sm-0">
                        <h6 class="text-muted small text-uppercase fw-bold mb-2">Schedule</h6>
                        <p class="mb-1 text-dark fw-medium" style="font-size: 0.9rem;">
                            <i class="bi bi-calendar-check text-primary me-2"></i>
                            @Model.StartDate?.ToString("MMM dd, yyyy") - @Model.EndDate?.ToString("MMM dd, yyyy")
                        </p>
                        <p class="mb-0 text-dark fw-medium" style="font-size: 0.9rem;">
                            <i class="bi bi-clock text-primary me-2"></i>
                            @Model.StartDate?.ToString("HH:mm") to @Model.EndDate?.ToString("HH:mm")
                        </p>
                    </div>

                    <div class="col-sm-6">
                        <h6 class="text-muted small text-uppercase fw-bold mb-2">Payment Details</h6>
                        <p class="mb-1 text-dark fw-medium" style="font-size: 0.9rem;">
                            <i class="bi bi-credit-card text-primary me-2"></i>
                            Method: @Model.PaymentMethod
                        </p>
                        <p class="mb-0 text-dark fw-medium" style="font-size: 0.9rem;">
                            <i class="bi bi-receipt text-primary me-2"></i>
                            Txn ID: @(string.IsNullOrEmpty(Model.TransactionId) ? "N/A" : Model.TransactionId)
                        </p>
                    </div>
                </div>

                <hr class="my-4">

                <div class="bg-light rounded-3 p-3">
                    @if (Model.OrderDetails != null)
                    {
                        foreach (var detail in Model.OrderDetails)
                        {
                            <div class="d-flex justify-content-between mb-2 small text-dark">
                                <span>@(detail.TicketType?.TypeName ?? "Standard Ticket") <span class="text-muted ms-1">x@(detail.Quantity)</span></span>
                                <span>@((detail.UnitPrice * detail.Quantity).ToString("N0")) đ</span>
                            </div>
                        }
                    }

                    <div class="d-flex justify-content-between mb-2 small text-dark">
                        <span>Discount</span>
                        <span class="text-danger">-@((Model.DiscountAmount ?? 0).ToString("N0")) đ</span>
                    </div>

                    <div class="d-flex justify-content-between border-top pt-2 mt-2">
                        <strong class="text-dark">Total Amount</strong>
                        <strong class="text-primary fs-5">@Model.FinalAmount.ToString("N0") đ</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-end mb-3">
        <h5 class="fw-bold mb-0">My Tickets (@(Model.Tickets?.Count ?? 0))</h5>
    </div>

    @if (Model.Status == "Pending")
    {
        <div class="alert alert-warning border-0 rounded-3 shadow-sm d-flex align-items-center mb-4">
            <i class="bi bi-exclamation-triangle-fill fs-4 me-3 text-warning"></i>
            <div>
                <strong>Payment Pending!</strong><br />
                <span class="small">Please complete your payment to activate and reveal your ticket QR codes.</span>
            </div>
        </div>
    }

    <div class="ticket-scroll-box">
        <div class="row row-cols-1 row-cols-lg-2 g-3 mb-2">
            @if (Model.Tickets != null)
            {
                foreach (var ticket in Model.Tickets)
                {
                    // Lấy màu từ nested object TicketType, nếu không có thì set màu default
                    var ticketColor = string.IsNullOrEmpty(ticket.TicketType?.ColorCode) ? "#0d6efd" : ticket.TicketType.ColorCode;
                    var isQrBlurred = Model.Status == "Pending";
                    var typeName = ticket.TicketType?.TypeName ?? "Standard";

                    var qrData = new
                    {
                        ticketId = ticket.TicketId,
                        ticketCode = ticket.TicketCode,
                        attendee = ticket.OwnerName,
                        eventName = Model.EventName,
                        orderId = Model.OrderId
                    };

                    var qrContent = JsonSerializer.Serialize(qrData);
                    var encodedQrData = Uri.EscapeDataString(qrContent);


                    <div class="col">
                        <div class="ticket-stub h-100 shadow-sm" style="--ticket-color: @ticketColor;">

                            <div class="ticket-left">
                                <div class="qr-container @(isQrBlurred ? "qr-blur" : "")">
                                    <img src="https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=@encodedQrData"
                                         alt="QR Code"
                                         class="img-fluid" />
                                </div>
                                <div class="mt-2 font-monospace text-muted" style="font-size: 0.65rem; word-break: break-all;">
                                    ID: @ticket.TicketCode
                                </div>
                            </div>

                            <div class="ticket-right d-flex flex-column justify-content-center">
                                <div class="d-flex justify-content-between align-items-start mb-1">
                                    <h6 class="fw-bold mb-0" style="color: @ticketColor;">@typeName</h6>
                                    <span class="badge @(ticket.Status == "Active" ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary") border rounded-pill" style="font-size: 0.7rem;">
                                        @ticket.Status
                                    </span>
                                </div>

                                <p class="text-muted small mb-2 fw-medium">@Model.EventName</p>

                                <div class="mt-auto pt-2 border-top border-light">
                                    <div class="small text-muted mb-1" style="font-size: 0.75rem;">ATTENDEE</div>
                                    <div class="fw-semibold text-dark"><i class="bi bi-person me-1 text-muted"></i>@ticket.OwnerName</div>
                                </div>
                            </div>

                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center text-muted py-4">
                    No tickets available for this order.
                </div>
            }
        </div>
    </div>
    @if (Model.Status == "Paid")
    {
        <div class="modal fade" id="ratingModal" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content rounded-4 border-0 shadow">

                    <div class="modal-header border-0">
                        <h5 class="modal-title fw-bold text-primary">
                            <i class="bi bi-star-fill me-2"></i>
                            Rate "@Model.EventName"
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>

                    <form id="ratingForm">
                        <div class="modal-body">

                            <div class="text-center mb-4">
                                <div class="star-rating">
                                    <input type="radio" name="rating" id="star5" value="5"><label for="star5">★</label>
                                    <input type="radio" name="rating" id="star4" value="4"><label for="star4">★</label>
                                    <input type="radio" name="rating" id="star3" value="3"><label for="star3">★</label>
                                    <input type="radio" name="rating" id="star2" value="2"><label for="star2">★</label>
                                    <input type="radio" name="rating" id="star1" value="1"><label for="star1">★</label>
                                </div>
                                <div class="small text-muted mt-2">
                                    Click to select your rating
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">Your Comment</label>
                                <textarea class="form-control rounded-3"
                                  rows="3"
                                  name="comment"
                                  placeholder="Share your experience..."></textarea>
                            </div>

                        </div>

                        <div class="modal-footer border-0">
                            <button type="button" class="btn btn-light rounded-pill px-4"
                                    data-bs-dismiss="modal">
                                Cancel
                            </button>
                            <button type="submit"
                                    class="btn btn-primary rounded-pill px-4">
                                Submit Review
                            </button>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    }

}
else
{
    <div class="text-center text-muted py-5 mt-5">
        <i class="bi bi-bag-x fs-1 d-block mb-3"></i>
        <h5>Order not found</h5>
        <p>The order details could not be loaded.</p>
    </div>
}
@section Scripts {
    <script src="~/js/common/toast.js"></script>
    <script src="~/js/common/loading.js"></script>
} 
<script>
    document.getElementById("ratingForm")?.addEventListener("submit", function (e) {
        e.preventDefault();

        const rating = document.querySelector('input[name="rating"]:checked');
        const comment = document.querySelector('textarea[name="comment"]').value;

        if (!rating) {
            alert("Please select a rating ⭐");
            return;
        }

        const reviewData = {
            orderId: @Model.OrderId,
            rating: rating.value,
            comment: comment
        };

        console.log("Review Data:", reviewData);

        // TODO: Gửi API ở đây
        // fetch("/api/review", {...})

        alert("Thank you for your review ❤️");

        const modal = bootstrap.Modal.getInstance(document.getElementById("ratingModal"));
        modal.hide();
    });
</script>

@if (payment != null && !string.IsNullOrEmpty(payment))
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            showToast(
                "@payment",
                "Booking success"
            );
        });
    </script>
}