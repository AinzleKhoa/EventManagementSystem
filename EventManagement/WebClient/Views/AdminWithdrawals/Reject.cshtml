@model WebClient.DTOs.Request.RejectReasonDTO
@{
    ViewData["Title"] = "Reject Withdrawal Request";
    Layout = "_LayoutAdmin";
    var w = ViewBag.Withdrawal as WebClient.DTOs.Response.ReadWithdrawalDTO;
}

<div class="mb-4">
    <a asp-action="Index" class="text-decoration-none text-muted fw-medium mb-2 d-inline-block">
        <i class="fa-solid fa-arrow-left me-1"></i> Back to Withdrawal Management
    </a>
</div>

<div class="card-section mx-auto" style="background:white;border-radius:16px;padding:2rem;box-shadow:0 4px 6px -1px rgba(0,0,0,0.05);max-width:600px;margin: 0 auto;">
    <h5 class="fw-bold text-danger mb-3">
        <i class="fa-solid fa-circle-xmark me-2"></i>
        Reject Withdrawal Request
    </h5>

    @if (w != null)
    {
        <div class="mb-4 p-3 bg-light rounded">
            <div class="row g-2">
                <div class="col-6"><small class="text-muted d-block">Request #</small><strong>@w.WithdrawalId</strong></div>
                <div class="col-6"><small class="text-muted d-block">Amount</small><strong class="text-primary">@w.Amount.ToString("N0") ₫</strong></div>
                <div class="col-6"><small class="text-muted d-block">Bank</small><strong>@w.BankName</strong></div>
                <div class="col-6"><small class="text-muted d-block">Account</small><strong>@w.BankAccountNumber</strong></div>
                <div class="col-12"><small class="text-muted d-block">Account Holder</small><strong>@w.BankAccountName</strong></div>
                <div class="col-12"><small class="text-muted d-block">Organizer ID</small><strong>#@w.OrganizerId</strong></div>
            </div>
        </div>
    }

    <form asp-action="Reject" method="post">
        <input type="hidden" asp-for="WithdrawalId" />

        <div class="mb-3">
            <label class="form-label fw-semibold" style="color:#475569;">
                Reason for Rejection <span class="text-danger">*</span>
            </label>
            <textarea asp-for="RejectReason" class="form-control" rows="4"
                      style="border-radius:10px;border:1px solid #e2e8f0;padding:0.75rem 1rem;"
                      placeholder="Explain why this request is being rejected..."></textarea>
            <span asp-validation-for="RejectReason" class="text-danger small"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-danger">
                <i class="fa-solid fa-xmark me-1"></i> Confirm Reject
            </button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

@if (TempData["ToastMessage"] != null)
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            showToast("@TempData["ToastMessage"]", "@TempData["ToastType"]");
        });
    </script>
}
<script src="~/js/toast.js"></script>
