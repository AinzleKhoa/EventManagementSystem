@model WebClient.DTOs.Request.ForgotPasswordDTO
@{
    ViewData["Title"] = "Forgot Password";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HoviFlow - Forgot Password</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/auth/login_style.css" />
</head>
<body>

    <div class="container-fluid g-0">
        <div class="row g-0 login-container">

            <!-- LEFT BANNER (giữ nguyên style login) -->
            <div class="col-lg-6 login-banner">
                <div>
                    <h1 class="mb-3">Recover.<br>Secure.<br>Access.</h1>
                    <p class="lead">
                        Enter your email and we will send you an OTP
                        to reset your password.
                    </p>
                </div>
            </div>

            <!-- RIGHT FORM -->
            <div class="col-lg-6 login-form-wrapper">
                <div class="form-content">

                    <a asp-controller="Home" asp-action="Index" class="brand-logo">
                        HoviFlow
                    </a>

                    <div class="mb-4">
                        <h2 class="fw-bold text-dark">Forgot Password 🔐</h2>
                        <p class="text-secondary">
                            Please enter your email address.
                        </p>
                    </div>

                    <form asp-controller="Authentication"
                          asp-action="ForgotPassword"
                          method="post">

                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label small fw-bold text-secondary"></label>
                            <input asp-for="Email" class="form-control" placeholder="name@example.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 mb-3">
                            Send OTP
                        </button>
                    </form>

                    <div class="text-center mt-3">
                        <a asp-action="Login" class="text-link">
                            Back to Login
                        </a>
                    </div>

                </div>
            </div>

        </div>
    </div>

    <script src="~/js/common/toast.js"></script>
    <script src="~/js/common/loading.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
 
    @if (TempData["ToastMessage"] != null)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                showToast(
                    "@TempData["ToastType"]",
                    "@TempData["ToastMessage"]"
                );
            });
        </script>
    }

</body>
</html>