@model WebClient.DTOs.Request.RegisterDTO
@{
    ViewData["Title"] = "Register";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HoviFlow - Create Account</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/auth/register_style.css" />

</head>
<body>

    <div class="container-fluid g-0">
        <div class="row g-0 register-container">

            <div class="col-lg-6 register-banner">
                <div>
                    <h1 class="mb-3">Join the<br>Community.</h1>
                    <p class="lead">
                        Get access to exclusive events, personalized recommendations, and seamless booking experiences tailored just for you.
                    </p>
                </div>

                <div class="glass-card">
                    <div class="d-flex text-warning mb-3">
                        <i class="fa-solid fa-star"></i>
                        <i class="fa-solid fa-star"></i>
                        <i class="fa-solid fa-star"></i>
                        <i class="fa-solid fa-star"></i>
                        <i class="fa-solid fa-star"></i>
                    </div>
                    <p class="fst-italic mb-3 fs-6">
                        "EventHub changed how I spend my weekends. Finding concerts and booking tickets has never been this smooth and exciting!"
                    </p>
                    <div class="d-flex align-items-center mt-3 border-top border-white border-opacity-25 pt-3">
                        <img src="https://randomuser.me/api/portraits/women/44.jpg" class="rounded-circle me-3 border border-2 border-white" width="45" height="45" alt="User Avatar">
                        <div>
                            <h6 class="mb-0 fw-bold">Sarah Jenkins</h6>
                            <small class="opacity-75">Verified User</small>
                        </div>
                    </div>
                </div>

                <div class="position-absolute bottom-0 end-0 p-4 opacity-50">
                    <i class="fa-solid fa-ticket fa-5x text-white" style="transform: rotate(-15deg); opacity: 0.3;"></i>
                </div>
            </div>

            <div class="col-lg-6 register-form-wrapper">
                <div class="form-content">

                    <a asp-controller="Home" asp-action="Index" class="brand-logo">
                        <i class="fa-solid fa-ticket me-2"></i>HoviFlow
                    </a>

                    <div class="mb-4">
                        <h2 class="fw-bold text-dark">Create Account</h2>
                        <p class="text-secondary">Start your journey with us today.</p>
                    </div>

                    <form asp-controller="Authentication"
                          asp-action="Register"
                          method="post">

                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label small fw-bold text-secondary"></label>
                            <input asp-for="FullName" class="form-control" placeholder="e.g. John Doe" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label small fw-bold text-secondary"></label>
                            <input asp-for="Email" type="email" class="form-control" placeholder="name@example.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label small fw-bold text-secondary"></label>
                            <div class="input-group">
                                <input asp-for="Password"
                                       type="password"
                                       class="form-control"
                                       placeholder="Create a password"
                                       style="border-right:0;" />
                                <span class="input-group-text bg-transparent border-start-0"
                                      style="border-radius: 0 12px 12px 0;">
                                    <i class="fa-regular fa-eye text-muted" id="togglePassword" style="cursor:pointer;"></i>
                                </span>
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ConfirmPassword" class="form-label small fw-bold text-secondary"></label>
                            <div class="input-group">
                                <input asp-for="ConfirmPassword"
                                       type="password"
                                       class="form-control"
                                       placeholder="Repeat your password"
                                       style="border-right:0;" />
                                <span class="input-group-text bg-transparent border-start-0"
                                      style="border-radius: 0 12px 12px 0;">
                                    <i class="fa-regular fa-eye text-muted" id="toggleConfirmPassword" style="cursor:pointer;"></i>
                                </span>
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PhoneNumber" class="form-label small fw-bold text-secondary"></label>
                            <input asp-for="PhoneNumber"
                                   class="form-control"
                                   placeholder="Optional phone number" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">
                            Create Account
                        </button>
                    </form>

                    <div class="divider"><span>OR</span></div>

                    <button class="btn btn-google w-100 mb-3">
                        <img src="https://www.svgrepo.com/show/475656/google-color.svg" alt="Google" width="20" height="20">
                        Sign up with Google
                    </button>

                    <div class="text-center mt-3">
                        <p class="small text-secondary">
                            Already have an account?
                            <a asp-controller="Authentication" asp-action="Login" class="text-link">Log In</a>
                        </p>
                    </div>

                </div>
            </div>

        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>

    <script src="~/js/common/toast.js"></script>
    <script src="~/js/common/loading.js"></script>

    <script>
        $(document).ready(function () {
            $('#togglePassword').click(function () {
                var input = $('#Password');
                var type = input.attr('type') === 'password' ? 'text' : 'password';
                input.attr('type', type);
                
                var icon = $(this);
                if (type === 'password') {
                    icon.removeClass('fa-eye-slash').addClass('fa-eye');
                } else {
                    icon.removeClass('fa-eye').addClass('fa-eye-slash');
                }
            });

            $('#toggleConfirmPassword').click(function () {
                var input = $('#ConfirmPassword');
                var type = input.attr('type') === 'password' ? 'text' : 'password';
                input.attr('type', type);
                
                var icon = $(this);
                if (type === 'password') {
                    icon.removeClass('fa-eye-slash').addClass('fa-eye');
                } else {
                    icon.removeClass('fa-eye').addClass('fa-eye-slash');
                }
            });
        });
    </script>

    @if (TempData["ToastMessage"] != null)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                if (typeof window.showToast === 'function') {
                    window.showToast(
                        "@TempData["ToastType"]",
                        `@Html.Raw(TempData["ToastMessage"])`
                    );
                }
            });
        </script>
    }
</body>
</html>