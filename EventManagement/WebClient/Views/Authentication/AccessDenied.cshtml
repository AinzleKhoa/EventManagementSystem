@{
    ViewData["Title"] = "Access Denied";
    Layout = "_Layout";
}

<div class="container d-flex justify-content-center" style="margin-top:100px;">
    <div class="text-center">

        <h1 class="display-1 text-danger fw-bold">403</h1>

        <h3 class="fw-semibold mb-3">Access Denied</h3>

        <p class="text-muted mb-4">
            You do not have permission to access this page.
            <br />
            Please contact the administrator if you think this is a mistake.
        </p>

        <div class="d-flex justify-content-center gap-3">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4">
                Back to Home
            </a>

            @* <a asp-controller="Authentication" asp-action="Login" class="btn btn-outline-secondary px-4">
                Login Again
            </a> *@
        </div>

    </div>
</div>