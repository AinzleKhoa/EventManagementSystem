@model WebClient.DTOs.Request.ResetPasswordDTO
@{
    ViewData["Title"] = "Reset Password";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HoviFlow - Reset Password</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/auth/login_style.css" />
</head>
<body>

    <div class="container-fluid g-0">
        <div class="row g-0 login-container">

            <div class="col-lg-6 login-banner">
                <div>
                    <h1 class="mb-3">New Password.<br>Fresh Start.</h1>
                    <p class="lead">
                        Enter the OTP sent to your email
                        and create a new password.
                    </p>
                </div>
            </div>

            <div class="col-lg-6 login-form-wrapper">
                <div class="form-content">

                    <a asp-controller="Home" asp-action="Index" class="brand-logo">
                        HoviFlow
                    </a>

                    <div class="mb-4">
                        <h2 class="fw-bold text-dark">Reset Password 🔑</h2>
                    </div>

                    <form asp-controller="Authentication"
                          asp-action="ResetPassword"
                          method="post">

                        <input asp-for="Email" type="hidden" />

                        <div class="mb-3">
                            <label asp-for="Otp" class="form-label small fw-bold text-secondary"></label>
                            <input asp-for="Otp" class="form-control" />
                            <span asp-validation-for="Otp" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label small fw-bold text-secondary"></label>
                            <input asp-for="NewPassword" type="password" class="form-control" />
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ConfirmPassword" class="form-label small fw-bold text-secondary"></label>
                            <input asp-for="ConfirmPassword" type="password" class="form-control" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 mb-3">
                            Reset Password
                        </button>
                    </form>

                    <div class="text-center mt-3">
                        <a asp-action="Login" class="text-link">
                            Back to Login
                        </a>
                    </div>

                </div>
            </div>

        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/common/toast.js"></script>
    <script src="~/js/common/loading.js"></script>

    @if (TempData["ToastMessage"] != null)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                if (typeof window.showToast === 'function') {
                    window.showToast(
                        "@TempData["ToastType"]",
                        `@Html.Raw(TempData["ToastMessage"])`
                    );
                }
            });
        </script>
    }

</body>
</html>