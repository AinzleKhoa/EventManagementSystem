@model WebClient.DTOs.Request.LoginDTO
@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HoviFlow - Login</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@600;700&display=swap"
          rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <link rel="stylesheet" href="~/css/auth/login_style.css" />
</head>
<body>

    <div class="container-fluid g-0">
        <div class="row g-0 login-container">

            <div class="col-lg-6 login-banner">

                <div>
                    <h1 class="mb-3">Connect.<br>Experience.<br>Live.</h1>
                    <p class="lead">
                        Join the largest community of event goers and
                        organizers. Discover what's happening around you.
                    </p>
                </div>

                <div class="glass-card">
                    <div class="d-flex text-warning mb-3">
                        <i class="fa-solid fa-star"></i>
                        <i class="fa-solid fa-star"></i>
                        <i class="fa-solid fa-star"></i>
                        <i class="fa-solid fa-star"></i>
                        <i class="fa-solid fa-star"></i>
                    </div>
                    <p class="fst-italic mb-3 fs-6">
                        "The best platform to manage my events. The analytics tools are powerful and easy to use. Highly recommended!"
                    </p>
                    <div class="d-flex align-items-center mt-3 border-top border-white border-opacity-25 pt-3">
                        <img src="https://randomuser.me/api/portraits/men/32.jpg"
                             class="rounded-circle me-3 border border-2 border-white"
                             width="45" height="45" alt="User">
                        <div>
                            <h6 class="mb-0 fw-bold">Alex Johnson</h6>
                            <small class="opacity-75">
                                Event
                                Organizer
                            </small>
                        </div>
                    </div>
                </div>

                <div class="position-absolute bottom-0 end-0 p-4 opacity-50">
                    <i class="fa-solid fa-calendar-check fa-5x text-white"
                       style="transform: rotate(-15deg); opacity: 0.3;"></i>
                </div>

            </div>

            <div class="col-lg-6 login-form-wrapper">
                <div class="form-content">

                    <a asp-controller="Home" asp-action="Index" class="brand-logo">
                        <i class="fa-solid fa-ticket me-2"></i>HoviFlow
                    </a>

                    <div class="mb-4">
                        <h2 class="fw-bold text-dark">Welcome back! 👋</h2>
                        <p class="text-secondary">
                            Please enter your details
                            to sign in.
                        </p>
                    </div>

                    <form asp-controller="Authentication" asp-action="Login" method="post">

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label small fw-bold text-secondary">
                                Email Address
                            </label>
                            <input asp-for="Email" class="form-control" placeholder="name@example.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <label asp-for="Password" class="form-label small fw-bold text-secondary">Password</label>
                                <a asp-controller="Authentication" asp-action="ForgotPassword" class="small text-link">
                                    Forgot Password?
                                </a>
                            </div>
                            <div class="input-group">
                                <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" style="border-right:0;" />
                                <span class="input-group-text bg-transparent border-start-0" style="border-radius: 0 12px 12px 0; border: 1px solid #e2e8f0; border-left: none;">
                                    <i class="fa-regular fa-eye text-muted" id="togglePassword" style="cursor:pointer;"></i>
                                </span>
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 mb-3">
                            Sign In
                        </button>
                    </form>

                    <div class="divider"><span>OR</span></div>

                    <button type="button" id="googleBtn" class="btn btn-google w-100">
                        <img src="https://www.svgrepo.com/show/475656/google-color.svg"
                             alt="Google" width="20" height="20">
                        Sign in with Google
                    </button>

                    <div class="text-center mt-4">
                        <p class="small text-secondary">
                            Don't have an account?
                            <a asp-controller="Authentication" asp-action="Register" class="text-link">
                                Create
                                free account
                            </a>
                        </p>
                    </div>

                </div>
            </div>

        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/js/common/toast.js"></script>
    <script src="~/js/common/loading.js"></script>
    <script src="https://accounts.google.com/gsi/client" async defer></script>

    <script>
        window.onload = function () {

            google.accounts.id.initialize({
                client_id: "107920772632-cvvrpc8l853oegva1eonnlmatml9fem1.apps.googleusercontent.com",
                callback: handleGoogleResponse
            });

            document.getElementById("googleBtn")
                .addEventListener("click", function () {

                    google.accounts.id.prompt();
                });
        };

        $(document).ready(function () {
            $('#togglePassword').click(function () {
                var passwordInput = $('#Password');
                var type = passwordInput.attr('type') === 'password' ? 'text' : 'password';
                passwordInput.attr('type', type);
                
                var icon = $(this);
                if (type === 'password') {
                    icon.removeClass('fa-eye-slash').addClass('fa-eye');
                } else {
                    icon.removeClass('fa-eye').addClass('fa-eye-slash');
                }
            });
        });

        function handleGoogleResponse(response) {

            var idToken = response.credential;

            fetch('/Authentication/GoogleLogin', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ idToken: idToken }),
                redirect: "follow"
            })
            .then(res => {
                if (res.redirected) {
                    window.location.href = res.url;
                }
                else if (res.ok) {
                    window.location.reload();
                }
                else {
                    showToast(
                        `danger`,
                        `Google login failed`
                    );
                }
            })
            .catch(err => {
                showToast(
                    `danger`,
                    `Google login error: ${err}`
                );
            });
        }
    </script>

    @if (TempData["ToastMessage"] != null)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                showToast(
                    "@TempData["ToastType"]",
                    "@TempData["ToastMessage"]"
                );
            });
        </script>
    }

</body>

</html>
