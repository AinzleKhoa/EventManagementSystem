@{
    ViewData["Title"] = "Payment Cancelled";
    Layout = "_Layout";
}

<div class="container d-flex justify-content-center align-items-center" style="height: 80vh;">
    <div class="card shadow-lg p-5 text-center" style="max-width: 500px; border-radius: 15px;">

        <div class="mb-4">
            <i class="bi bi-x-circle-fill text-danger" style="font-size: 70px;"></i>
        </div>

        <h2 class="text-danger mb-3">Payment Failed</h2>

        <p class="text-muted">
            Your payment was cancelled or could not be completed.
            Please try again or choose a different payment method.
        </p>

        <div class="mt-4">
            <a href="/" class="btn btn-outline-secondary me-2">
                Back to Home
            </a>

            <a href="/Profile/MyOrders" class="btn btn-danger">
                View My Orders
            </a>
        </div>
    </div>
</div>