@using NuGet.Protocol
@using WebClient.DTOs.Response
@{
    ViewData["Title"] = "Checkout";
    Layout = "_Layout";
}
@model WebClient.ViewModel.CheckoutViewModel

<link href="~/css/booking/checkout_style.css" rel="stylesheet" />

<div class="container" style="padding-top: 40px;">

    <div class="step-indicator">
        <div class="step completed">
            <div class="step-circle"><i class="fa-solid fa-check"></i></div>
            <span>Selection</span>
        </div>
        <div class="step-line"></div>
        <div class="step active">
            <div class="step-circle">2</div>
            <span>Information</span>
        </div>
        <div class="step-line"></div>
        <div class="step">
            <div class="step-circle">3</div>
            <span>Payment</span>
        </div>
    </div>
    <form asp-action="Checkout" asp-controller="Booking" method="post" id="checkoutForm">
        <input type="hidden" asp-for="EventId" />
        <input type="hidden" asp-for="PaymentMethod" id="paymentMethodInput" />
        <input type="hidden" asp-for="CustomerId" id="customerId" />

        @if (Model?.Tickets != null)
        {
            for (int i = 0; i < Model.Tickets.Count; i++)
            {
                <input type="hidden" name="Tickets[@i].TicketTypeId" value="@Model.Tickets[i].TicketTypeId" />
                <input type="hidden" name="Tickets[@i].Quantity" value="@Model.Tickets[i].Quantity" />
                <input type="hidden" name="Tickets[@i].TicketTypeName" value="@Model.Tickets[i].TicketTypeName" />
                <input type="hidden" name="Tickets[@i].Price" value="@Model.Tickets[i].Price" />
            }
        }

        <div class="checkout-container row">

            <div class="col-lg-8">

                <div class="card-box">
                    <h5 class="section-title"><i class="fa-regular fa-id-card text-primary"></i> Contact Information</h5>

                    <div class="row g-3">

                        <div class="col-md-6">
                            <label class="form-label">Full Name</label>
                            <input asp-for="FullName" class="form-control" placeholder="Enter your name">
                            <span asp-validation-for="FullName" class="validation-text"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Phone Number</label>
                            <input asp-for="Phone" class="form-control" placeholder="Enter phone number">
                            <span asp-validation-for="Phone" class="validation-text"></span>
                        </div>

                        <div class="col-12">
                            <label class="form-label">Email Address</label>
                            <input asp-for="Email" class="form-control" placeholder="Enter email">
                            <span asp-validation-for="Email" class="validation-text"></span>

                            <small class="text-muted">
                                <i class="fa-solid fa-circle-info me-1"></i>
                                Tickets will be sent to this email.
                            </small>
                        </div>

                    </div>
                </div>

                <div class="card-box">
                    <h5 class="section-title"><i class="fa-regular fa-credit-card text-primary"></i> Payment Method</h5>

                    <div class="payment-option"
                         id="payment-option"
                         onclick="selectPayment(this, 'VNPay')">
                        <div class="radio-custom"></div>
                        <img src="https://cdn.haitrieu.com/wp-content/uploads/2022/10/Icon-VNPAY-QR.png" style="height: 32px; width: 32px; object-fit: contain;" alt="VNPay Logo">
                        <div>
                            <div class="fw-bold">VNPay</div>
                            <small class="text-muted">Instant payment via QR Code</small>
                        </div>
                    </div>

                    <div class="payment-option"
                         id="payment-option"
                         onclick="selectPayment(this, 'Momo')">
                        <div class="radio-custom"></div>
                        <img src="~/images/images.png" style="height: 32px; width: 32px; object-fit: contain;" alt="Momo Logo">
                        <div>
                            <div class="fw-bold">Momo Wallet</div>
                            <small class="text-muted">Instant payment via QR Code</small>
                        </div>
                    </div>

                    @* <div class="payment-option"
                         onclick="selectPayment(this, 'BANK_TRANSFER')">
                        <div class="radio-custom"></div>
                        <i class="fa-solid fa-building-columns fa-lg text-primary"></i>
                        <div>
                            <div class="fw-bold">Bank Transfer</div>
                            <small class="text-muted">Manual transfer via QR</small>
                        </div>
                    </div>  *@

                </div>

            </div>

            <div class="col-lg-4">
                <div class="summary-card">
                    <h5 class="fw-bold mb-4">Order Summary</h5>

                    <div class="event-mini-header">
                        <img src="@Model.Event.PosterUrl" class="event-mini-img" alt="Event">
                        <div>
                            <h6 class="fw-bold mb-1" style="font-size: 1rem; line-height: 1.4;">
                                @Model.Event.Title
                            </h6>
                            <small class="text-muted">
                                <i class="fa-regular fa-calendar me-1"></i>
                                @Model.Event.StartDate.ToString("MMM dd, yyyy")
                            </small>
                        </div>
                    </div>


                    <div class="mb-3">
                        @foreach (var ticket in Model.Tickets)
                        {
                            <div class="d-flex justify-content-between mb-2 text-muted small">
                                <span>@ticket.Quantity x <strong>@ticket.TicketTypeName</strong></span>
                                <span>@( (ticket.Quantity * ticket.Price).ToString("N0") ) đ</span>
                            </div>
                        }
                    </div>

                    <hr class="opacity-25 my-3">

                    <div class="summary-row">
                        <span class="text-muted">Subtotal</span>
                        <span>@Model.SubTotal.ToString("N0") đ</span>
                    </div>


                    @* <div class="input-group mt-3 mb-2">
                        <input type="text" class="form-control form-control-sm" placeholder="Discount Code">
                        <button class="btn btn-outline-primary btn-sm">Apply</button>
                    </div> *@

                    <div class="mt-3 mb-2">

                        <button type="button"
                                class="btn btn-outline-primary w-100 py-2"
                                style="border-radius: 10px; border-style: dashed;"
                                data-bs-toggle="modal"
                                data-bs-target="#voucherModal">
                            <i class="fa-solid fa-ticket me-1"></i> Choose Voucher
                        </button>

                        <div id="selectedVoucherBox" class="mt-2 p-2 border rounded d-none">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <strong id="selectedVoucherCode"></strong>
                                    <div class="small text-muted" id="selectedVoucherDetail"></div>
                                </div>

                                <button type="button"
                                        class="btn btn-sm btn-outline-danger"
                                        onclick="removeVoucher()">
                                    Remove
                                </button>
                            </div>
                        </div>

                    </div>

                    <div class="summary-row">
                        <span class="text-muted">Discount</span>
                        <input hidden asp-for="DiscountAmount" id="discount" value="0" />
                        <input hidden asp-for="VoucherId" id="voucherId" />
                        <input hidden asp-for="UserVoucherId" id="userVoucherId" />
                        <span id="discountAmount">0 đ</span>
                    </div>

                    <div class="summary-row total-row d-flex justify-content-between">
                        <span>Total</span>
                        <span id="totalAmount" class="text-primary">@Model.TotalAmount.ToString("N0") đ</span>
                    </div>

                    <button type="button" class="btn-confirm mt-4" onclick="validateAndSubmit()">
                        Complete Payment
                    </button>

                    <div class="text-center mt-3">
                        <small class="text-muted" style="font-size: 0.75rem;">
                            By clicking "Complete Payment", you agree to our <a href="#" class="text-primary">Terms of Service</a>.
                        </small>
                    </div>
                </div>
            </div>

        </div>
    </form>
</div>
<div class="modal fade" id="voucherModal">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Your Vouchers</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                @{
                    var userVouchers = ViewBag.UserVoucher as IEnumerable<ReadUserVoucherDTO>;
                }

                @if (userVouchers != null && userVouchers.Any())
                {
                    @foreach (var uv in userVouchers)
                    {

                        <div class="voucher-item"
                             data-code="@uv.Voucher.Code"
                             data-type="@uv.Voucher.DiscountType"
                             data-value="@uv.Voucher.DiscountValue"
                             data-id="@uv.Voucher.VoucherId"
                             data-userVoucherId="@uv.Id"
                             onclick="selectVoucher(this)">

                            <div class="voucher-left">
                                @if (uv.Voucher.DiscountType == "Percent")
                                {
                                    <span class="voucher-value">@uv.Voucher.DiscountValue%</span>
                                    <span class="voucher-type">OFF</span>
                                }
                                else
                                {
                                    <span class="voucher-value">@((uv.Voucher.DiscountValue / 1000).ToString("0"))k</span>
                                    <span class="voucher-type">OFF</span>
                                }
                            </div>

                            <div class="voucher-info">
                                <div class="voucher-code">@uv.Voucher.Code</div>
                                <div class="voucher-desc">
                                    @if (uv.Voucher.DiscountType == "Percent")
                                    {
                                        <span>Discount @uv.Voucher.DiscountValue% for this order</span>
                                    }
                                    else
                                    {
                                        <span>Discount @uv.Voucher.DiscountValue.ToString("N0") đ directly</span>
                                    }
                                </div>
                                <div class="voucher-meta">
                                    <span><i class="fa-regular fa-clock me-1"></i> Exp: @(uv.Voucher.ValidTo != null ? uv.Voucher.ValidTo : "N/A")</span>
                                    <span><i class="fa-solid fa-layer-group me-1"></i> Qty: @uv.Quantity</span>
                                </div>
                            </div>

                            <div class="voucher-check">
                                <i class="fa-solid fa-circle-check"></i>
                            </div>
                        </div>

                    }
                }
                else
                {
                    <div class="empty-state">
                        <i class="fa-solid fa-ticket-simple"></i>
                        <h6 class="fw-bold text-secondary">No Vouchers Available</h6>
                        <p class="small text-muted mb-0">You don't have any vouchers applicable for this event.</p>
                    </div>
                }

            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/js/common/toast.js"></script>

    <script>
        let subtotal = @Model.SubTotal;
        let discount = 0;
        let selectedVoucher = null;
        let total = @Model.TotalAmount;

        document.addEventListener("DOMContentLoaded", function () {
            updatePaymentState();
        });

        function updatePaymentState() {

            const paymentOptions = document.querySelectorAll(".payment-option");

            paymentOptions.forEach(option => {

                if (total === 0) {
                    option.classList.add("disabled");
                    option.setAttribute("aria-disabled", "true");
                } else {
                    option.classList.remove("disabled");
                    option.setAttribute("aria-disabled", "false");
                }

            });
        }

        function selectVoucher(element){

            document.querySelectorAll(".voucher-item").forEach(v=>{
                v.classList.remove("selected");
            });

            element.classList.add("selected");

            let voucherId = element.dataset.id;
            let userVoucherId = element.dataset.uservoucherid;
            let code = element.dataset.code;
            let type = element.dataset.type;
            let value = parseFloat(element.dataset.value);

            selectedVoucher = {userVoucherId,voucherId,code,type,value};

            applyVoucher();

            let modal = bootstrap.Modal.getInstance(document.getElementById('voucherModal'));
            modal.hide();
        }

        function applyVoucher(){

            if(!selectedVoucher) return;

            console.log("Applying voucher:", selectedVoucher);

            if(selectedVoucher.type === "Percent"){
                discount = subtotal * (selectedVoucher.value / 100);
            }else{
                discount = selectedVoucher.value;
            }

            let total = subtotal - discount;
            if(total < 0) total = 0;

            document.getElementById("discountAmount").innerText =
                discount.toLocaleString() + " đ";

            document.getElementById("discount").value = discount;
            document.getElementById("voucherId").value = selectedVoucher.voucherId;
            document.getElementById("userVoucherId").value = selectedVoucher.userVoucherId;

            console.log("userVoucherId input value set to:", document.getElementById("userVoucherId").value);

            document.getElementById("totalAmount").innerText =
                total.toLocaleString() + " đ";

            document.getElementById("selectedVoucherBox").classList.remove("d-none");

            document.getElementById("selectedVoucherCode").innerText =
                selectedVoucher.code;

            document.getElementById("selectedVoucherDetail").innerText =
                selectedVoucher.type === "Percent"
                ? selectedVoucher.value + "% discount"
                : selectedVoucher.value.toLocaleString() + " đ discount";
        }

        function removeVoucher(){

            selectedVoucher = null;
            discount = 0;

            document.getElementById("discountAmount").innerText = "0 đ";
            document.getElementById("totalAmount").innerText =
                subtotal.toLocaleString() + " đ";

            document.getElementById("selectedVoucherBox").classList.add("d-none");

            document.getElementById("voucherId").value = "";
            document.getElementById("userVoucherId").value = "";

            document.querySelectorAll(".voucher-item").forEach(v=>{
                v.classList.remove("selected");
            });

        }
        function selectPayment(element, method) {

            document.querySelectorAll('.payment-option').forEach(el => {
                el.classList.remove('selected');
            });

            element.classList.add('selected');
            document.getElementById('paymentMethodInput').value = method;
        }

        function validateAndSubmit() {
            const paymentMethod = document.getElementById('paymentMethodInput').value;
            
            if(total > 0) {
                if (!paymentMethod || paymentMethod.trim() === '') {
                    showToast('danger', 'Please select a payment method to continue.');
                    return;
                }
            }
            // Nếu hợp lệ thì mới gọi lệnh submit thật, lúc này loading.js mới bắt sự kiện
            document.getElementById('checkoutForm').requestSubmit();
        }
    </script>
    @* Đặt loading.js ở cuối để đảm bảo nó chạy sau cùng *@
    <script src="~/js/common/loading.js"></script>
}

@if (TempData["ToastMessage"] != null)
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            showToast(
                "@TempData["ToastType"]",
                "@TempData["ToastMessage"]"
            );
        });
    </script>
}