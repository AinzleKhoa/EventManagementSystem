@model WebClient.DTOs.Response.ReadEventDTO
@using WebClient.DTOs.Response
@{
    ViewData["Title"] = "Event Review";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<style>
    .card-section {
        background: white;
        border-radius: 12px;
        padding: 2rem;
        margin-bottom: 2rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    }

    .detail-label {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: #64748b;
        font-weight: 600;
        margin-bottom: 0.4rem;
    }

    .detail-value {
        font-size: 1rem;
        font-weight: 500;
        color: #1e293b;
    }

    #eventMap {
        height: 300px;
        width: 100%;
        border-radius: 8px;
        margin-top: 1rem;
        border: 1px solid #e2e8f0;
        z-index: 1;
    }

    .stat-item {
        padding: 1rem 0;
        border-bottom: 1px solid rgba(255,255,255,0.1);
    }

    .stat-item:last-child {
        border-bottom: none;
    }

    .rejection-alert {
        background: #fef2f2;
        border: 1px solid #fee2e2;
        border-radius: 8px;
        padding: 1rem;
    }
</style>

<div class="container-fluid py-4">
    <!-- Back Link -->
    <a asp-action="Pending" class="text-decoration-none text-muted mb-2 d-inline-block small fw-500">
        <i class="fa-solid fa-arrow-left me-1"></i> Back to Queue
    </a>

    <!-- Header: Title & Status -->
    <div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-3">
        <div class="flex-grow-1">
            <h2 class="fw-bold text-dark mb-2">@Model.Title</h2>
            <div class="d-flex align-items-center gap-3 flex-wrap">
                @if (Model.Status == "Pending")
                {
                    <span class="badge bg-warning text-dark px-3 py-2 rounded-pill">
                        <i class="fa-solid fa-hourglass-half me-1"></i> Pending Review
                    </span>
                }
                else if (Model.Status == "Approved" || Model.Status == "Published")
                {
                    <span class="badge bg-success text-white px-3 py-2 rounded-pill">
                        <i class="fa-solid fa-circle-check me-1"></i> Approved
                    </span>
                }
                else if (Model.Status == "Rejected")
                {
                    <span class="badge bg-danger text-white px-3 py-2 rounded-pill">
                        <i class="fa-solid fa-xmark me-1"></i> Rejected
                    </span>
                }
                <span class="text-muted small">
                    <i class="fa-solid fa-calendar me-1"></i> Start date @Model.StartDate.ToString("dd MMM yyyy")
                </span>
            </div>
        </div>

        <!-- Admin Action Buttons -->
        <div class="btn-group-custom d-flex gap-2 flex-wrap">
            @if (Model.Status == "Pending")
            {
                <!-- Show for Pending Events -->
                <button type="button" class="btn btn-sm btn-success fw-bold" onclick="return confirm('✓ Approve this event? It will be published immediately.');" data-bs-toggle="modal" data-bs-target="#approveModal">
                    <i class="fa-solid fa-check me-1"></i> Approve
                </button>

                <button type="button" class="btn btn-sm btn-danger fw-bold" data-bs-toggle="modal" data-bs-target="#rejectModal">
                    <i class="fa-solid fa-xmark me-1"></i> Reject
                </button>
            }
            else if (Model.Status == "Approved" || Model.Status == "Published")
            {
                <!-- Show for Approved Events -->
                <button type="button" class="btn btn-sm btn-warning fw-bold" data-bs-toggle="modal" data-bs-target="#suspendModal">
                    <i class="fa-solid fa-pause me-1"></i> Suspend Event
                </button>
            }
        </div>
    </div>

    @if (Model.Status == "Rejected" && !string.IsNullOrEmpty(Model.RejectedReason))
    {
        <div class="alert alert-danger border-0 shadow-sm mb-4" role="alert">
            <div class="d-flex align-items-start gap-3">
                <i class="fa-solid fa-triangle-exclamation fa-lg mt-1 flex-shrink-0"></i>
                <div>
                    <h6 class="fw-bold mb-1">Previous Rejection Reason</h6>
                    <p class="mb-0 text-opacity-75">@Model.RejectedReason</p>
                </div>
            </div>
        </div>
    }

    <div class="row g-4">
        <!-- Left Column: Main Content -->
        <div class="col-lg-8">
            <!-- Event Description -->
            <div class="card-section">
                <h5 class="fw-bold mb-3 text-primary">
                    <i class="fa-solid fa-align-left me-2"></i>Description
                </h5>
                <p class="text-secondary mb-0" style="white-space: pre-line; line-height: 1.6;">
                    @Model.Description
                </p>
            </div>

            <!-- Date & Location -->
            <div class="card-section">
                <h5 class="fw-bold mb-3 text-primary">
                    <i class="fa-solid fa-calendar-days me-2"></i>Date & Location
                </h5>

                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="detail-label">Start Date & Time</div>
                        <div class="detail-value">
                            <i class="fa-regular fa-calendar-check me-2 text-primary"></i>
                            @Model.StartDate.ToString("dd MMM yyyy, HH:mm")
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="detail-label">End Date & Time</div>
                        <div class="detail-value">
                            <i class="fa-regular fa-calendar-xmark me-2 text-danger"></i>
                            @Model.EndDate.ToString("dd MMM yyyy, HH:mm")
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="detail-label">Venue Location</div>
                    <div class="detail-value mb-3">
                         <i class="fa-solid fa-location-dot me-2 text-danger"></i>@Model.Location
                     </div>
                     <div id="eventMap" style="height: 300px; border-radius: 10px; margin-bottom: 10px;"></div>
                     <small class="text-muted d-block mt-2">
                         <i class="fa-solid fa-info-circle me-1"></i> Map position based on coordinates pinned by organizer.
                     </small>
                    </div>

                    <!-- Address is now displayed as a single consolidated Location field above -->
                </div>
            </div>

            <!-- Ticket Configuration -->
            <div class="card-section">
                <h5 class="fw-bold mb-4 text-primary">
                    <i class="fa-solid fa-ticket me-2"></i>Ticket Configuration
                </h5>

                @if (Model.TicketTypes?.Any() != true)
                {
                    <div class="text-center py-5 text-muted">
                        <i class="fa-solid fa-ticket-simple fa-3x mb-2 opacity-50"></i>
                        <p>No ticket types defined for this event.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr class="text-uppercase small text-muted">
                                    <th>Type</th>
                                    <th>Color</th>
                                    <th>Price</th>
                                    <th>Quantity</th>
                                    <th>Sale Period</th>
                                    <th class="text-end">Est. Revenue</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var t in Model.TicketTypes!)
                                {
                                    var estRevenue = t.Quantity * t.Price;
                                    <tr>
                                        <td class="fw-bold">
                                            <span>@t.TypeName</span>
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="color-preview" style="width: 30px; height: 30px; background-color: @t.ColorCode; border-radius: 6px; border: 1px solid #e2e8f0;"></div>
                                                <small class="text-muted">@t.ColorCode</small>
                                            </div>
                                        </td>
                                        <td>@t.Price.ToString("N0") @Html.Raw("\u0111")</td>
                                        <td>@t.Quantity</td>
                                        <td>
                                            <small class="text-muted">
                                                @(t.SaleStartDate.HasValue ? t.SaleStartDate.Value.ToString("dd/MM/yyyy HH:mm") : "Anytime")
                                                <br />
                                                <i class="fa-solid fa-arrow-down fa-xs"></i>
                                                <br />
                                                @(t.SaleEndDate.HasValue ? t.SaleEndDate.Value.ToString("dd/MM/yyyy HH:mm") : "Until Event")
                                            </small>
                                        </td>
                                        <td class="text-end fw-bold text-success">@estRevenue.ToString("N0") @Html.Raw("\u0111")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <!-- Right Column: Sidebar -->
        <div class="col-lg-4">
            <!-- Poster -->
            <div class="card-section p-0 overflow-hidden mb-4">
                <div class="p-3 bg-light border-bottom small text-muted fw-bold">
                    <i class="fa-solid fa-image me-2"></i>Event Poster
                </div>
                <img src="@(string.IsNullOrEmpty(Model.PosterUrl) ? "https://placehold.co/600x800?text=No+Poster" : Model.PosterUrl)"
                     class="img-fluid w-100" style="object-fit: cover; min-height: 200px;" alt="Event Poster">
            </div>

            <!-- Event Summary -->
            <div class="card-section bg-light mb-4">
                <h6 class="fw-bold mb-3 text-primary">
                    <i class="fa-solid fa-info-circle me-2"></i>Event Summary
                </h6>

                <div class="row g-3">
                    <div class="col-12">
                        <div class="detail-label">Organizer</div>
                        <div class="detail-value">@Model.OrganizerName</div>
                    </div>
                    <div class="col-12">
                        <div class="detail-label">Category</div>
                        <div class="detail-value">@Model.CategoryName</div>
                    </div>
                    <div class="col-12">
                        <div class="detail-label">Total Tickets</div>
                        <div class="detail-value">
                            @{
                                int totalQty = 0;
                                if (Model.TicketTypes != null && Model.TicketTypes.Count > 0)
                                {
                                    foreach (var t in Model.TicketTypes)
                                    {
                                        totalQty += t.Quantity;
                                    }
                                }
                            }
                            @totalQty
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="detail-label">Est. Total Revenue</div>
                        <div class="detail-value text-success fw-bold">
                            @{
                                long totalRevenue = 0;
                                if (Model.TicketTypes != null && Model.TicketTypes.Count > 0)
                                {
                                    foreach (var t in Model.TicketTypes)
                                    {
                                        totalRevenue += (long)t.Quantity * t.Price;
                                    }
                                }
                            }
                            @totalRevenue.ToString("N0") @Html.Raw("\u0111")
                        </div>
                    </div>
                </div>
            </div>

            <!-- Moderation Actions (Sticky) -->
            <div class="card-section sticky-top" style="top: 20px; z-index: 1020;">
                <h6 class="fw-bold mb-3 text-primary">
                    <i class="fa-solid fa-gavel me-2"></i>
                    @if (Model.Status == "Pending")
                    {
                        <text>Moderation Actions</text>
                    }
                    else if (Model.Status == "Approved" || Model.Status == "Published")
                    {
                        <text>Event Management</text>
                    }
                    else
                    {
                        <text>Actions</text>
                    }
                </h6>

                @if (Model.Status == "Pending")
                {
                    <p class="small text-muted mb-3">Please review the event content carefully before making a decision.</p>
                }
                else if (Model.Status == "Approved" || Model.Status == "Published")
                {
                    <p class="small text-muted mb-3">This event is currently approved and published. You can suspend it if needed.</p>
                }

                <div class="d-grid gap-2">
                    @if (Model.Status == "Pending")
                    {
                        <form asp-action="Approve" method="post" onsubmit="return confirm('✓ Approve this event? It will be published immediately.');">
                            <input type="hidden" name="id" value="@Model.EventId" />
                            <button type="submit" class="btn btn-success w-100 fw-bold py-2">
                                <i class="fa-solid fa-check me-1"></i> Approve Event
                            </button>
                        </form>

                        <button type="button" class="btn btn-outline-danger w-100 fw-bold py-2" data-bs-toggle="modal" data-bs-target="#rejectModal">
                            <i class="fa-solid fa-xmark me-1"></i> Reject Event
                        </button>
                    }
                    else if (Model.Status == "Approved" || Model.Status == "Published")
                    {
                        <button type="button" class="btn btn-warning w-100 fw-bold py-2" data-bs-toggle="modal" data-bs-target="#suspendModal">
                            <i class="fa-solid fa-pause me-1"></i> Suspend Event
                        </button>
                        <small class="text-muted text-center">Suspending will move this event back to rejected status</small>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        const adminEventLat = @(Model.Latitude.HasValue ? Model.Latitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "null");
        const adminEventLng = @(Model.Longitude.HasValue ? Model.Longitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "null");
        const adminEventAddress = "@(Model.Location?.Replace("\"", "\\\"") ?? string.Empty)";
        const adminDefaultCenter = [10.776889, 106.700806];

        document.addEventListener('DOMContentLoaded', function() {
            initAdminEventMap();
        });

        function initAdminEventMap() {
            try {
                const mapContainer = document.getElementById('eventMap');
                if (!mapContainer) return;

                const hasSavedCoords = adminEventLat !== null && adminEventLng !== null;
                const center = hasSavedCoords
                    ? [parseFloat(adminEventLat), parseFloat(adminEventLng)]
                    : adminDefaultCenter;

                const map = L.map(mapContainer).setView(center, hasSavedCoords ? 15 : 13);
                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    maxZoom: 19,
                    attribution: '© OpenStreetMap'
                }).addTo(map);

                if (hasSavedCoords) {
                    L.marker(center).addTo(map).bindPopup('@Html.Raw(Model.Title)').openPopup();
                } else if (adminEventAddress && adminEventAddress.trim().length > 0) {
                    fetch('https://nominatim.openstreetmap.org/search?format=json&q=' + encodeURIComponent(adminEventAddress))
                        .then(res => res.json())
                        .then(data => {
                            if (data && data.length > 0) {
                                var lat = parseFloat(data[0].lat);
                                var lon = parseFloat(data[0].lon);
                                map.setView([lat, lon], 15);
                                L.marker([lat, lon]).addTo(map).bindPopup('@Html.Raw(Model.Title)').openPopup();
                            }
                        });
                }
            } catch (err) {
                console.error('Error initializing admin event map:', err);
            }
        }
    </script>
}

<!-- Reject Modal -->
<div class="modal fade" id="rejectModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-triangle-exclamation me-2"></i>Reject Event</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="Reject" method="post" id="rejectForm">
                <div class="modal-body p-4">
                    <input type="hidden" name="id" value="@Model.EventId" />
                    <p class="text-muted small mb-3">The organizer will receive this rejection reason and can resubmit after making changes.</p>
                    <div class="mb-0">
                        <label class="form-label fw-bold mb-2">Reason for Rejection <span class="text-danger">*</span></label>
                        <textarea name="reason" id="rejectReason" class="form-control" rows="4" placeholder="e.g. Inappropriate content, Missing venue details, Pricing issues..." required minlength="10" maxlength="1000"></textarea>
                        <div id="rejectReasonError" class="text-danger small mt-1" style="display:none;"></div>
                        <small class="text-muted">Minimum 10 characters required.</small>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-white border" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger fw-bold">Confirm Rejection</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Suspend Modal (for Approved Events) -->
<div class="modal fade" id="suspendModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-pause me-2"></i>Suspend Event</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="Reject" method="post" id="suspendForm">
                <div class="modal-body p-4">
                    <input type="hidden" name="id" value="@Model.EventId" />
                    <div class="alert alert-warning border-0" role="alert">
                        <i class="fa-solid fa-circle-exclamation me-2"></i>
                        <strong>Warning:</strong> Suspending this event will change its status back to Rejected. The organizer will be notified.
                    </div>
                    <p class="text-muted small mb-3">Please provide a reason for suspending this event:</p>
                    <div class="mb-0">
                        <label class="form-label fw-bold mb-2">Reason for Suspension <span class="text-danger">*</span></label>
                        <textarea name="reason" id="suspendReason" class="form-control" rows="4" placeholder="e.g. Violates content policy, Requires additional verification, Organizer needs to update details..." required minlength="10" maxlength="1000"></textarea>
                        <div id="suspendReasonError" class="text-danger small mt-1" style="display:none;"></div>
                        <small class="text-muted">Minimum 10 characters required.</small>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-white border" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning fw-bold">Confirm Suspension</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    // Reject form validation
    (function () {
        function validateReasonForm(formId, textareaId, errorDivId) {
            var form = document.getElementById(formId);
            if (!form) return;
            form.addEventListener('submit', function (e) {
                var textarea = document.getElementById(textareaId);
                var errorDiv = document.getElementById(errorDivId);
                var value = textarea.value.trim();
                if (!value) {
                    e.preventDefault();
                    errorDiv.textContent = 'Reason is required.';
                    errorDiv.style.display = 'block';
                    textarea.classList.add('is-invalid');
                } else if (value.length < 10) {
                    e.preventDefault();
                    errorDiv.textContent = 'Reason must be at least 10 characters.';
                    errorDiv.style.display = 'block';
                    textarea.classList.add('is-invalid');
                } else {
                    errorDiv.style.display = 'none';
                    textarea.classList.remove('is-invalid');
                }
            });
        }
        validateReasonForm('rejectForm', 'rejectReason', 'rejectReasonError');
        validateReasonForm('suspendForm', 'suspendReason', 'suspendReasonError');
    })();
</script>
