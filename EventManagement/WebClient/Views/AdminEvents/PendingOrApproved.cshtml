@model List<WebClient.DTOs.Response.ReadEventDTO>

@{
    ViewData["Title"] = "Event Moderation";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    string tabActive = ViewData["TabActive"]?.ToString() ?? "Pending";
}

<link rel="stylesheet" href="~/css/common/list_style.css" />
<link rel="stylesheet" href="~/css/common/search_div.css" />
<link rel="stylesheet" href="~/css/common/dashboard_paging.css" />
<link rel="stylesheet" href="~/css/common/page_header_dashboard.css" />

<style>
    .event-card {
        background: white;
        border-radius: 12px;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        border-left: 4px solid #fbbf24;
        transition: all 0.3s ease;
    }

    .event-card.approved {
        border-left-color: #10b981;
    }

    .event-card:hover {
        box-shadow: 0 4px 16px rgba(0,0,0,0.1);
        transform: translateY(-2px);
    }

    .event-card-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 1rem;
        gap: 1rem;
    }

    .event-title {
        font-size: 1.15rem;
        font-weight: 600;
        color: #1e293b;
        margin-bottom: 0.5rem;
    }

    .event-meta {
        display: flex;
        gap: 1.5rem;
        margin-bottom: 1rem;
        flex-wrap: wrap;
    }

    .event-meta-item {
        font-size: 0.875rem;
        color: #64748b;
    }

    .event-status {
        display: inline-block;
        padding: 0.35rem 0.75rem;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
        white-space: nowrap;
    }

    .event-status.pending {
        background: #fef3c7;
        color: #b45309;
    }

    .event-status.approved {
        background: #d1fae5;
        color: #065f46;
    }

    .event-description {
        color: #475569;
        font-size: 0.95rem;
        line-height: 1.5;
        margin-bottom: 1rem;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .event-actions {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .event-actions .btn {
        font-size: 0.875rem;
        padding: 0.5rem 1rem;
        font-weight: 500;
    }

    .nav-tabs .nav-link {
        color: #64748b;
        border-bottom: 2px solid transparent;
        border-radius: 0;
        font-weight: 500;
    }

    .nav-tabs .nav-link:hover {
        border-bottom-color: #cbd5e1;
        color: #1e293b;
    }

    .nav-tabs .nav-link.active {
        color: #1e293b;
        background: transparent;
        border-bottom-color: #6366f1;
    }
</style>

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="mb-0">
            <i class="fa-solid fa-gavel me-2"></i>
            Event Moderation
            <span class="stats-badge">@(Model?.Count ?? 0) Events</span>
        </h3>
        <p class="text-muted small mt-2 mb-0">Review, approve, and manage events</p>
    </div>
</div>

<!-- Tabs for Pending/Approved/Rejected/All -->
<ul class="nav nav-tabs mb-4" role="tablist" style="border-bottom: 1px solid #e2e8f0;">
    <li class="nav-item" role="presentation">
        <a class="nav-link @(tabActive == "Pending" ? "active" : "")" 
           href="@Url.Action("Pending", "AdminEvents", new { searchTerm = ViewData["SearchTerm"], sortBy = ViewData["SortBy"], sortOrder = ViewData["SortOrder"] })">
            <i class="fa-solid fa-hourglass-half me-2"></i> Pending Review
        </a>
    </li>
    <li class="nav-item" role="presentation">
        <a class="nav-link @(tabActive == "Approved" ? "active" : "")" 
           href="@Url.Action("Approved", "AdminEvents", new { searchTerm = ViewData["SearchTerm"], sortBy = ViewData["SortBy"], sortOrder = ViewData["SortOrder"] })">
            <i class="fa-solid fa-circle-check me-2"></i> Approved Events
        </a>
    </li>
    <li class="nav-item" role="presentation">
        <a class="nav-link @(tabActive == "Rejected" ? "active" : "")" 
           href="@Url.Action("Rejected", "AdminEvents", new { searchTerm = ViewData["SearchTerm"], sortBy = ViewData["SortBy"], sortOrder = ViewData["SortOrder"] })">
            <i class="fa-solid fa-circle-xmark me-2"></i> Rejected Events
        </a>
    </li>
    <li class="nav-item" role="presentation">
        <a class="nav-link @(tabActive == "All" ? "active" : "")" 
           href="@Url.Action("All", "AdminEvents", new { searchTerm = ViewData["SearchTerm"], sortBy = ViewData["SortBy"], sortOrder = ViewData["SortOrder"] })">
            <i class="fa-solid fa-layer-group me-2"></i> All Events
        </a>
    </li>
</ul>

@if (TempData["ToastMessage"] != null)
{
    <div class="alert alert-@TempData["ToastType"] alert-dismissible fade show" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i>
        @TempData["ToastMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Search & Filter Section -->
<div class="search-card mb-4">
    <form method="get" asp-action="@tabActive">
        <div class="row g-3 align-items-end">
            <div class="col-md-6">
                <label class="form-label fw-semibold text-muted small mb-2">
                    <i class="fa-solid fa-magnifying-glass me-1"></i> Search
                </label>
                <input type="text" 
                       name="searchTerm" 
                       value="@ViewData["SearchTerm"]" 
                       class="form-control" 
                       placeholder="Search by title, location, or description..."
                       style="border-radius: 10px; padding: 0.65rem 1rem;">
            </div>
            <div class="col-md-4">
                <label class="form-label fw-semibold text-muted small mb-2">
                    <i class="fa-solid fa-arrow-up-arrow-down me-1"></i> Sort By
                </label>
                <select name="sortBy" class="form-select" style="border-radius: 10px; padding: 0.65rem 1rem;">
                    <option value="DateSubmitted" selected="@(ViewData["SortBy"]?.ToString() == "DateSubmitted" || ViewData["SortBy"] == null)">Date Submitted</option>
                    <option value="Title" selected="@(ViewData["SortBy"]?.ToString() == "Title")">Title</option>
                    <option value="StartDate" selected="@(ViewData["SortBy"]?.ToString() == "StartDate")">Event Start Date</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label fw-semibold text-muted small mb-2">
                    <i class="fa-solid fa-arrows-up-down me-1"></i> Order
                </label>
                <select name="sortOrder" class="form-select" style="border-radius: 10px; padding: 0.65rem 1rem;">
                    <option value="desc" selected="@(ViewData["SortOrder"]?.ToString() == "desc" || ViewData["SortOrder"] == null)">Newest</option>
                    <option value="asc" selected="@(ViewData["SortOrder"]?.ToString() == "asc")">Oldest</option>
                </select>
            </div>
        </div>
        <div class="row mt-3">
            <div class="col-12 d-flex gap-2">
                <button type="submit" class="btn btn-primary fw-bold">
                    <i class="fa-solid fa-search me-1"></i> Search
                </button>
                <a asp-action="@tabActive" class="btn btn-outline-secondary fw-bold">
                    <i class="fa-solid fa-rotate-left me-1"></i> Reset
                </a>
            </div>
        </div>
    </form>
</div>

<!-- Events List -->
@if (Model != null && Model.Any())
{
    <div id="eventsContainer">
        @foreach (var item in Model)
        {
            <div class="event-card @(item.Status == "Approved" || item.Status == "Published" ? "approved" : (item.Status == "Rejected" ? "rejected" : ""))" 
                 data-event-id="@item.EventId" 
                 data-created="@item.StartDate.Ticks" 
                 data-start="@item.StartDate.Ticks">
                <div class="event-card-header">
                    <div class="flex-grow-1">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <h4 class="event-title mb-0">@item.Title</h4>
                            <span class="badge @(item.Status == "Approved" || item.Status == "Published" ? "bg-success" : (item.Status == "Rejected" ? "bg-danger" : (item.Status == "Pending" ? "bg-warning text-dark" : "bg-secondary")))">
                                @if (item.Status == "Approved" || item.Status == "Published")
                                {
                                    <text><i class="fa-solid fa-circle-check me-1"></i> Approved</text>
                                }
                                else if (item.Status == "Rejected")
                                {
                                    <text><i class="fa-solid fa-circle-xmark me-1"></i> Rejected</text>
                                }
                                else if (item.Status == "Pending")
                                {
                                    <text><i class="fa-solid fa-hourglass-half me-1"></i> Pending</text>
                                }
                                else
                                {
                                    <text>@item.Status</text>
                                }
                            </span>
                        </div>
                    </div>
                </div>

                <div class="event-meta">
                    <div class="event-meta-item">
                        <i class="fa-regular fa-calendar me-2 text-primary"></i>
                        <strong>@item.StartDate.ToString("dd MMM yyyy")</strong> at @item.StartDate.ToString("HH:mm")
                    </div>
                    <div class="event-meta-item">
                        <i class="fa-solid fa-location-dot me-2 text-danger"></i>
                        @item.Location
                    </div>
                    <div class="event-meta-item">
                        <i class="fa-solid fa-user me-2 text-info"></i>
                        Organizer: @item.OrganizerName
                    </div>
                    <div class="event-meta-item">
                        <i class="fa-solid fa-tag me-2 text-warning"></i>
                        Category: @item.CategoryName
                    </div>
                </div>

                <p class="event-description">@item.Description</p>

                @if (item.TicketTypes?.Any() == true)
                {
                    <div class="mb-3">
                        <span class="badge bg-light text-dark me-2">
                            <i class="fa-solid fa-ticket me-1"></i> @item.TicketTypes.Count Ticket Type(s)
                        </span>
                        <span class="badge bg-light text-dark">
                            <i class="fa-solid fa-coins me-1"></i>
                            Est. Revenue: @{
                                long estRevenue = 0;
                                foreach (var t in item.TicketTypes)
                                {
                                    estRevenue += (long)t.Quantity * t.Price;
                                }
                            } @estRevenue.ToString("N0") @Html.Raw("\u0111")
                        </span>
                    </div>
                }

                <div class="event-actions pt-2 border-top">
                    <a asp-action="Details" asp-route-id="@item.EventId" class="btn btn-outline-primary fw-bold">
                        <i class="fa-regular fa-eye me-1"></i> View Details
                    </a>
                    @if (item.Status != "Approved" && item.Status != "Published")
                    {
                        <span class="text-muted small fw-bold ms-auto">
                            <i class="fa-solid fa-clock me-1"></i> Awaiting Review
                        </span>
                    }
                    else
                    {
                        <span class="text-success small fw-bold ms-auto">
                            <i class="fa-solid fa-check-double me-1"></i> Approved
                        </span>
                    }
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="text-center py-5">
        @if (tabActive == "Pending")
        {
            <i class="fa-solid fa-clipboard-check fa-5x text-muted opacity-25 mb-3"></i>
            <h5 class="text-muted fw-bold">No Pending Events</h5>
            <p class="text-muted">Great job! All events have been reviewed.</p>
        }
        else
        {
            <i class="fa-solid fa-inbox fa-5x text-muted opacity-25 mb-3"></i>
            <h5 class="text-muted fw-bold">No Approved Events</h5>
            <p class="text-muted">No events have been approved yet.</p>
        }
    </div>
}

@{
    int pageNumber = (int)(ViewData["PageNumber"] ?? 1);
    int totalPages = (int)(ViewData["TotalPages"] ?? 1);
    int totalCount = (int)(ViewData["TotalCount"] ?? 0);
    string searchTerm = ViewData["SearchTerm"]?.ToString() ?? "";
    string sortBy = ViewData["SortBy"]?.ToString() ?? "DateSubmitted";
    string sortOrder = ViewData["SortOrder"]?.ToString() ?? "desc";
}

@if (totalPages > 1)
{
    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
        <div class="text-muted small">
            Showing @Model.Count of @totalCount events
        </div>
        <nav aria-label="Page navigation">
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(pageNumber <= 1 ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action(tabActive, "AdminEvents", new { pageNumber = pageNumber - 1, searchTerm, sortBy, sortOrder })">Previous</a>
                </li>
                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == pageNumber ? "active" : "")">
                        <a class="page-link" href="@Url.Action(tabActive, "AdminEvents", new { pageNumber = i, searchTerm, sortBy, sortOrder })">@i</a>
                    </li>
                }
                <li class="page-item @(pageNumber >= totalPages ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action(tabActive, "AdminEvents", new { pageNumber = pageNumber + 1, searchTerm, sortBy, sortOrder })">Next</a>
                </li>
            </ul>
        </nav>
    </div>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Search and sort are now handled server-side with form submission
            // The form above handles GET requests with searchTerm, sortBy, and sortOrder parameters
        });
    </script>
}
