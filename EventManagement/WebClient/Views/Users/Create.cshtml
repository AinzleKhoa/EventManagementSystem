@model WebClient.DTOs.Request.CreateUserDTO

@{
    ViewData["Title"] = "Create New User";
    Layout = "_LayoutAdmin";
}

<style>
    .card-section {
        background: white;
        border-radius: 16px;
        padding: 2rem;
        box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
        margin-bottom: 2rem;
    }

    .section-header {
        border-bottom: 1px solid #e2e8f0;
        padding-bottom: 1rem;
        margin-bottom: 1.5rem;
    }

    .form-label {
        font-weight: 600;
        color: #475569;
    }

    .avatar-upload-wrapper {
        width: 150px;
        height: 150px;
        border-radius: 50%;
        overflow: hidden;
        border: 4px dashed #cbd5e1;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        background: #f8fafc;
    }

        .avatar-upload-wrapper img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .validation-summary-errors {
        color: #dc3545;
        background: #fff5f5;
        padding: 1rem;
        border-radius: 8px;
        margin-bottom: 1rem;
        list-style: none;
    }
</style>

<div class="container-fluid">
    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none text-muted fw-medium">
            <i class="fa-solid fa-arrow-left me-1"></i> Back to User List
        </a>
    </div>

    <form asp-action="Create" method="post" enctype="multipart/form-data" id="mainForm">
        @Html.AntiForgeryToken()

        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
        }

        <div class="row">
            <div class="col-lg-4">
                <div class="card-section text-center">
                    <div class="section-header"><h5 class="fw-bold mb-0">Profile Picture</h5></div>
                    <div class="avatar-upload-wrapper mx-auto mb-3" id="wrapper">
                        <div id="placeholder">
                            <i class="fa-solid fa-camera fa-2x text-muted"></i>
                        </div>
                        <img id="preview" src="#" style="display:none;" />
                    </div>
                    <label class="btn btn-sm btn-outline-primary">
                        Browse Image <input type="file" asp-for="AvatarFile" class="d-none" id="imgInput" accept="image/*">
                    </label>
                    <span asp-validation-for="AvatarFile" class="text-danger d-block small mt-2"></span>
                </div>
            </div>

            <div class="col-lg-8">
                <div class="card-section">
                    <div class="section-header"><h5 class="fw-bold mb-0">User Information</h5></div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label">Full Name</label>
                            <input asp-for="FullName" class="form-control" placeholder="Enter full name">
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label">Email</label>
                            <input asp-for="Email" class="form-control" placeholder="name@example.com">
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PhoneNumber" class="form-label">Phone</label>
                            <input asp-for="PhoneNumber" class="form-control" placeholder="090...">
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="RoleId" class="form-label">Role</label>
                            <select asp-for="RoleId" class="form-select">
                                <option value="">Select Role</option>
                                <option value="2">Customer</option>
                                <option value="3">Organizer</option>
                                <option value="4">Ticket Validator</option>
                            </select>
                            <span asp-validation-for="RoleId" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Password" class="form-label">Password</label>
                            <div class="input-group">
                                <input asp-for="Password" type="password" class="form-control" id="pwd">
                                <button class="btn btn-outline-secondary" type="button" onclick="togglePwd()">
                                    <i class="fa-solid fa-eye" id="eye"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
                            <div class="input-group">
                                <input asp-for="ConfirmPassword" type="password" class="form-control" id="cpwd">
                                <button class="btn btn-outline-secondary" type="button" onclick="toggleCPwd()">
                                    <i class="fa-solid fa-eye" id="eye"></i>
                                </button>
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
                <div class="text-end mb-5">
                    <button type="submit" class="btn btn-primary px-5 py-2 fw-bold" id="submitBtn">Save User</button>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/common/toast.js"></script>
    <script src="~/js/common/confirm_popup.js"></script>
    @if (TempData["ToastMessage"] != null)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                showToast("@TempData["ToastMessage"]", "@TempData["ToastType"]");
            });
        </script>
    }
    <script>
        // Preview Image
        document.getElementById('imgInput').onchange = e => {
            const [file] = e.target.files;
            if (file) {
                document.getElementById('preview').src = URL.createObjectURL(file);
                document.getElementById('preview').style.display = 'block';
                document.getElementById('placeholder').style.display = 'none';
                document.getElementById('wrapper').style.borderStyle = 'solid';
            }
        };

        // Toggle Password
        function togglePwd() {
            const input = document.getElementById('pwd');
            const icon = document.getElementById('eye');
            input.type = input.type === 'password' ? 'text' : 'password';
            icon.classList.toggle('fa-eye');
            icon.classList.toggle('fa-eye-slash');
        }

        function toggleCPwd() {
            const input = document.getElementById('cpwd');
            const icon = document.getElementById('eye');
            input.type = input.type === 'password' ? 'text' : 'password';
            icon.classList.toggle('fa-eye');
            icon.classList.toggle('fa-eye-slash');
        }

        // Handle Submit Loading
        $('#mainForm').on('submit', function() {
            if($(this).valid()){
                $('#submitBtn').prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span> Saving...');
            }
        });
    </script>
}