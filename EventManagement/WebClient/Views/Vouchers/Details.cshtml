@model WebClient.DTOs.Response.ReadVoucherDTO
@{
    ViewData["Title"] = "Voucher Details";
    Layout = "_LayoutStaff";
}

<style>
    .card-section {
        background: white;
        border-radius: 16px;
        padding: 2rem;
        border: none;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        margin-bottom: 2rem;
    }

    .detail-label {
        font-size: 0.85rem;
        text-transform: uppercase;
        color: #64748b;
        font-weight: 700;
        letter-spacing: 0.5px;
        margin-bottom: 0.5rem;
    }

    .detail-value {
        font-size: 1.1rem;
        font-weight: 500;
        color: #1e293b;
    }

    .status-badge-lg {
        padding: 0.5rem 1.5rem;
        border-radius: 50px;
        font-weight: 600;
        font-size: 0.9rem;
    }

    .status-active {
        background-color: #dcfce7;
        color: #166534;
    }

    .status-inactive {
        background-color: #f1f5f9;
        color: #64748b;
    }
</style>

<div class="mb-4 d-flex justify-content-between align-items-center">
    <div>
        <a asp-action="Index" class="text-decoration-none text-muted fw-medium mb-2 d-inline-block">
            <i class="fa-solid fa-arrow-left me-1"></i> Back to List
        </a>
        <h3 class="fw-bold mb-0">Voucher Details</h3>
    </div>
    <div class="d-flex align-items-center gap-2">
        @{
            // Xác định trạng thái hết hàng
            var isOutOfStock = Model.UsedCount >= Model.Quantity;
            // Chỉ cho phép phân phối khi đang Active VÀ còn hàng
            var canDistribute = Model.IsActive && !isOutOfStock;
        
            // Custom message giải thích lý do khóa nút
            var distributeTitle = "Distribute Voucher";
            if (!Model.IsActive)
            {
                distributeTitle = "Voucher is inactive and cannot be distributed";
            }
            else if (isOutOfStock)
            {
                distributeTitle = "Voucher is out of stock (Usage reached maximum quantity)";
            }
        }

        <button type="button"
                class="btn btn-primary fw-bold shadow-sm"
                data-bs-toggle="modal"
                data-bs-target="#distributeModal"
            @(!canDistribute ? "disabled" : "")
                title="@distributeTitle">
            <i class="fa-solid fa-gift me-2"></i> Distribute Voucher
        </button>

        <a asp-action="Edit" asp-route-id="@Model.VoucherId" class="btn btn-warning text-white fw-bold shadow-sm">
            <i class="fa-solid fa-pen-to-square me-2"></i> Edit Voucher
        </a>
    </div>
</div>

<div class="row">
    <div class="col-lg-4">
        <div class="card-section text-center h-100">
            <div class="mb-4">
                <div class="detail-label">Voucher Code</div>
                <div class="display-6 fw-bold text-primary">@Model.Code</div>
            </div>

            <hr class="my-4 opacity-10" />

            <div class="mb-4">
                <div class="detail-label">Target Event</div>
                <div class="fw-bold fs-5">@Model.EventTitle</div>
                <small class="text-muted">ID: @Model.EventId</small>
            </div>

            <div class="mb-3">
                <div class="detail-label">Status</div>
                @if (Model.IsActive)
                {
                    <span class="status-badge-lg status-active">
                        <i class="fa-solid fa-check-circle me-1"></i> Active (Publish)
                    </span>
                }
                else
                {
                    <span class="status-badge-lg status-inactive">
                        <i class="fa-solid fa-eye-slash me-1"></i> Inactive (Hidden)
                    </span>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card-section h-100">
            <h5 class="fw-bold mb-4 border-bottom pb-3">
                <i class="fa-solid fa-circle-info me-2 text-info"></i> Configuration
            </h5>

            <div class="row g-4">
                <div class="col-md-6">
                    <div class="detail-label">Discount Type</div>
                    <div class="detail-value">@Model.DiscountType</div>
                </div>
                <div class="col-md-6">
                    <div class="detail-label">Discount Value</div>
                    <div class="detail-value text-success fw-bold">
                        @(Model.DiscountType == "Percent" ? $"{Model.DiscountValue:0.##}%" : $"{Model.DiscountValue:N0} VND")
                    </div>
                </div>

                <div class="col-12">
                    <div class="detail-label d-flex justify-content-between">
                        <span>Usage Statistics</span>
                        <span>@Model.UsedCount / @Model.Quantity used</span>
                    </div>
                    <div class="progress mt-2" style="height: 10px; border-radius: 10px;">
                        @{
                            var percent = Model.Quantity > 0 ? (Model.UsedCount * 100.0 / Model.Quantity) : 0;
                            var color = percent >= 100 ? "bg-danger" : (percent >= 80 ? "bg-warning" : "bg-primary");
                        }
                        <div class="progress-bar @color" style="width: @percent%"></div>
                    </div>
                    <small class="text-muted mt-2 d-block">
                        @(Model.Quantity - Model.UsedCount) vouchers remaining.
                    </small>
                </div>

                <div class="col-md-6">
                    <div class="detail-label">Valid From</div>
                    <div class="detail-value">
                        <i class="fa-regular fa-calendar me-2 text-muted"></i>
                        @(Model.ValidFrom?.ToString("dd/MM/yyyy") ?? "N/A")
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="detail-label">Valid To</div>
                    <div class="detail-value">
                        <i class="fa-regular fa-clock me-2 text-muted"></i>
                        @(Model.ValidTo?.ToString("dd/MM/yyyy") ?? "N/A")
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.getElementById('distribute-email-form').addEventListener('submit', function (e) {
        e.preventDefault();
        const formData = new FormData(e.target);
        const data = {
            userEmail: formData.get('userEmail'),
            voucherId: parseInt(formData.get('voucherId'))
        };

        fetch('/Vouchers/DistributeByEmail', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': getAntiForgeryToken()
            },
            body: JSON.stringify(data),
        })
        .then(response => response.json())
        .then(result => {
            if (result.success) {
                alert('Voucher distributed successfully!');
                const modal = bootstrap.Modal.getInstance(document.getElementById('distributeModal'));
                modal.hide();
            } else {
                alert('Failed to distribute voucher: ' + result.message);
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('An error occurred while distributing the voucher.');
        });
    });

    var distributeEventForm = document.getElementById('distribute-event-form');
    if (distributeEventForm) {
        distributeEventForm.addEventListener('submit', function (e) {
            e.preventDefault();
            const formData = new FormData(e.target);
            const data = {
                eventId: parseInt(formData.get('eventId')),
                voucherId: parseInt(formData.get('voucherId'))
            };

            fetch('/Vouchers/DistributeToEvent', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': getAntiForgeryToken()
                },
                body: JSON.stringify(data),
            })
            .then(response => response.json())
            .then(result => {
                if (result.success) {
                    alert('Voucher distributed successfully to all attendees!');
                    const modal = bootstrap.Modal.getInstance(document.getElementById('distributeModal'));
                    modal.hide();
                } else {
                    alert('Failed to distribute voucher: ' + result.message);
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('An error occurred while distributing the voucher.');
            });
        });
    }

    function getAntiForgeryToken() {
        const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
        return tokenInput ? tokenInput.value : '';
    }
</script>
}

<!-- Modal -->
<div class="modal fade" id="distributeModal" tabindex="-1" aria-labelledby="distributeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="distributeModalLabel">Distribute Voucher: @Model.Code</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <ul class="nav nav-tabs" id="distributeTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="email-tab" data-bs-toggle="tab" data-bs-target="#email-tab-pane" type="button" role="tab" aria-controls="email-tab-pane" aria-selected="true">By Email</button>
                    </li>
                    @* <li class="nav-item" role="presentation">
                        <button class="nav-link" id="event-tab" data-bs-toggle="tab" data-bs-target="#event-tab-pane" type="button" role="tab" aria-controls="event-tab-pane" aria-selected="false">For Event Attendees</button>
                    </li> *@
                </ul>
                <div class="tab-content" id="distributeTabsContent">
                    <div class="tab-pane fade show active" id="email-tab-pane" role="tabpanel" aria-labelledby="email-tab" tabindex="0">
                        <form id="distribute-email-form" class="mt-3">
                            <input type="hidden" name="voucherId" value="@Model.VoucherId" />
                            <div class="mb-3">
                                <label for="userEmail" class="form-label">User Email</label>
                                <input type="email" class="form-control" id="userEmail" name="userEmail" required>
                            </div>
                            <button type="submit" class="btn btn-primary">Send Voucher</button>
                        </form>
                    </div>
                    @* <div class="tab-pane fade" id="event-tab-pane" role="tabpanel" aria-labelledby="event-tab" tabindex="0">
                        <form id="distribute-event-form" class="mt-3">
                             <input type="hidden" name="voucherId" value="@Model.VoucherId" />
                            <div class="mb-3">
                                <label for="eventId" class="form-label">Event ID</label>
                                <input type="number" class="form-control" id="eventId" name="eventId" value="@Model.EventId" required>
                            </div>
                            <button type="submit" class="btn btn-primary">Send to All Attendees</button>
                        </form>
                    </div> *@
                </div>
            </div>
        </div>
    </div>
</div>