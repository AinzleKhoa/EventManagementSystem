@model WebClient.DTOs.Request.CreateVoucherDTO
@{
    ViewData["Title"] = "Create Voucher";
    Layout = "_LayoutStaff";

}

<style>
    .card-section {
        background: white;
        border-radius: 16px;
        padding: 2rem;
        border: none;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        margin-bottom: 2rem;
    }

    .section-header {
        border-bottom: 1px solid #e2e8f0;
        padding-bottom: 1rem;
        margin-bottom: 1.5rem;
    }

    .form-label {
        font-weight: 600;
        font-size: 0.9rem;
        color: #475569;
    }

    .form-control, .form-select {
        border-radius: 10px;
        padding: 0.75rem 1rem;
        border: 1px solid #e2e8f0;
    }

    .select2-container--classic .select2-selection--single {
        border-radius: 10px !important;
        height: 48px !important; 
        border: 1px solid #e2e8f0 !important;
        padding: 8px !important;
    }

        .select2-container--classic .select2-selection--single .select2-selection__arrow {
            height: 46px !important;
            right: 10px !important;
        }

        .select2-container--classic .select2-selection--single .select2-selection__rendered {
            line-height: 30px !important;
            color: #334155 !important;
        }

    .form-control:focus, .form-select:focus {
        border-color: var(--primary-color);
        box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1);
    }


    .field-validation-error {
        color: #dc3545;
        font-size: 0.875em;
        margin-top: 0.25rem;
    }
</style>

<div class="mb-4">
    <a asp-action="Index" class="text-decoration-none text-muted fw-medium mb-2 d-inline-block">
        <i class="fa-solid fa-arrow-left me-1"></i> Back to Vouchers
    </a>
</div>

<form asp-action="Create" method="post" id="createVoucherForm">
    <div class="card-section">
        <div class="section-header">
            <h5 class="fw-bold mb-0">
                <i class="fa-solid fa-ticket me-2 text-primary"></i>
                Create New Voucher
            </h5>
        </div>

        <div class="row g-4">
            <div class="col-md-6">
                <label class="form-label">Event <span class="text-danger">*</span></label>

                <select asp-for="EventId" class="form-select" asp-items="ViewBag.EventList">
                    <option value="">-- Select an Event --</option>
                </select>
                <span asp-validation-for="EventId" class="text-danger small"></span>

                <div class="form-text text-muted small mt-2">
                    <i class="fa-solid fa-circle-info me-1"></i> Choose the event to apply this voucher.
                </div>
            </div>

            <div class="col-md-6">
                <label class="form-label">Voucher Code <span class="text-danger">*</span></label>
                <input asp-for="Code" class="form-control text-uppercase" placeholder="e.g. SUMMER10" />
                <span asp-validation-for="Code" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label class="form-label">Discount Type <span class="text-danger">*</span></label>
                <select asp-for="DiscountType" class="form-select">
                    <option value="Percent">Percent (%)</option>
                    <option value="Amount">Fixed Amount (VND)</option>
                </select>
            </div>

            <div class="col-md-6">
                <label class="form-label">Discount Value <span class="text-danger">*</span></label>
                <input asp-for="DiscountValue" type="number" step="0.01" class="form-control" placeholder="e.g. 10 or 50000" />
                <span asp-validation-for="DiscountValue" class="text-danger small"></span>
            </div>

            <div class="col-md-12">
                <label class="form-label">Total Quantity <span class="text-danger">*</span></label>
                <input asp-for="Quantity" type="number" class="form-control" placeholder="Number of vouchers to issue..." />
                <span asp-validation-for="Quantity" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label class="form-label">Valid From <span class="text-danger">*</span></label>
                <input asp-for="ValidFrom" type="date" class="form-control" min="@DateTime.Now.ToString("yyyy-MM-dd")" />
                <span asp-validation-for="ValidFrom" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label class="form-label">Valid To <span class="text-danger">*</span></label>
                <input asp-for="ValidTo" type="date" class="form-control" min="@DateTime.Now.ToString("yyyy-MM-dd")" />
                <span asp-validation-for="ValidTo" class="text-danger small"></span>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2 mb-5">
        <button type="submit" class="btn btn-primary px-5 fw-bold" style="background: #4f46e5; border: none;">Create Voucher</button>
    </div>
</form>

@section Scripts {
    <script src="~/js/common/toast.js"></script>
    <script src="~/js/common/loading.js"></script>

    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        $(document).ready(function() {

            var $eventSelect = $('select[name="EventId"]');
            $eventSelect.select2({
                placeholder: "-- Select an Event --",
                allowClear: true,
                width: '100%',
                theme: "classic"
            });


            $('input[name="Code"]').on('input', function() {
                $(this).val($(this).val().toUpperCase());
            });
        });
    </script>
}

@if (TempData["ToastMessage"] != null)
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            showToast(
                "@TempData["ToastType"]",
                "@TempData["ToastMessage"]"
            );
        });
    </script>
}