@model WebClient.DTOs.Request.UpdateWithdrawalDTO
@{
    ViewData["Title"] = "Edit Withdrawal Request";
    Layout = "_LayoutStaff";
}

<style>
    .card-section {
        background: white;
        border-radius: 16px;
        padding: 2rem;
        border: none;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        margin-bottom: 2rem;
    }
    .section-header {
        border-bottom: 1px solid #e2e8f0;
        padding-bottom: 1rem;
        margin-bottom: 1.5rem;
    }
    .form-label { font-weight: 600; font-size: 0.9rem; color: #475569; }
    .form-control, .form-select {
        border-radius: 10px;
        padding: 0.75rem 1rem;
        border: 1px solid #e2e8f0;
    }
    .form-control:focus, .form-select:focus {
        border-color: var(--primary-color);
        box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1);
    }
</style>

<div class="mb-4">
    <a asp-action="Index" class="text-decoration-none text-muted fw-medium mb-2 d-inline-block">
        <i class="fa-solid fa-arrow-left me-1"></i> Back to My Requests
    </a>
</div>

<form asp-action="Update" method="post">
    <input type="hidden" asp-for="WithdrawalId" />

    <div class="card-section">
        <div class="section-header">
            <h5 class="fw-bold mb-0">
                <i class="fa-regular fa-pen-to-square me-2 text-primary"></i>
                Edit Withdrawal Request
            </h5>
        </div>

        <div class="row g-4">
            <div class="col-md-6">
                <label class="form-label">Amount (VND) <span class="text-danger">*</span></label>
                <input asp-for="Amount" type="number" min="1000" step="1000" class="form-control" />
                <span asp-validation-for="Amount" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label class="form-label">Event ID <small class="text-muted fw-normal">(optional)</small></label>
                <input asp-for="EventId" type="number" class="form-control" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Bank Name <span class="text-danger">*</span></label>
                <input asp-for="BankName" type="text" class="form-control" />
                <span asp-validation-for="BankName" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label class="form-label">Bank Account Number <span class="text-danger">*</span></label>
                <input asp-for="BankAccountNumber" type="text" class="form-control" />
                <span asp-validation-for="BankAccountNumber" class="text-danger small"></span>
            </div>

            <div class="col-12">
                <label class="form-label">Account Holder Name <span class="text-danger">*</span></label>
                <input asp-for="BankAccountName" type="text" class="form-control" />
                <span asp-validation-for="BankAccountName" class="text-danger small"></span>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2">
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        <button type="submit" class="btn-dashboard-primary">
            <i class="fa-solid fa-floppy-disk me-2"></i> Save Changes
        </button>
    </div>
</form>

@if (TempData["ToastMessage"] != null)
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            showToast("@TempData["ToastMessage"]", "@TempData["ToastType"]");
        });
    </script>
}
<script src="~/js/toast.js"></script>
