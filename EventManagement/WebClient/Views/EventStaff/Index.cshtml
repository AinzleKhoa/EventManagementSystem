@model IEnumerable<WebClient.DTOs.Response.EventStaffResponseDto>
@{
    ViewData["Title"] = "My Assigned Events";
    Layout = "_ticketValidator"; 
}

<link rel="stylesheet" href="~/css/common/list_style.css" />
<link rel="stylesheet" href="~/css/common/page_header_dashboard.css" />

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h3 class="mb-0">
            <i class="fa-solid fa-calendar-check me-2"></i>
            My Assigned Events
            <span class="stats-badge">@Model.Count() Events</span>
        </h3>
    </div>
</div>

<div class="table-card mt-4">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    @* <th>Poster</th> *@
                    <th>Event Details</th>
                    <th>Schedule</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold text-primary">@item.Title</div>
                                <div class="small text-muted"><i class="fa-solid fa-location-dot me-1"></i> @item.Location</div>
                            </td>
                            <td>
                                <div class="small"><strong>Start:</strong> @item.StartDate.ToString("dd/MM/yyyy HH:mm")</div>
                                <div class="small"><strong>End:</strong> @item.EndDate.ToString("dd/MM/yyyy HH:mm")</div>
                            </td>
                            <td>
                                @if (item.Status == "Approved")
                                {
                                    <span class="status-badge status-published">Approved</span>
                                }
                                else
                                {
                                    <span class="status-badge status-hidden">@item.Status</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-controller="Tickets"
                                   asp-action="Details"
                                   asp-route-eventId="@item.EventId"
                                   class="btn btn-sm btn-primary shadow-sm"
                                   title="View Ticket List">
                                    <i class="fa-solid fa-list-check me-1"></i> View Tickets
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-5">
                            <div class="empty-state">
                                <i class="fa-solid fa-calendar-xmark fa-4x text-muted mb-3 opacity-50"></i>
                                <h5 class="text-muted">No Events Assigned</h5>
                                <p class="text-muted small">You haven't been assigned to any events yet.</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/js/common/toast.js"></script>
}