@using System.Security.Claims
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HoviFlow Organizer</title>


    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/common/dashboard_common.css" />


    <style>
        :root {
            --primary-color: #6366f1;
            --sidebar-width: 260px;
            --sidebar-mini-width: 80px; /* Độ rộng khi thu nhỏ */
            --navbar-height: 70px;
            --bg-light: #f1f5f9;
            --transition-speed: 0.3s;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-light);
            color: #334155;
            overflow-x: hidden;
        }

        /* ============================
                   1. SIDEBAR
                   ============================ */
        .sidebar {
            width: var(--sidebar-width);
            height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            background: white;
            border-right: 1px solid #e2e8f0;
            z-index: 1040; /* Cao nhất để đè lên mọi thứ bên trái */
            display: flex;
            flex-direction: column;
            transition: width var(--transition-speed) ease;
        }

        /* Header của Sidebar (Logo + Toggle Button) */
        .sidebar-header {
            height: var(--navbar-height);
            display: flex;
            align-items: center;
            justify-content: space-between; /* Đẩy Logo sang trái, Burger sang phải */
            padding: 0 1.5rem;
            border-bottom: 1px solid #f1f5f9;
            white-space: nowrap; /* Không xuống dòng logo */
            overflow: hidden;
        }

        .brand-logo {
            font-family: 'Poppins', sans-serif;
            font-weight: 700;
            color: var(--primary-color);
            text-decoration: none;
            font-size: 1.25rem;
            display: flex;
            align-items: center;
            opacity: 1;
            transition: opacity 0.2s;
        }

        /* Nút Burger trong Sidebar */
        #sidebarToggle {
            background: transparent;
            border: none;
            color: #64748b;
            font-size: 1.2rem;
            width: 35px;
            height: 35px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 5px;
            transition: all 0.2s;
            cursor: pointer;
        }

            #sidebarToggle:hover {
                background: #eff6ff;
                color: var(--primary-color);
            }

        /* Menu Links */
        .sidebar-nav {
            padding: 1.5rem 1rem;
            flex-grow: 1;
            overflow-y: auto;
            overflow-x: hidden;
        }

        .nav-link-staff {
            color: #64748b;
            font-weight: 500;
            padding: 0.8rem 1rem;
            border-radius: 10px;
            margin-bottom: 0.5rem;
            display: flex;
            align-items: center;
            text-decoration: none;
            transition: all 0.2s;
            white-space: nowrap;
            height: 48px; /* Cố định chiều cao để dễ căn giữa khi thu nhỏ */
        }

            .nav-link-staff i {
                min-width: 24px; /* Cố định độ rộng icon để text thẳng hàng */
                font-size: 1.1rem;
                text-align: center;
                margin-right: 12px; /* Khoảng cách icon và text */
                transition: margin 0.3s;
            }

            .nav-link-staff:hover, .nav-link-staff.active {
                background-color: #eff6ff;
                color: var(--primary-color);
            }

            .nav-link-staff.active {
                font-weight: 600;
            }

        /* ============================
                   2. HEADER (NAVBAR)
                   ============================ */
        .navbar {
            height: var(--navbar-height);
            background-color: white;
            position: fixed;
            top: 0;
            right: 0;
            /* HEADER KHÔNG ĐÈ SIDEBAR: Bắt đầu từ mép phải của sidebar */
            left: var(--sidebar-width);
            width: auto; /* Tự động lấp đầy phần còn lại */
            z-index: 1030;
            border-bottom: 1px solid #e2e8f0;
            transition: left var(--transition-speed) ease;
        }

        /* ============================
                   3. MAIN CONTENT
                   ============================ */
        .main-content {
            margin-top: var(--navbar-height);
            margin-left: var(--sidebar-width); /* Content cũng bắt đầu sau sidebar */
            padding: 2rem;
            transition: margin-left var(--transition-speed) ease;
        }

        /* ============================
                   4. COLLAPSED STATE (MINI SIDEBAR)
                   ============================ */

        /* Khi body có class 'sb-collapsed' */
        body.sb-collapsed .sidebar {
            width: var(--sidebar-mini-width);
        }

        body.sb-collapsed .navbar {
            left: var(--sidebar-mini-width);
        }

        body.sb-collapsed .main-content {
            margin-left: var(--sidebar-mini-width);
        }

        /* Xử lý các phần tử bên trong Sidebar khi thu nhỏ */
        body.sb-collapsed .brand-logo span {
            display: none; /* Ẩn chữ EventHub */
        }

        body.sb-collapsed .brand-logo i {
            display: none; /* Ẩn luôn icon vé bên trái logo cho gọn, hoặc để lại tùy ý */
        }

        /* Ẩn Text của Menu Link */
        body.sb-collapsed .nav-link-staff span {
            display: none;
            opacity: 0;
        }

        /* Căn chỉnh Icon khi thu nhỏ */
        body.sb-collapsed .nav-link-staff {
            justify-content: center; /* Căn giữa icon trong nút */
            padding-left: 0;
            padding-right: 0;
        }

            body.sb-collapsed .nav-link-staff i {
                margin-right: 0; /* Bỏ margin phải của icon */
            }

        /* Xử lý Header của Sidebar khi thu nhỏ */
        body.sb-collapsed .sidebar-header {
            justify-content: center; /* Căn giữa nút burger */
            padding: 0;
        }

        /* Nút Burger khi thu nhỏ */
        body.sb-collapsed #sidebarToggle {
            margin: 0; /* Đảm bảo không bị lệch */
        }

    </style>
</head>
<body class="">
    <input type="hidden" id="accessToken" value="@(User.FindFirst("AccessToken")?.Value)" />
    <aside class="sidebar">
        <div class="sidebar-header">
            <a href="#" class="brand-logo ps-2">
                <i class="fa-solid fa-ticket me-2"></i>
                <span>HoviFlow</span>
            </a>

            <button id="sidebarToggle">
                <i class="fa-solid fa-bars"></i>
            </button>
        </div>

        <div class="sidebar-nav flex-column">
            @{
                string currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
                string IsActive(params string[] ctrls)
                => ctrls.Contains(currentController) ? "active" : "";
            }

            <!-- Dashboard -->
            <a asp-controller="Dashboard" asp-action="Organizer"
               class="nav-link-staff @IsActive("Organizer", "Dashboard")">
                <i class="fa-solid fa-chart-line"></i>
                <span>Dashboard</span>
            </a>

            <hr />

            <!-- Event Management -->
            <a asp-controller="Events" asp-action="Index"
               class="nav-link-staff @IsActive("Events", "TicketTypes")">
                <i class="fa-solid fa-calendar-days"></i>
                <span>Events</span>
            </a>

            <!-- Orders & Revenue -->
            @* <a asp-controller="Orders" asp-action="Index"
               class="nav-link-staff @IsActive("Orders")">
                <i class="fa-solid fa-receipt"></i>
                <span>Orders</span>
            </a>

            <a asp-controller="Reports" asp-action="Index"
               class="nav-link-staff @IsActive("Reports")">
                <i class="fa-solid fa-chart-column"></i>
                <span>Reports</span>
            </a> *@

            <!-- Voucher Management -->
            <a asp-controller="Vouchers" asp-action="Index"
               class="nav-link-staff @IsActive("Vouchers")">
                <i class="fa-solid fa-ticket-simple"></i>
                <span>Vouchers</span>
            </a>

            <!-- Withdrawal -->
            <a asp-controller="Withdrawals" asp-action="Index"
               class="nav-link-staff @IsActive("Withdrawals")">
                <i class="fa-solid fa-money-bill-transfer"></i>
                <span>Withdrawals</span>
            </a>

            <!-- Chat -->
            <a asp-controller="Chats" asp-action="Index"
               class="nav-link-staff @IsActive("Chats")">
                <i class="fa-solid fa-comments"></i>
                <span>Chat</span>
            </a>

            <hr />

            <!-- Ticket Validation -->
            <a asp-controller="TicketValidator" asp-action="MyEvents"
               class="nav-link-staff @IsActive("MyEvents", "TicketValidator")">
                <i class="fa-solid fa-qrcode"></i>
                <span>Ticket Validation</span>
            </a>

            <!-- Validator Menu - Hiển thị nếu email tồn tại trong bảng EventStaff -->
            @* <a id="validatorMyEventsLink" asp-page="/Validator/MyEvents"
               class="nav-link-staff @(ViewContext.RouteData.Values["Page"]?.ToString().Contains("MyEvents") == true ? "active" : "")"
               style="display: none;">
                <i class="fa-solid fa-clipboard-check"></i>
                <span>My Events</span>
            </a> *@

        </div>
    </aside>

    <nav class="navbar navbar-expand-lg">
        <div class="container-fluid px-4">
            <div class="d-flex align-items-center">
                <h5 class="mb-0 fw-bold text-dark">@ViewData["Title"]</h5>
            </div>

            <div class="ms-auto d-flex align-items-center">
                <a class="nav-link me-3 text-secondary" asp-controller="Home" asp-action="Index">
                    <i class="fa-solid fa-globe me-1"></i> Website
                </a>
                <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-center">
                @* --- BẮT ĐẦU: LOGIC KIỂM TRA ĐĂNG NHẬP --- *@
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    var displayName = User.Identity.Name ?? "User";

                    var claimAvatar = User.FindFirst("AvatarUrl")?.Value;

                    var avatarUrl = !string.IsNullOrEmpty(claimAvatar)
                    ? claimAvatar
                    : $"https://ui-avatars.com/api/?name={displayName}&background=random&color=fff&size=128";

                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle d-flex align-items-center p-0" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <img src="@avatarUrl" alt="Avatar" class="rounded-circle border border-2 border-light shadow-sm me-2" width="40" height="40" style="object-fit: cover;">
                            <span class="fw-semibold text-dark d-none d-lg-inline-block">@displayName</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-3 rounded-3 overflow-hidden">
                            <li>
                                <div class="px-3 py-2 bg-light border-bottom">
                                    <p class="mb-0 small text-secondary">Signed in as</p>
                                    <p class="mb-0 fw-bold text-dark text-truncate" style="max-width: 150px;">@displayName</p>
                                </div>
                            </li>
                            <li><a class="dropdown-item py-2" asp-action="Index" asp-controller="Profile"><i class="fa-regular fa-user me-2 text-muted"></i> My Profile</a></li>
                            <li><hr class="dropdown-divider my-1"></li>
                            <li>
                                    <a class="dropdown-item py-2 text-danger" asp-controller="Profile" asp-action="Logout">
                                    <i class="fa-solid fa-right-from-bracket me-2"></i> Log Out
                                </a>
                            </li>
                        </ul>
                    </li>
                }
                else
                {
                    <li class="nav-item ms-lg-3">
                        <a asp-controller="Authentication" asp-action="Login" class="btn btn-auth-outline me-2">Log In</a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="Authentication" asp-action="Register" class="btn btn-auth-fill">Sign Up</a>
                    </li>
                }
                </ul>
            </div>
        </div>
    </nav>

    <main class="main-content">
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const sidebarToggle = document.getElementById('sidebarToggle');
            const body = document.body;

            // Kiểm tra trạng thái cũ từ LocalStorage (để khi f5 không bị reset)
            const isCollapsed = localStorage.getItem('sb-collapsed') === 'true';
            if (isCollapsed) {
                body.classList.add('sb-collapsed');
            }

            if (sidebarToggle) {
                sidebarToggle.addEventListener('click', function (e) {
                    e.preventDefault();
                    body.classList.toggle('sb-collapsed');

                    // Lưu trạng thái vào storage
                    localStorage.setItem('sb-collapsed', body.classList.contains('sb-collapsed'));
                });
            }

            // Check if current user is a validator via email in EventStaff table
            fetch('/EventStaff/CheckIsValidator')
                .then(res => res.json())
                .then(data => {
                    if (data.isValidator) {
                        var link = document.getElementById('validatorMyEventsLink');
                        if (link) link.style.display = '';
                    }
                })
                .catch(() => {});
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>