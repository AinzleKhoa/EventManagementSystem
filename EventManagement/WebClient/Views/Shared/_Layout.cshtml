@using System.Security.Claims
<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"] - HoviFlow</title>

	<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@600;700&display=swap" rel="stylesheet">
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
	<link rel="stylesheet" href="~/css/_layout/layout_customer.css" />

	<style>
		/* --- STYLE AI CHAT --- */
		#ai-chat-container {
			position: fixed;
			bottom: 25px;
			right: 25px;
			z-index: 9999;
			display: flex;
			flex-direction: column;
			align-items: flex-end;
		}

		#ai-chat-window {
			width: 380px;
			height: 500px;
			margin-bottom: 15px;
			border-radius: 15px;
			box-shadow: 0 10px 30px rgba(0,0,0,0.15);
			display: none;
			flex-direction: column;
			background: white;
			overflow: hidden;
		}

		#ai-chat-btn {
			width: 60px;
			height: 60px;
			border-radius: 50%;
			box-shadow: 0 4px 15px rgba(0,123,255,0.4);
			display: flex;
			align-items: center;
			justify-content: center;
		}

		.chat-message-user {
			background: #0d6efd;
			color: white;
			border-radius: 15px 15px 0 15px;
		}

		.chat-message-ai {
			background: #f8f9fa;
			border: 1px solid #dee2e6;
			border-radius: 15px 15px 15px 0;
		}

		/* --- NOTIFICATION STYLES --- */
		/* Smooth scrollbar */
		#notif-list::-webkit-scrollbar {
			width: 6px;
		}

		#notif-list::-webkit-scrollbar-track {
			background: #f8f9fa;
		}

		#notif-list::-webkit-scrollbar-thumb {
			background: #cdd2d6;
			border-radius: 10px;
		}

			#notif-list::-webkit-scrollbar-thumb:hover {
				background: #a8b1b8;
			}

		.notif-item {
			transition: all 0.2s ease-in-out;
			cursor: pointer;
			border-left: 4px solid transparent; 
		}

			.notif-item:hover {
				background-color: #f8f9fa;
			}

		/* Unread state */
		.notif-unread {
			background-color: #f0f7ff;
			border-left-color: #0d6efd; 
		}

			.notif-unread .notif-title {
				font-weight: 700 !important;
				color: #000 !important;
			}

		/* Icon circle */
		.notif-icon-circle {
			width: 45px;
			height: 45px;
			border-radius: 50%;
			display: flex;
			align-items: center;
			justify-content: center;
			flex-shrink: 0;
		}

		.delete-notif-btn {
			transition: color 0.2s;
		}
		.delete-notif-btn:hover {
			color: #dc3545 !important;
		}
	</style>
</head>

<body>

	@{
		var identity = User.Identity as System.Security.Claims.ClaimsIdentity;
		var currentUserIdValue = identity?.FindFirst("sub")?.Value
		?? identity?.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
		?? identity?.FindFirst("UserId")?.Value
		?? "";
	}
	<input type="hidden" id="currentUserId" value="@currentUserIdValue" />
	<input type="hidden" id="currentUsername" value="@(User.Identity?.Name ?? "")" />
	<input type="hidden" id="accessToken" value="@(User.FindFirst("AccessToken")?.Value)" />

	<nav class="navbar navbar-expand-lg fixed-top shadow-sm bg-white">
		<div class="container">
			<a class="navbar-brand" asp-controller="Home" asp-action="Index">
				<i class="fa-solid fa-ticket me-2"></i>HoviFlow
			</a>

			<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
				<span class="navbar-toggler-icon"></span>
			</button>

			<div class="collapse navbar-collapse" id="navbarNav">
				<ul class="navbar-nav ms-auto align-items-center">

					@if (User.IsInRole("organizer"))
					{
						<li class="nav-item me-3">
							<a class="nav-link" asp-action="Organizer" asp-controller="Dashboard">Create Event</a>
						</li>
					}
					else if (User.IsInRole("admin"))
					{
						<li class="nav-item me-3">
							<a class="nav-link" asp-action="Admin" asp-controller="Dashboard">Admin</a>
						</li>
					}
					else if (User.Identity?.IsAuthenticated == true)
						{
							var userRole = User.FindFirst(ClaimTypes.Role)?.Value ?? User.FindFirst("role")?.Value;
							if (userRole?.ToLower() != "organizer" && userRole?.ToLower() != "admin")
							{
								<li class="nav-item me-3" id="validator-nav-item" style="display:none;">
									<a class="nav-link" asp-action="Index" asp-controller="EventStaff">
										<i class="fa-solid fa-clipboard-check me-2"></i>Validator
									</a>
								</li>
							}
						}

					<li class="nav-item">
						<a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
					</li>

					@if (User.Identity != null && User.Identity.IsAuthenticated)
					{
						var displayName = User.Identity.Name ?? "User";
						var claimAvatar = User.FindFirst("AvatarUrl")?.Value;
						var avatarUrl = !string.IsNullOrEmpty(claimAvatar) ? claimAvatar : $"https://ui-avatars.com/api/?name={displayName}&background=random&color=fff&size=128";

						<li class="nav-item me-2">
							<a class="nav-link" asp-controller="Wishlist" asp-action="Index">Wishlist</a>
						</li>
						
						<li class="nav-item me-2">
							<a class="nav-link" asp-controller="Chats" asp-action="Index">
								Chat
							</a>
						</li>
						<li class="nav-item dropdown me-3">
							<a class="nav-link position-relative" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false" onclick="loadNotifications()">
								<i class="fa-solid fa-bell fs-5 text-secondary"></i>
								<span id="notif-badge" class="position-absolute translate-middle badge rounded-pill bg-danger shadow-sm" style="top: 10px; left: 85%; font-size: 0.65rem; display: none;">
									0
								</span>
							</a>
							<ul class="dropdown-menu dropdown-menu-end shadow-lg p-0 border-0 mt-2" style="width: 420px; border-radius: 16px; overflow: hidden;">

								<li class="p-3 bg-white border-bottom d-flex justify-content-between align-items-center sticky-top" style="z-index: 10;">
									<h6 class="mb-0 fw-bold fs-5">Notifications</h6>
									<button class="btn btn-sm btn-light rounded-pill px-3 text-primary fw-semibold border-0" onclick="markAllAsRead()">
										<i class="fa-solid fa-check-double me-1"></i> Mark all read
									</button>
								</li>

								<div id="notif-list" style="max-height: 500px; overflow-y: auto; overflow-x: hidden;">
								</div>

								<li class="p-2 text-center border-top bg-light d-flex justify-content-between px-3">
									<a href="#" class="text-decoration-none small fw-bold text-danger" onclick="deleteAllNotifications(event)">Clear all</a>
								</li>
							</ul>
						</li>


						<li class="nav-item dropdown">
							<a class="nav-link dropdown-toggle d-flex align-items-center p-0" data-bs-toggle="dropdown">
								<img src="@avatarUrl" class="rounded-circle me-2 border shadow-sm" width="40" height="40" style="object-fit: cover;">
								<span class="fw-semibold d-none d-lg-inline">@displayName</span>
							</a>
							<ul class="dropdown-menu dropdown-menu-end shadow">
								<li class="px-3 py-2 bg-light border-bottom">
									<p class="mb-0 small text-secondary">Signed in as</p>
									<p class="mb-0 fw-bold text-truncate">@displayName</p>
								</li>
								<li>
									<a class="dropdown-item" asp-controller="Profile" asp-action="Index">
										<i class="fa-regular fa-user me-2"></i>My Profile
									</a>
								</li>
								<li>
									<a class="dropdown-item" asp-controller="Profile" asp-action="MyOrders">
										<i class="fa-solid fa-ticket me-2"></i>My Orders
									</a>
								</li>
								<li><hr class="dropdown-divider"></li>
								<li>
									<a class="dropdown-item text-danger" asp-controller="Profile" asp-action="Logout">
										<i class="fa-solid fa-right-from-bracket me-2"></i>Log Out
									</a>
								</li>
							</ul>
						</li>
					}
					else
					{
						<li class="nav-item ms-lg-3">
							<a asp-controller="Authentication" asp-action="Login" class="btn btn-auth-outline me-2">Login</a>
						</li>
						<li class="nav-item">
							<a asp-controller="Authentication" asp-action="Register" class="btn btn-auth-fill">Sign Up</a>
						</li>
					}

				</ul>
			</div>
		</div>
	</nav>

	<div>
		@RenderBody()
	</div>

	<div id="ai-chat-container">
		<div id="ai-chat-window" class="border">
			<div class="bg-primary text-white p-3 d-flex justify-content-between align-items-center">
				<div class="fw-bold"><i class="fa-solid fa-robot me-2"></i>HoviFlow Assistant</div>
				<button type="button" class="btn-close btn-close-white" onclick="toggleChat()"></button>
			</div>
			<div id="chatBox" class="p-3" style="flex:1; overflow-y:auto; background-color: #fcfcfc;">
				<div class="d-flex mb-3 justify-content-start">
					<div class="chat-message-ai p-2 px-3 shadow-sm">
						Hello! I am the HoviFlow AI assistant. How can I help you?
					</div>
				</div>
			</div>
			<div class="p-3 border-top bg-white">
				<div class="input-group">
					<input id="userInput" class="form-control" placeholder="Type a message..." onkeypress="if(event.key==='Enter') sendMessage()">
					<button class="btn btn-primary" onclick="sendMessage()">
						<i class="fa-solid fa-paper-plane"></i>
					</button>
				</div>
			</div>
		</div>
		<button id="ai-chat-btn" class="btn btn-primary" onclick="toggleChat()">
			<i class="fa-solid fa-message"></i>
		</button>
	</div>

	<footer class="bg-dark text-white pt-5 pb-3 mt-5">
		<div class="container">
			<div class="row">
				<div class="col-md-4 mb-4">
					<h5 class="fw-bold mb-3 footer-brand">HoviFlow</h5>
					<p class="small text-secondary">The ultimate platform for discovering and managing events. Connecting people with their passions.</p>
					<div class="d-flex gap-3">
						<a href="#" class="text-secondary hover-white"><i class="fa-brands fa-facebook fa-lg"></i></a>
						<a href="#" class="text-secondary hover-white"><i class="fa-brands fa-instagram fa-lg"></i></a>
						<a href="#" class="text-secondary hover-white"><i class="fa-brands fa-twitter fa-lg"></i></a>
					</div>
				</div>
				<div class="col-md-2 mb-4">
					<h6 class="fw-bold mb-3">Company</h6>
					<ul class="list-unstyled small text-secondary">
						<li class="mb-2"><a href="#" class="text-decoration-none text-secondary">About Us</a></li>
						<li class="mb-2"><a href="#" class="text-decoration-none text-secondary">Careers</a></li>
						<li class="mb-2"><a href="#" class="text-decoration-none text-secondary">Contact</a></li>
					</ul>
				</div>
				<div class="col-md-2 mb-4">
					<h6 class="fw-bold mb-3">Explore</h6>
					<ul class="list-unstyled small text-secondary">
						<li class="mb-2"><a href="#" class="text-decoration-none text-secondary">Concerts</a></li>
						<li class="mb-2"><a href="#" class="text-decoration-none text-secondary">Workshops</a></li>
						<li class="mb-2"><a href="#" class="text-decoration-none text-secondary">Sports</a></li>
					</ul>
				</div>
				<div class="col-md-4 mb-4">
					<h6 class="fw-bold mb-3">Subscribe</h6>
					<p class="small text-secondary">Join our newsletter to stay up to date on features and releases.</p>
					<div class="input-group">
						<input type="email" class="form-control border-0" placeholder="Enter your email">
						<button class="btn btn-primary" type="button"><i class="fa-solid fa-paper-plane"></i></button>
					</div>
				</div>
			</div>
			<hr class="border-secondary opacity-25">
			<div class="row align-items-center">
				<div class="col-md-6 text-center text-md-start">
					<p class="small text-secondary mb-0">&copy; 2026 EventHub Inc. All rights reserved.</p>
				</div>
				<div class="col-md-6 text-center text-md-end">
					<a href="#" class="small text-secondary text-decoration-none me-3">Privacy Policy</a>
					<a href="#" class="small text-secondary text-decoration-none">Terms of Service</a>
				</div>
			</div>
		</div>
	</footer>

	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
	<script src="~/lib/jquery/dist/jquery.min.js"></script>
	<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
	@await RenderSectionAsync("Scripts", required: false)

	@if (User.Identity != null && User.Identity.IsAuthenticated)
	{
		<script>
			// --- 1. NOTIFICATION AJAX ---
			document.addEventListener("DOMContentLoaded", function () {
				fetchUnreadCount();
				checkValidatorStatus();
			});

			async function checkValidatorStatus() {
				try {
					const response = await fetch('/EventStaff/CheckIsValidator');
					const data = await response.json();
					if (data.isValidator) {
						var el = document.getElementById('validator-nav-item');
						if (el) el.style.display = '';
					}
				} catch (error) { console.error("Error checking validator status", error); }
			}

			async function fetchUnreadCount() {
				try {
					const response = await fetch('/Notification/GetUnreadCount');
					const data = await response.json();
					if (data.success) {
						const badge = document.getElementById("notif-badge");
						if (data.count > 0) {
							badge.innerText = data.count > 99 ? '99+' : data.count;
							badge.style.display = "inline-block";
						} else {
							badge.style.display = "none";
						}
					}
				} catch (error) { console.error("Error fetching unread count", error); }
			}

			function incrementUnreadBadge() {
				const badge = document.getElementById("notif-badge");
				if (!badge) return;

				const currentText = badge.innerText.trim();
				const currentCount = currentText === "99+" ? 99 : parseInt(currentText || "0", 10);
				const nextCount = Number.isNaN(currentCount) ? 1 : currentCount + 1;

				badge.innerText = nextCount > 99 ? "99+" : nextCount.toString();
				badge.style.display = "inline-block";
			}

			// Helper for choosing notification icon style by type
			function getIconThemeByType(type) {
				switch (type?.toLowerCase()) {
					case 'order': return { icon: 'fa-file-invoice-dollar', bg: 'bg-success bg-opacity-10', color: 'text-success' };
					case 'event': return { icon: 'fa-calendar-check', bg: 'bg-primary bg-opacity-10', color: 'text-primary' };
					case 'review': return { icon: 'fa-star', bg: 'bg-warning bg-opacity-10', color: 'text-warning' };
					case 'system': return { icon: 'fa-circle-info', bg: 'bg-info bg-opacity-10', color: 'text-info' };
					default: return { icon: 'fa-bell', bg: 'bg-secondary bg-opacity-10', color: 'text-secondary' };
				}
			}

			function createNotificationHtml(notif) {
				const isUnreadClass = notif.isRead ? "" : "notif-unread";
				const theme = getIconThemeByType(notif.type);
				const timeDisplay = notif.timeAgo || 'Just now';
				const unreadDot = notif.isRead ? '' : `<span class="badge bg-primary rounded-circle p-1 ms-2" style="width: 8px; height: 8px;"><span class="visually-hidden">Unread</span></span>`;

				return `
					<div class="notif-item p-3 border-bottom ${isUnreadClass}" id="notif-${notif.notificationId}" onclick="markAsRead(${notif.notificationId}, ${notif.isRead})">
						<div class="d-flex align-items-start gap-3">
							<div class="notif-icon-circle ${theme.bg} ${theme.color}">
								<i class="fa-solid ${theme.icon} fs-5"></i>
							</div>
							<div class="flex-grow-1 min-vw-0">
								<p class="mb-1 text-secondary notif-title text-break" style="line-height: 1.4; font-weight: 500;">${notif.title}</p>
								<p class="mb-2 small text-secondary text-break" style="line-height: 1.4;">${notif.message}</p>
								<div class="d-flex justify-content-between align-items-center mt-1">
									<div class="d-flex align-items-center">
										<small class="text-muted" style="font-size: 0.75rem;"><i class="fa-regular fa-clock me-1"></i>${timeDisplay}</small>
										${unreadDot}
									</div>
									<button class="btn btn-link text-secondary p-0 delete-notif-btn" onclick="deleteNotification(event, ${notif.notificationId})" title="Delete">
										<i class="fa-solid fa-trash-can" style="font-size: 0.9rem;"></i>
									</button>
								</div>
							</div>
						</div>
					</div>
				`;
			}

			async function loadNotifications() {
				const listContainer = document.getElementById("notif-list");
				listContainer.innerHTML = `<div class="p-5 text-center text-primary"><i class="fa-solid fa-spinner fa-spin fa-2x mb-2"></i><br><small class="text-muted">Loading notifications...</small></div>`;
				try {
					const response = await fetch('/Notification/GetMyNotifications');
					const result = await response.json();

					if (result.success && result.data) {
						listContainer.innerHTML = "";
						if (result.data.length === 0) {
							listContainer.innerHTML = `
								<div class="p-5 text-center text-muted">
									<i class="fa-regular fa-bell-slash fa-3x mb-3 opacity-50"></i>
									<p class="mb-0">You're all caught up!</p>
									<small>No new notifications.</small>
								</div>`;
							return;
						}
						result.data.forEach(notif => {
							listContainer.innerHTML += createNotificationHtml(notif);
						});
					}
				} catch (error) {
					listContainer.innerHTML = `<div class="p-4 text-danger small text-center">Failed to load notifications. Please try again.</div>`;
				}
			}

			async function markAsRead(id, isRead) {
				if (isRead) return;
				try {
					const response = await fetch(`/Notification/MarkAsRead?id=${id}`, { method: 'POST' });
					const result = await response.json();
					if (result.success) {
						const item = document.getElementById(`notif-${id}`);
						if(item) {
							item.classList.remove("notif-unread");
							const title = item.querySelector('.notif-title');
							if(title) { title.classList.remove('text-dark', 'fw-bold'); }
							const dot = item.querySelector('.badge.bg-primary.rounded-circle');
							if(dot) dot.remove();

							item.setAttribute("onclick", `markAsRead(${id}, true)`);
						}
						fetchUnreadCount();
					}
				} catch (error) { console.error("Error marking as read", error); }
			}

			async function markAllAsRead() {
				try {
					const response = await fetch('/Notification/MarkAllAsRead', { method: 'POST' });
					const result = await response.json();
					if (result.success) {
						document.querySelectorAll('.notif-item').forEach(item => {
							item.classList.remove("notif-unread");
							const dot = item.querySelector('.badge.bg-primary.rounded-circle');
							if(dot) dot.remove();
						});
						const badge = document.getElementById("notif-badge");
						badge.style.display = "none";
						badge.innerText = "0";
					}
				} catch (error) { console.error("Error marking all as read", error); }
			}

			// --- DELETE ONE NOTIFICATION ---
			async function deleteNotification(event, id) {
				event.stopPropagation(); // Do not trigger the parent click handler for mark-as-read
				try {
					const response = await fetch(`/Notification/DeleteNotification?id=${id}`, { method: 'DELETE' });
					const result = await response.json();
					if (result.success) {
						const item = document.getElementById(`notif-${id}`);
						if(item) {
							item.style.transition = "opacity 0.3s";
							item.style.opacity = "0";
							setTimeout(() => item.remove(), 300);
						}
						fetchUnreadCount(); // Refresh unread count in case the deleted notification was unread
						
						// Show empty state if no notifications remain
						setTimeout(() => {
							const list = document.getElementById("notif-list");
							if(list && list.children.length === 0) {
								list.innerHTML = `
									<div class="p-5 text-center text-muted">
										<i class="fa-regular fa-bell-slash fa-3x mb-3 opacity-50"></i>
										<p class="mb-0">You're all caught up!</p>
										<small>No new notifications.</small>
									</div>`;
							}
						}, 350);
					}
				} catch (error) { 
					console.error("Error deleting notification", error); 
					if (typeof showToast === "function") showToast("danger", "Failed to delete notification.");
				}
			}

			// --- DELETE ALL NOTIFICATIONS ---
			async function deleteAllNotifications(event) {
				if(event) event.preventDefault();
				if(!confirm("Are you sure you want to delete all notifications?")) return;

				try {
					const response = await fetch('/Notification/DeleteAllNotifications', { method: 'DELETE' });
					const result = await response.json();
					if (result.success) {
						const listContainer = document.getElementById("notif-list");
						listContainer.innerHTML = `
							<div class="p-5 text-center text-muted">
								<i class="fa-regular fa-bell-slash fa-3x mb-3 opacity-50"></i>
								<p class="mb-0">You're all caught up!</p>
								<small>No new notifications.</small>
							</div>`;
						fetchUnreadCount();
					}
				} catch (error) { 
					console.error("Error clearing notifications", error); 
					if (typeof showToast === "function") showToast("danger", "Failed to clear notifications.");
				}
			}

					// --- 2. SIGNALR ---
			const userToken = '@(User.FindFirst("AccessToken")?.Value)';

			const hubUrl = "https://localhost:7158/notification-gateway/notificationHub";

			const notifConnection = new signalR.HubConnectionBuilder()
				.withUrl(hubUrl, {
					accessTokenFactory: () => userToken
				})
				.withAutomaticReconnect()
				.build();

			function prependRealtimeNotification(notification) {
				const listContainer = document.getElementById("notif-list");
				if (!listContainer) return;

				if (listContainer.innerHTML.indexOf("You're all caught up!") !== -1) {
					listContainer.innerHTML = "";
				}

				const newNotif = {
					notificationId: notification.notificationId,
					isRead: false,
					type: notification.type,
					title: notification.title,
					message: notification.message,
					timeAgo: 'Just now'
				};

				listContainer.insertAdjacentHTML('afterbegin', createNotificationHtml(newNotif));
			}

			notifConnection.on("ReceiveNewNotification", function (notification) {
				console.log("Notification SignalR received:", notification);

				if (typeof showToast === "function") {
					showToast("info", notification.title + ": " + notification.message);
				}

				prependRealtimeNotification(notification);
				incrementUnreadBadge();
			});

			notifConnection.start().then(function () {
				console.log("Notification SignalR connected successfully!");
				fetchUnreadCount();
			}).catch(function (err) {
				console.error("Notification SignalR connection error:", err.toString());
			});

			notifConnection.onreconnected(function () {
				console.log("Notification SignalR reconnected.");
				fetchUnreadCount();
			});

			notifConnection.onclose(function () {
				console.warn("Notification SignalR disconnected. Unread badge will use polling fallback.");
			});

			setInterval(function () {
				if (notifConnection.state !== signalR.HubConnectionState.Connected) {
					fetchUnreadCount();
				}
			}, 15000);
		</script>
	}

	<script>
		function toggleChat() {
			const chatWindow = document.getElementById('ai-chat-window');
			const chatIcon = document.querySelector('#ai-chat-btn i');

			if (chatWindow.style.display === 'none' || chatWindow.style.display === '') {
				chatWindow.style.display = 'flex';
				chatIcon.classList.remove('fa-message');
				chatIcon.classList.add('fa-xmark');
			} else {
				chatWindow.style.display = 'none';
				chatIcon.classList.remove('fa-xmark');
				chatIcon.classList.add('fa-message');
			}
		}

		function appendMessage(sender, text) {
			const chatBox = document.getElementById("chatBox");
			let messageHtml = "";

			const formattedText = text.replace(/\n/g, "<br>");

			if (sender === "user") {
				messageHtml = `
				<div class="d-flex mb-3 justify-content-end">
					<div class="chat-message-user p-2 px-3 shadow-sm" style="max-width: 85%;">
						${formattedText}
					</div>
				</div>`;
			} else {
				messageHtml = `
				<div class="d-flex mb-3 justify-content-start">
					<div class="chat-message-ai p-2 px-3 shadow-sm text-dark" style="max-width: 85%;">
						${formattedText}
					</div>
				</div>`;
			}

			chatBox.innerHTML += messageHtml;
			chatBox.scrollTop = chatBox.scrollHeight;
		}

		let chatHistory = [];

		async function sendMessage() {
			const inputField = document.getElementById("userInput");
			const message = inputField.value.trim();
			if (!message) return;

			inputField.value = "";
			appendMessage("user", message);
			chatHistory.push({ role: "user", text: message });

			const chatBox = document.getElementById("chatBox");
			const loadingId = "loading-" + Date.now();

			chatBox.innerHTML += `
				<div id="${loadingId}" class="d-flex mb-3 justify-content-start">
					<div class="chat-message-ai p-2 px-3 shadow-sm text-muted" style="max-width: 85%;">
						<i class="fa-solid fa-ellipsis fa-bounce"></i>
					</div>
				</div>`;
			chatBox.scrollTop = chatBox.scrollHeight;

			try {
				const response = await fetch('https://localhost:7158/chatbot-gateway/Chat/ask', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify(chatHistory)
				});

				const loadingElement = document.getElementById(loadingId);
				if (loadingElement) loadingElement.remove();

				if (response.ok) {
					const data = await response.json();
					const aiReplyText = data.reply || data.message || "Sorry, I am unable to answer at this time.";

					appendMessage("ai", aiReplyText);
					chatHistory.push({ role: "ai", text: aiReplyText });
				} else {
					appendMessage("ai", "Error connecting to AI server.");
				}
			} catch (error) {
				const loadingElement = document.getElementById(loadingId);
				if (loadingElement) loadingElement.remove();

				appendMessage("ai", "Unable to connect to the server.");
				console.error("Error:", error);
			}
		}
	</script>
</body>
</html>

