@model WebClient.DTOs.Request.CreateCategoryDTO
@{
    ViewData["Title"] = "Create Category";
    Layout = "_LayoutAdmin";
}

<style>
    .card-section {
        background: white;
        border-radius: 16px;
        padding: 2rem;
        border: none;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        margin-bottom: 2rem;
    }

    .section-header {
        border-bottom: 1px solid #e2e8f0;
        padding-bottom: 1rem;
        margin-bottom: 1.5rem;
    }

    .form-label {
        font-weight: 600;
        font-size: 0.9rem;
        color: #475569;
    }

    .form-control, .form-select {
        border-radius: 10px;
        padding: 0.75rem 1rem;
        border: 1px solid #e2e8f0;
    }

        .form-control:focus, .form-select:focus {
            border-color: var(--primary-color);
            box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1);
        }
</style>

<div class="mb-4">
    <a asp-action="Index" class="text-decoration-none text-muted fw-medium mb-2 d-inline-block">
        <i class="fa-solid fa-arrow-left me-1"></i> Back to Categories
    </a>
</div>

<form asp-action="Create" method="post">
    <div class="card-section">
        <div class="section-header">
            <h5 class="fw-bold mb-0">
                <i class="fa-regular fa-folder-open me-2 text-primary"></i>
                Category Information
            </h5>
        </div>

        <div class="row g-4">
            <div class="col-12">
                <label class="form-label">Category Name <span class="text-danger">*</span></label>
                <input name="CategoryName" type="text" class="form-control" value="@Model?.CategoryName" placeholder="e.g. Music, Technology...">
                <span asp-validation-for="CategoryName" class="text-danger"></span>

            </div>

            <div class="col-12">
                <label class="form-label">Description</label>
                <textarea name="Description" class="form-control" rows="4" placeholder="Describe this category...">@Model?.Description</textarea>
            </div>

            <div class="col-md-4">
                <label class="form-label">Status</label>
                <select name="IsActive" class="form-select">
                    <option value="true" selected="@(Model?.IsActive != false)">Active</option>
                    <option value="false" selected="@(Model?.IsActive == false)">Inactive</option>
                </select>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-end ">
        <button type="submit" class="btn-dashboard-primary">
            <i class="fa-solid fa-check me-2"></i> Save Category
        </button>
    </div>
</form>

@section Scripts{
    <script src="~/js/common/toast.js"></script>
    <script src="~/js/common/loading.js"></script>
}
@if (TempData["ToastMessage"] != null)
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            showToast(
                "@TempData["ToastType"]",
                "@TempData["ToastMessage"]"
            );
        });
    </script>
}