@using WebClient.ViewModel
@model SearchViewModel

<div class="d-flex justify-content-between align-items-center mb-4">
    <h5 class="fw-bold mb-0 text-dark">Showing <span class="text-primary">@Model.TotalItems</span> events</h5>

    <div class="d-flex align-items-center">
        <label class="small text-muted me-2 text-nowrap">Sort by:</label>
        <select id="sortSelect" class="form-select form-select-sm border-0 bg-white shadow-sm" style="width: 150px;">
            <option value="relevance" selected="@(ViewBag.SortOption == "relevance")">Relevance</option>
            <option value="date_asc" selected="@(ViewBag.SortOption == "date_asc")">Date: Soonest</option>
            <option value="price_asc" selected="@(ViewBag.SortOption == "price_asc")">Price: Low to High</option>
            <option value="price_desc" selected="@(ViewBag.SortOption == "price_desc")">Price: High to Low</option>
        </select>
    </div>
</div>

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    @if (Model.Events != null && Model.Events.Any())
    {
        foreach (var item in Model.Events)
        {
            var minPrice = (item.TicketTypes != null && item.TicketTypes.Any()) ? item.TicketTypes.Min(t => t.Price) : 0;
            var imgUrl = string.IsNullOrEmpty(item.PosterUrl) ? "https://placehold.co/600x400?text=Event" : item.PosterUrl;
            bool isWishlisted = Model.WishlistedEventIds != null && Model.WishlistedEventIds.Contains(item.EventId);
            bool isEnded = DateTime.Now > item.EndDate;

            <div class="col">
                <div class="card event-card h-100">
                    <div class="card-img-wrapper">
                        <img src="@imgUrl" class="card-img-top" alt="@item.Title">
                        <div class="date-badge">
                            <span class="month">@item.StartDate.ToString("MMM").ToUpper()</span>
                            <span class="day">@item.StartDate.ToString("dd")</span>
                        </div>
                        <span class="badge @(isEnded ? "bg-secondary" : "bg-primary") position-absolute bottom-0 start-0 m-3 px-3 py-2 rounded-pill">
                            @(isEnded ? "Ended" : "Upcoming")
                        </span>

                        <button type="button" class="btn-wishlist @(isWishlisted ? "active" : "")" onclick="toggleWishlist(@item.EventId, this)">
                            <i class="fa-solid fa-heart"></i>
                        </button>
                    </div>
                    <div class="card-body">
                        <a asp-action="EventDetails" asp-controller="Home" asp-route-id="@item.EventId" class="event-title">
                            @item.Title
                        </a>
                        <div class="mt-2">
                            <div class="event-meta">
                                <i class="fa-regular fa-clock text-primary"></i>
                                @item.StartDate.ToString("HH:mm") - @item.EndDate.ToString("HH:mm")
                            </div>
                            <div class="event-meta">
                                <i class="fa-solid fa-location-dot text-danger"></i>
                                @item.Location
                            </div>
                        </div>
                    </div>
                    <div class="card-footer">
                        <div class="d-flex align-items-center">
                            <img src="https://ui-avatars.com/api/?name=Event&background=random" class="organizer-avatar">
                            <small class="text-muted fw-medium">Organizer</small>
                        </div>
                        <span class="event-price @(minPrice == 0 ? "text-success" : "")">
                            @(minPrice == 0 ? "Free" : $"{minPrice:N0} đ")
                        </span>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12 text-center py-5">
            <div class="text-muted">
                <i class="fa-regular fa-folder-open fa-3x mb-3 opacity-50"></i>
                <p>No events found matching your criteria.</p>
                <a href="@Url.Action("Search", "Home")" class="btn btn-sm btn-outline-primary mt-2">Clear Filters</a>
            </div>
        </div>
    }
</div>

@if (Model.TotalPages > 1)
{
    <div class="mt-5 d-flex justify-content-center">
        <nav>
            <ul class="pagination">
                <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Search", "Home", new { page = Model.CurrentPage - 1 })" data-search-page="@(Model.CurrentPage - 1)">Previous</a>
                </li>

                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Search", "Home", new { page = i })" data-search-page="@i">@i</a>
                    </li>
                }

                <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Search", "Home", new { page = Model.CurrentPage + 1 })" data-search-page="@(Model.CurrentPage + 1)">Next</a>
                </li>
            </ul>
        </nav>
    </div>
}
