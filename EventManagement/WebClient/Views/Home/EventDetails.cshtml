@using WebClient.ViewModel
@using System.Security.Claims
@model EventDetailViewModel

@{
    ViewData["Title"] = Model.Event.Title;
    Layout = "_Layout";
    var bgImage = string.IsNullOrEmpty(Model.Event.PosterUrl) ? "https://placehold.co/1920x600?text=Event+Cover" : Model.Event.PosterUrl;
    bool isEnded = DateTime.Now > Model.Event.EndDate;

    bool isWishlisted = ViewBag.IsWishlisted ?? false;
    var pageIdentity = User.Identity as ClaimsIdentity;
    var pageCurrentUserIdStr = pageIdentity?.FindFirst("sub")?.Value
        ?? pageIdentity?.FindFirst(ClaimTypes.NameIdentifier)?.Value
        ?? pageIdentity?.FindFirst("UserId")?.Value;
    bool pageHasBooked = ViewBag.HasBooked ?? false;
}

<link rel="stylesheet" href="~/css/home_page/event_detail_style.css" />

<div class="mt-5">
    <div class="event-hero">
        <img src="@bgImage" alt="@Model.Event.Title">

        <div class="btn-wishlist-hero @(isWishlisted ? "active" : "")"
             onclick="toggleWishlist(@Model.Event.EventId, this)"
             style="cursor: pointer;">
            <i class="@(isWishlisted ? "fa-solid" : "fa-regular") fa-heart"></i>
        </div>

        <div class="event-hero-overlay">
            <div class="container text-white">

                @if (isEnded)
                {
                    <span class="badge bg-danger text-white px-3 py-2 rounded-pill fw-bold mb-3">
                        Ended
                    </span>
                }
                else
                {
                    <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold mb-3">
                        @(Model.Event.Status == "Approved" ? "Upcoming" : Model.Event.Status)
                    </span>
                }

                <h1 class="display-3 fw-bold mb-2">@Model.Event.Title</h1>
                <div class="d-flex align-items-center gap-4 text-white-50 flex-wrap">
                    <span>
                        <i class="fa-regular fa-calendar me-2"></i> @Model.Event.StartDate.ToString("MMM dd, yyyy")
                    </span>
                    <span>
                        <i class="fa-regular fa-clock me-2"></i> @Model.Event.StartDate.ToString("h:mm tt") - @Model.Event.EndDate.ToString("h:mm tt")
                    </span>
                    <span>
                        <i class="fa-solid fa-location-dot me-2"></i> @Model.Event.Location
                    </span>
                </div>
            </div>
        </div>
    </div>

    <div class="container content-container mb-5">
        <div class="row">
            <div class="col-lg-8">
                <div class="info-card">
                    <h3 class="fw-bold mb-4">About the Event</h3>
                    <div class="organizer-badge d-flex align-items-center gap-3 mb-4">
                        <img src="@(Model.Organizer?.AvatarUrl ?? "https://placehold.co/60x60?text=Org")"
                             class="rounded-circle shadow-sm"
                             alt="Organizer"
                             width="60"
                             height="60"
                             style="object-fit: cover; flex-shrink: 0;">

                        <div>
                            <div class="small text-muted text-uppercase fw-bold">Organized by</div>
                            <h6 class="mb-0 fw-bold fs-5">
                                @(Model.Organizer?.FullName ?? $"Organizer ID: {Model.Event.OrganizerId}")
                            </h6>
                        </div>
                    </div>
                    <div class="text-secondary mb-4 description-content" style="white-space: pre-line;">
                        @Model.Event.Description
                    </div>
                    <h4 class="fw-bold mt-5 mb-3">Location</h4>
                    <p class="text-muted"><i class="fa-solid fa-location-dot"></i> @Model.Event.Location</p>

                    <div class="rounded-4 overflow-hidden mb-4" style="height: 300px; position: relative;">
                        <div id="customerEventMap" style="height: 300px; width: 100%; z-index: 1;"></div>
                    </div>
                </div>

                <div class="info-card mt-4">
                    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
                        <div class="d-flex align-items-center gap-3">
                            <h3 class="fw-bold mb-0">Reviews (<span id="review-total-count">@Model.TotalReviews</span>)</h3>
                            <div class="d-flex align-items-center gap-1 text-warning fs-5">
                                <span class="fw-bold text-dark me-2" id="review-average-rating">@Model.AverageRating.ToString("0.0")</span>
                                <i class="fa-solid fa-star"></i>
                            </div>
                        </div>

                        <div>
                            <form method="get" id="sortForm" class="d-flex align-items-center gap-2">
                                <label for="sortReview" class="form-label mb-0 small text-muted text-nowrap fw-bold">Sort by:</label>
                                <select name="sortOrder" id="sortReview" class="form-select form-select-sm rounded-pill" onchange="document.getElementById('sortForm').submit();" style="width: auto; cursor: pointer;">
                                    @{
                                        var currentSort = Context.Request.Query["sortOrder"].ToString();
                                    }
                                    <option value="newest" selected="@(string.IsNullOrEmpty(currentSort) || currentSort == "newest")">Newest First</option>
                                    <option value="oldest" selected="@(currentSort == "oldest")">Oldest First</option>
                                    <option value="highest" selected="@(currentSort == "highest")">Highest Rating (5★)</option>
                                    <option value="lowest" selected="@(currentSort == "lowest")">Lowest Rating (1★)</option>
                                </select>
                            </form>
                        </div>
                    </div>

                    <div id="review-gate">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        var identity = User.Identity as System.Security.Claims.ClaimsIdentity;
                        var currentUserIdStr = identity?.FindFirst("sub")?.Value
                        ?? identity?.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
                        ?? identity?.FindFirst("UserId")?.Value;

                        bool hasReviewed = Model.Reviews != null && Model.Reviews.Any(r => r.UserId.ToString() == currentUserIdStr);
                        bool hasBooked = ViewBag.HasBooked ?? false;

                        if (hasReviewed)
                        {
                            <div class="alert alert-success small text-center rounded-pill mb-4 border-0 bg-success bg-opacity-10 text-success fw-bold">
                                <i class="fa-solid fa-circle-check me-2"></i> You have already reviewed this event. Thank you!
                            </div>
                        }
                        else if (!hasBooked)
                        {
                            <div class="alert alert-warning small text-center rounded-pill mb-4 border-0 bg-warning bg-opacity-10 text-warning-emphasis fw-bold">
                                <i class="fa-solid fa-ticket me-2"></i> You need to book a ticket for this event to leave a review.
                            </div>
                        }
                        else if (!isEnded)
                        {
                            <div class="alert alert-info small text-center rounded-pill mb-4 border-0 bg-info bg-opacity-10 text-info-emphasis fw-bold">
                                <i class="fa-solid fa-clock-rotate-left me-2"></i> You can leave a review after the event has ended.
                            </div>
                        }
                        else
                        {
                            <div class="card card-body bg-light mb-4 border-0">
                                <h6 class="fw-bold">Leave a review</h6>
                                <div class="mb-2 text-warning fs-5" id="star-rating">
                                    <i class="fa-regular fa-star" onclick="setRating(1)" style="cursor:pointer"></i>
                                    <i class="fa-regular fa-star" onclick="setRating(2)" style="cursor:pointer"></i>
                                    <i class="fa-regular fa-star" onclick="setRating(3)" style="cursor:pointer"></i>
                                    <i class="fa-regular fa-star" onclick="setRating(4)" style="cursor:pointer"></i>
                                    <i class="fa-regular fa-star" onclick="setRating(5)" style="cursor:pointer"></i>
                                </div>
                                <input type="hidden" id="review-rating" value="0" />
                                <textarea id="review-comment" class="form-control mb-2" rows="2" placeholder="Share your experience..."></textarea>
                                <div class="text-end">
                                    <button type="button" class="btn btn-sm btn-primary px-4 rounded-pill" onclick="submitReview(@Model.Event.EventId)">Submit Review</button>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="alert alert-info small text-center rounded-pill mb-4 border-0 bg-info bg-opacity-10 text-info-emphasis">
                            Please <a href="/Authentication/Login" class="fw-bold text-info-emphasis">log in</a> to leave a review.
                        </div>
                    }
                    </div>

                    @if (Model.Reviews != null && Model.Reviews.Any())
                    {
                        var identity = User.Identity as System.Security.Claims.ClaimsIdentity;
                        var currentUserIdStr = identity?.FindFirst("sub")?.Value
                        ?? identity?.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
                        ?? identity?.FindFirst("UserId")?.Value;

                        <div class="review-list" id="review-list">
                            @foreach (var review in Model.Reviews)
                            {
                                <div class="d-flex gap-3 mb-4 pb-4 border-bottom" id="review-item-@review.ReviewId">
                                    <img src="@review.AvatarUrl"
                                         class="rounded-circle border"
                                         width="50" height="50"
                                         style="object-fit: cover;"
                                         alt="@review.UserName">

                                    <div class="flex-grow-1">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <h6 class="fw-bold mb-0">@review.UserName</h6>

                                            <div class="d-flex align-items-center gap-3">
                                                <small class="text-muted">@review.CreatedAt.ToString("MMM dd, yyyy")</small>

                                                @if (currentUserIdStr != null && review.UserId.ToString() == currentUserIdStr)
                                                {
                                                    <div class="dropdown">
                                                        <button class="btn btn-sm btn-light border-0" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Options">
                                                            <i class="fa-solid fa-ellipsis-vertical"></i>
                                                        </button>
                                                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                                            <li>
                                                                <a class="dropdown-item" href="javascript:void(0)"
                                                                   onclick="openEditModal(@review.ReviewId, @review.Rating, '@Html.Raw(review.Comment?.Replace("'", "\\'"))')">
                                                                    <i class="fa-regular fa-pen-to-square me-2 text-primary"></i> Edit
                                                                </a>
                                                            </li>
                                                            <li>
                                                                <a class="dropdown-item text-danger" href="javascript:void(0)"
                                                                   onclick="deleteReview(@review.ReviewId)">
                                                                    <i class="fa-regular fa-trash-can me-2"></i> Delete
                                                                </a>
                                                            </li>
                                                        </ul>
                                                    </div>
                                                }
                                            </div>
                                        </div>

                                        <div class="mb-2 text-warning small">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                if (i <= review.Rating)
                                                {
                                                    <i class="fa-solid fa-star"></i>
                                                }
                                                else
                                                {
                                                    <i class="fa-regular fa-star text-muted opacity-25"></i>
                                                }
                                            }
                                        </div>
                                        <p class="text-secondary mb-0" id="review-comment-text-@review.ReviewId">@review.Comment</p>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4" id="review-list">
                            <i class="fa-regular fa-comment-dots fa-3x text-muted mb-3 opacity-50"></i>
                            <p class="text-muted">No reviews yet. Be the first to review!</p>
                        </div>
                    }
                </div>
            </div>

            <div class="col-lg-4">
                <div class="booking-card">
                    <h4 class="fw-bold mb-4">Select Tickets</h4>

                    @if (isEnded)
                    {
                        <div class="alert alert-danger text-center mb-4 border-0">
                            <i class="fa-solid fa-clock-rotate-left fa-2x mb-2 text-danger"></i>
                            <p class="mb-0 fw-bold text-danger">This event has already ended.</p>
                            <small class="text-danger opacity-75">Thank you for your interest!</small>
                        </div>

                        <button class="btn btn-danger w-100 py-3 fw-bold rounded-pill opacity-75" type="button" disabled>
                            Event Ended
                        </button>
                    }
                    else
                    {
                        <form asp-action="Checkout" asp-controller="Booking" method="get">
                            <input type="hidden" name="EventId" value="@Model.Event.EventId" />

                            @if (Model.Event.TicketTypes != null && Model.Event.TicketTypes.Any())
                            {
                                foreach (var ticket in Model.Event.TicketTypes)
                                {
                                    bool isNotStarted = ticket.SaleStartDate.HasValue && DateTime.Now < ticket.SaleStartDate.Value;
                                    bool isExpired = ticket.SaleEndDate.HasValue && DateTime.Now > ticket.SaleEndDate.Value;
                                    bool isSaleActive = !isNotStarted && !isExpired;

                                    <div class="ticket-row mb-3 border-bottom pb-3">
                                        <div class="flex-grow-1">
                                            <div class="d-flex align-items-center gap-2">
                                                <h6 class="fw-bold mb-0">@ticket.TypeName</h6>
                                                @if (isNotStarted)
                                                {
                                                    <span class="badge bg-secondary" style="font-size: 0.65rem;">Upcoming Sale</span>
                                                }
                                                else if (isExpired)
                                                {
                                                    <span class="badge bg-danger" style="font-size: 0.65rem;">Sale Ended</span>
                                                }
                                            </div>
                                            <small class="text-muted d-block mt-1" style="font-size: 0.75rem;">
                                                Available: @ticket.Quantity
                                            </small>
                                            @if (ticket.SaleStartDate.HasValue || ticket.SaleEndDate.HasValue)
                                            {
                                                <small class="text-muted d-block" style="font-size: 0.7rem;">
                                                    <i class="fa-regular fa-clock me-1"></i>
                                                    @(ticket.SaleStartDate.HasValue ? ticket.SaleStartDate.Value.ToString("dd/MM/yyyy HH:mm") : "Anytime")
                                                    -
                                                    @(ticket.SaleEndDate.HasValue ? ticket.SaleEndDate.Value.ToString("dd/MM/yyyy HH:mm") : "Event Start")
                                                </small>
                                            }
                                            <small class="text-success fw-bold">
                                                @(ticket.Price == 0 ? "Free" : $"{ticket.Price:N0} đ")
                                            </small>
                                        </div>

                                        @if (isSaleActive)
                                        {
                                            <div class="quantity-control">
                                                <button type="button" class="btn-qty"
                                                        onclick="updateQty(@ticket.TicketTypeId, -1, @ticket.Price, @ticket.Quantity)">
                                                    <i class="fa-solid fa-minus"></i>
                                                </button>
                                                <span id="display-qty-@ticket.TicketTypeId" class="fw-bold small" style="width: 25px; text-align: center;">0</span>
                                                <input type="hidden" id="input-qty-@ticket.TicketTypeId"
                                                       name="cart[@ticket.TicketTypeId]" value="0" />
                                                <button type="button" class="btn-qty"
                                                        onclick="updateQty(@ticket.TicketTypeId, 1, @ticket.Price, @ticket.Quantity)">
                                                    <i class="fa-solid fa-plus"></i>
                                                </button>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="small text-muted fst-italic align-self-center">
                                                @(isNotStarted ? "Not for sale yet" : "Sale closed")
                                            </div>
                                        }
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="alert alert-warning">Sold Out or No Tickets Available</div>
                            }

                            <div class="d-flex justify-content-between align-items-center mt-4 mb-4 pt-3 border-top">
                                <span class="text-muted fw-bold">Total</span>
                                <span class="fs-4 fw-bold text-primary" id="total-price">0 đ</span>
                            </div>

                            <button class="btn-book w-100" type="submit" @(Model.Event.TicketTypes == null || !Model.Event.TicketTypes.Any() ? "disabled" : "")>
                                Book Now
                            </button>
                        </form>
                    }

                    <p class="text-center text-muted small mt-3 mb-0">
                        <i class="fa-solid fa-shield-halved me-1"></i> Secure Payment
                    </p>
                </div>

                <div class="mt-4 text-center">
                    <p class="small text-muted fw-bold mb-2">Share this event</p>
                    <div class="d-flex justify-content-center gap-3">
                        <a href="#" class="btn btn-light rounded-circle shadow-sm" style="width: 40px; height: 40px;"><i class="fa-brands fa-facebook-f text-primary"></i></a>
                        <a href="#" class="btn btn-light rounded-circle shadow-sm" style="width: 40px; height: 40px;"><i class="fa-brands fa-twitter text-info"></i></a>
                        <a href="#" class="btn btn-light rounded-circle shadow-sm" style="width: 40px; height: 40px;"><i class="fa-solid fa-link text-secondary"></i></a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="editReviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold">Edit Review</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="edit-review-id" />
                <div class="mb-3 text-warning fs-4 text-center" id="edit-star-rating">
                    <i class="fa-regular fa-star" onclick="setEditRating(1)" style="cursor:pointer"></i>
                    <i class="fa-regular fa-star" onclick="setEditRating(2)" style="cursor:pointer"></i>
                    <i class="fa-regular fa-star" onclick="setEditRating(3)" style="cursor:pointer"></i>
                    <i class="fa-regular fa-star" onclick="setEditRating(4)" style="cursor:pointer"></i>
                    <i class="fa-regular fa-star" onclick="setEditRating(5)" style="cursor:pointer"></i>
                </div>
                <input type="hidden" id="edit-review-rating" value="0" />
                <textarea id="edit-review-comment" class="form-control" rows="3"></textarea>
            </div>
            <div class="modal-footer border-top-0 pt-0">
                <button type="button" class="btn btn-light rounded-pill" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary rounded-pill px-4" onclick="submitEditReview()">Save changes</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteReviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-body text-center p-4">
                <i class="fa-solid fa-triangle-exclamation text-danger fa-3x mb-3"></i>
                <h5 class="fw-bold mb-2">Delete Review?</h5>
                <p class="text-muted small mb-4">This action cannot be undone. Are you sure you want to delete this review?</p>
                <input type="hidden" id="delete-review-id" />
                <div class="d-flex justify-content-center gap-2">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-danger rounded-pill px-4" onclick="confirmDeleteReview()">Yes, Delete</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="~/js/common/toast.js"></script>
    <script>
        const custEventLat = @(Model.Event.Latitude.HasValue ? Model.Event.Latitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "null");
        const custEventLng = @(Model.Event.Longitude.HasValue ? Model.Event.Longitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "null");
        const custEventAddress = "@(Model.Event.Location?.Replace("\"", "\\\"") ?? string.Empty)";
        const custDefaultCenter = [10.776889, 106.700806];

        document.addEventListener('DOMContentLoaded', function() {
            initCustMap();
        });

        function initCustMap() {
            try {
                const container = document.getElementById('customerEventMap');
                if (!container) return;

                const hasSavedCoords = custEventLat !== null && custEventLng !== null;
                const center = hasSavedCoords
                    ? [parseFloat(custEventLat), parseFloat(custEventLng)]
                    : custDefaultCenter;

                const map = L.map(container).setView(center, hasSavedCoords ? 15 : 13);
                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    maxZoom: 19,
                    attribution: '© OpenStreetMap'
                }).addTo(map);

                if (hasSavedCoords) {
                    L.marker(center).addTo(map).bindPopup('@Html.Raw(Model.Event.Title)').openPopup();
                } else {
                    const defaultMarker = L.marker(center).addTo(map).bindPopup('@Html.Raw(Model.Event.Title)').openPopup();
                    if (custEventAddress && custEventAddress.trim().length > 0) {
                        fetch('https://nominatim.openstreetmap.org/search?format=json&q=' + encodeURIComponent(custEventAddress))
                            .then(res => res.json())
                            .then(data => {
                                if (data && data.length > 0) {
                                    var lat = parseFloat(data[0].lat);
                                    var lon = parseFloat(data[0].lon);
                                    map.setView([lat, lon], 15);
                                    defaultMarker.setLatLng([lat, lon]);
                                }
                            }).catch(err => console.error(err));
                    }
                }
            } catch (err) {
                console.error('Error initializing customer event map:', err);
            }
        }
    </script>

    <script>
        async function toggleWishlist(eventId, element) {
            const icon = element.querySelector("i");
            const isAdding = !element.classList.contains('active');
            element.style.pointerEvents = 'none';

            try {
                const response = await fetch('/Wishlist/ToggleWishlist', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ eventId: eventId, isAdding: isAdding })
                });

                const data = await response.json();

                if (data.success) {
                    if (isAdding) {
                        element.classList.add('active');
                        icon.classList.remove("fa-regular");
                        icon.classList.add("fa-solid");
                    } else {
                        element.classList.remove('active');
                        icon.classList.remove("fa-solid");
                        icon.classList.add("fa-regular");
                    }
                }
                else if (data.message === "unauthorized") {
                    showToast("danger", "Please login to save events!");
                }
                else {
                    showToast("danger", "Something went wrong.");
                }
            } catch (error) {
                console.error("Error:", error);
                showToast("danger", "Failed to connect to server.");
            } finally {
                element.style.pointerEvents = 'auto';
            }
        }
    </script>

    <script>
        let cartData = {};

        function updateQty(ticketId, change, price, maxQty) {
            if (!cartData[ticketId]) {
                cartData[ticketId] = { qty: 0, price: price };
            }

            let currentQty = cartData[ticketId].qty;
            let newQty = currentQty + change;

            if (newQty >= 0 && newQty <= maxQty) {
                cartData[ticketId].qty = newQty;
                document.getElementById(`display-qty-${ticketId}`).innerText = newQty;
                document.getElementById(`input-qty-${ticketId}`).value = newQty;
                recalcTotal();
            }
        }

        function recalcTotal() {
            let total = 0;
            for (let id in cartData) {
                total += cartData[id].qty * cartData[id].price;
            }
            document.getElementById('total-price').innerText = total.toLocaleString('en-US') + ' đ';
        }
    </script>

    <script>
        const reviewEventId = @Model.Event.EventId;
        const currentReviewUserId = @(!string.IsNullOrEmpty(pageCurrentUserIdStr) ? pageCurrentUserIdStr : "null");
        const reviewUserAuthenticated = @(User.Identity?.IsAuthenticated == true ? "true" : "false");
        const reviewHasBooked = @(pageHasBooked ? "true" : "false");
        const reviewEventEnded = @(isEnded ? "true" : "false");
        const reviewSortOrder = new URLSearchParams(window.location.search).get('sortOrder') || 'newest';

        function escapeHtml(value) {
            if (value === null || value === undefined) return "";
            return String(value)
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }

        function escapeJsString(value) {
            return escapeHtml(value)
                .replace(/\\/g, "\\\\")
                .replace(/`/g, "\\`")
                .replace(/\r/g, "\\r")
                .replace(/\n/g, "\\n");
        }

        function formatReviewDate(value) {
            const date = new Date(value);
            if (Number.isNaN(date.getTime())) return "";
            return date.toLocaleDateString("en-US", { month: "short", day: "2-digit", year: "numeric" });
        }

        function renderStars(rating) {
            let html = "";
            for (let i = 1; i <= 5; i++) {
                html += i <= rating
                    ? '<i class="fa-solid fa-star"></i>'
                    : '<i class="fa-regular fa-star text-muted opacity-25"></i>';
            }
            return html;
        }

        function renderReviewItem(review) {
            const isOwner = currentReviewUserId !== null && review.userId === currentReviewUserId;
            const safeComment = escapeHtml(review.comment || "");
            const safeCommentForJs = escapeJsString(review.comment || "");
            const safeName = escapeHtml(review.userName || "Anonymous");
            const safeAvatar = escapeHtml(review.avatarUrl || "/images/default-avatar.png");

            return `
                <div class="d-flex gap-3 mb-4 pb-4 border-bottom" id="review-item-${review.reviewId}">
                    <img src="${safeAvatar}"
                         class="rounded-circle border"
                         width="50" height="50"
                         style="object-fit: cover;"
                         alt="${safeName}">

                    <div class="flex-grow-1">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <h6 class="fw-bold mb-0">${safeName}</h6>

                            <div class="d-flex align-items-center gap-3">
                                <small class="text-muted">${formatReviewDate(review.createdAt)}</small>

                                ${isOwner ? `
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-light border-0" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Options">
                                            <i class="fa-solid fa-ellipsis-vertical"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                            <li>
                                                <a class="dropdown-item" href="javascript:void(0)"
                                                   onclick="openEditModal(${review.reviewId}, ${review.rating}, \`${safeCommentForJs}\`)">
                                                    <i class="fa-regular fa-pen-to-square me-2 text-primary"></i> Edit
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item text-danger" href="javascript:void(0)"
                                                   onclick="deleteReview(${review.reviewId})">
                                                    <i class="fa-regular fa-trash-can me-2"></i> Delete
                                                </a>
                                            </li>
                                        </ul>
                                    </div>` : ""}
                            </div>
                        </div>

                        <div class="mb-2 text-warning small">
                            ${renderStars(review.rating)}
                        </div>
                        <p class="text-secondary mb-0" id="review-comment-text-${review.reviewId}">${safeComment}</p>
                    </div>
                </div>`;
        }

        function renderReviewForm() {
            return `
                <div class="card card-body bg-light mb-4 border-0">
                    <h6 class="fw-bold">Leave a review</h6>
                    <div class="mb-2 text-warning fs-5" id="star-rating">
                        <i class="fa-regular fa-star" onclick="setRating(1)" style="cursor:pointer"></i>
                        <i class="fa-regular fa-star" onclick="setRating(2)" style="cursor:pointer"></i>
                        <i class="fa-regular fa-star" onclick="setRating(3)" style="cursor:pointer"></i>
                        <i class="fa-regular fa-star" onclick="setRating(4)" style="cursor:pointer"></i>
                        <i class="fa-regular fa-star" onclick="setRating(5)" style="cursor:pointer"></i>
                    </div>
                    <input type="hidden" id="review-rating" value="0" />
                    <textarea id="review-comment" class="form-control mb-2" rows="2" placeholder="Share your experience..."></textarea>
                    <div class="text-end">
                        <button type="button" class="btn btn-sm btn-primary px-4 rounded-pill" onclick="submitReview(${reviewEventId})">Submit Review</button>
                    </div>
                </div>`;
        }

        function renderReviewGate(hasReviewed) {
            const gate = document.getElementById("review-gate");
            if (!gate) return;

            if (!reviewUserAuthenticated) {
                gate.innerHTML = `<div class="alert alert-info small text-center rounded-pill mb-4 border-0 bg-info bg-opacity-10 text-info-emphasis">
                    Please <a href="/Authentication/Login" class="fw-bold text-info-emphasis">log in</a> to leave a review.
                </div>`;
            } else if (hasReviewed) {
                gate.innerHTML = `<div class="alert alert-success small text-center rounded-pill mb-4 border-0 bg-success bg-opacity-10 text-success fw-bold">
                    <i class="fa-solid fa-circle-check me-2"></i> You have already reviewed this event. Thank you!
                </div>`;
            } else if (!reviewHasBooked) {
                gate.innerHTML = `<div class="alert alert-warning small text-center rounded-pill mb-4 border-0 bg-warning bg-opacity-10 text-warning-emphasis fw-bold">
                    <i class="fa-solid fa-ticket me-2"></i> You need to book a ticket for this event to leave a review.
                </div>`;
            } else if (!reviewEventEnded) {
                gate.innerHTML = `<div class="alert alert-info small text-center rounded-pill mb-4 border-0 bg-info bg-opacity-10 text-info-emphasis fw-bold">
                    <i class="fa-solid fa-clock-rotate-left me-2"></i> You can leave a review after the event has ended.
                </div>`;
            } else {
                gate.innerHTML = renderReviewForm();
            }
        }

        async function refreshReviewSnapshot() {
            try {
                const response = await fetch(`/Review/EventSnapshot?eventId=${reviewEventId}&sortOrder=${encodeURIComponent(reviewSortOrder)}`);
                const data = await response.json();
                if (!data.success) return;

                document.getElementById("review-total-count").innerText = data.totalReviews;
                document.getElementById("review-average-rating").innerText = Number(data.averageRating || 0).toFixed(1);

                const listContainer = document.getElementById("review-list");
                if (listContainer) {
                    if (data.reviews && data.reviews.length > 0) {
                        listContainer.className = "review-list";
                        listContainer.innerHTML = data.reviews.map(renderReviewItem).join("");
                    } else {
                        listContainer.className = "text-center py-4";
                        listContainer.innerHTML = `
                            <i class="fa-regular fa-comment-dots fa-3x text-muted mb-3 opacity-50"></i>
                            <p class="text-muted">No reviews yet. Be the first to review!</p>`;
                    }
                }

                renderReviewGate(data.hasReviewed);
            } catch (error) {
                console.error("Failed to refresh reviews:", error);
            }
        }

        let reviewConnection;
        document.addEventListener("DOMContentLoaded", function () {
            if (typeof signalR === "undefined") return;

            reviewConnection = new signalR.HubConnectionBuilder()
                .withUrl("https://localhost:7158/social-gateway/reviewHub", {
                    skipNegotiation: true,
                    transport: signalR.HttpTransportType.WebSockets
                })
                .withAutomaticReconnect()
                .build();

            reviewConnection.on("ReviewsChanged", function (payload) {
                if (payload && payload.eventId === reviewEventId) {
                    refreshReviewSnapshot();
                }
            });

            reviewConnection.start()
                .then(() => reviewConnection.invoke("JoinEventGroup", reviewEventId))
                .catch(err => console.error("Review SignalR connection error:", err.toString()));

            reviewConnection.onreconnected(() => {
                reviewConnection.invoke("JoinEventGroup", reviewEventId)
                    .catch(err => console.error("Review SignalR rejoin error:", err.toString()));
            });
        });

        // 1. SELECT STARS (CREATE)
        function setRating(stars) {
            document.getElementById('review-rating').value = stars;
            const starIcons = document.querySelectorAll('#star-rating i');
            starIcons.forEach((icon, index) => {
                if (index < stars) {
                    icon.classList.replace('fa-regular', 'fa-solid');
                } else {
                    icon.classList.replace('fa-solid', 'fa-regular');
                }
            });
        }

        // 2. SUBMIT REVIEW
        async function submitReview(eventId) {
            const rating = document.getElementById('review-rating').value;
            const comment = document.getElementById('review-comment').value.trim();

            if (rating == 0) {
                showToast("warning", "Please select a star rating!");
                return;
            }
            if (comment === "") {
                showToast("warning", "Please enter a review comment!");
                document.getElementById('review-comment').focus();
                return;
            }
            if (comment.length < 5) {
                showToast("warning", "Review comment is too short (minimum 5 characters)!");
                document.getElementById('review-comment').focus();
                return;
            }
            if (comment.length > 500) {
                showToast("warning", "Review comment is too long (maximum 500 characters)!");
                return;
            }

            try {
                const response = await fetch('/Review/AddReview', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ eventId: eventId, rating: parseInt(rating), comment: comment })
                });

                const data = await response.json();
                if (data.success) {
                    showToast("success", "Review submitted successfully!");
                    await refreshReviewSnapshot();
                } else {
                    showToast("danger", data.message || "Failed to submit review.");
                }
            } catch (error) {
                showToast("danger", "Connection to server failed.");
            }
        }

        // 3. SELECT STARS (EDIT)
        function setEditRating(stars) {
            document.getElementById('edit-review-rating').value = stars;
            const starIcons = document.querySelectorAll('#edit-star-rating i');
            starIcons.forEach((icon, index) => {
                if (index < stars) {
                    icon.classList.replace('fa-regular', 'fa-solid');
                } else {
                    icon.classList.replace('fa-solid', 'fa-regular');
                }
            });
        }

        // 4. OPEN EDIT MODAL
        let editModal;
        function openEditModal(reviewId, currentRating, currentComment) {
            document.getElementById('edit-review-id').value = reviewId;
            document.getElementById('edit-review-comment').value = currentComment;
            setEditRating(currentRating);

            if (!editModal) {
                editModal = new bootstrap.Modal(document.getElementById('editReviewModal'));
            }
            editModal.show();
        }

        // 5. SUBMIT EDIT REVIEW
        async function submitEditReview() {
            const reviewId = document.getElementById('edit-review-id').value;
            const rating = document.getElementById('edit-review-rating').value;
            const comment = document.getElementById('edit-review-comment').value.trim();

            if (rating == 0) {
                showToast("warning", "Please select a star rating!");
                return;
            }
            if (comment === "") {
                showToast("warning", "Please enter a review comment!");
                document.getElementById('edit-review-comment').focus();
                return;
            }
            if (comment.length < 5) {
                showToast("warning", "Review comment is too short (minimum 5 characters)!");
                document.getElementById('edit-review-comment').focus();
                return;
            }
            if (comment.length > 500) {
                showToast("warning", "Review comment is too long (maximum 500 characters)!");
                return;
            }

            try {
                const response = await fetch(`/Review/UpdateReview?id=${reviewId}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ rating: parseInt(rating), comment: comment })
                });

                const data = await response.json();
                if (data.success) {
                    showToast("success", "Review updated successfully!");
                    editModal.hide();
                    await refreshReviewSnapshot();
                } else {
                    showToast("danger", data.message || "Failed to update review.");
                }
            } catch (error) {
                showToast("danger", "Connection to server failed.");
            }
        }

        // 6. OPEN DELETE MODAL
        let deleteModal;
        function deleteReview(reviewId) {
            document.getElementById('delete-review-id').value = reviewId;
            if (!deleteModal) {
                deleteModal = new bootstrap.Modal(document.getElementById('deleteReviewModal'));
            }
            deleteModal.show();
        }

        // 7. CONFIRM DELETE REVIEW
        async function confirmDeleteReview() {
            const reviewId = document.getElementById('delete-review-id').value;
            const deleteBtn = document.querySelector('#deleteReviewModal .btn-danger');

            deleteBtn.disabled = true;
            deleteBtn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Deleting...';

            try {
                const response = await fetch(`/Review/DeleteReview?id=${reviewId}`, {
                    method: 'DELETE'
                });

                const data = await response.json();
                if (data.success) {
                    showToast("success", "Review deleted successfully!");
                    deleteModal.hide();
                    const reviewElement = document.getElementById(`review-item-${reviewId}`);
                    if (reviewElement) {
                        reviewElement.style.transition = "opacity 0.4s";
                        reviewElement.style.opacity = "0";
                    }
                    setTimeout(refreshReviewSnapshot, 350);
                } else {
                    showToast("danger", data.message || "Failed to delete review.");
                    deleteModal.hide();
                }
            } catch (error) {
                showToast("danger", "Connection error.");
                deleteModal.hide();
            } finally {
                deleteBtn.disabled = false;
                deleteBtn.innerHTML = 'Yes, Delete';
            }
        }
    </script>
}

@if (TempData["ToastMessage"] != null)
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            showToast(
                "@TempData["ToastType"]",
                "@TempData["ToastMessage"]"
            );
        });
    </script>
}
