@using WebClient.DTOs.Response
@using WebClient.ViewModel
@model SearchViewModel

@{
	ViewData["Title"] = "Home Page";
	Layout = "_Layout";
}

<link rel="stylesheet" href="~/css/home_page/home_page_style.css" />

<header class="hero-section text-center">
	<div class="container mt-4">
		<h1 class="display-3 fw-bold mb-3">Don't Miss the Moment</h1>
		<p class="lead mb-5 opacity-75">Discover concerts, workshops, and tech conferences happening near you.</p>

		<div class="row justify-content-center">
			<div class="col-lg-8">
				<form class="search-container d-flex align-items-center" asp-controller="Home" asp-action="Search" method="get">
					<div class="flex-grow-1 position-relative">
						<i class="fa-solid fa-magnifying-glass position-absolute text-muted" style="left: 20px; top: 14px;"></i>
						<input type="text" name="query" class="form-control search-input" style="padding-left: 50px;" placeholder="Search events, artists, or venues...">
					</div>
					<div class="d-none d-md-block border-start mx-2" style="height: 30px;"></div>

					<div class="d-none d-md-block" style="width: 200px;">
						<select name="categoryIds" class="form-select border-0 bg-transparent" style="box-shadow: none;">
							<option value="" selected>All Categories</option>
							@if (Model.Categories != null)
							{
								foreach (var cat in Model.Categories)
								{
									<option value="@cat.CategoryId">@cat.CategoryName</option>
								}
							}
						</select>
					</div>
					<button type="submit" class="btn btn-search text-white ms-2">Search</button>
				</form>
			</div>
		</div>
	</div>
</header>

<div class="container py-4">
	@if (User.Identity?.IsAuthenticated == true && User.IsInRole("customer"))
	{
		<section class="organizer-banner mb-5 text-center text-lg-start" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); padding: 40px; border-radius: 15px; color: white;">
			<div class="row align-items-center">
				<div class="col-lg-8">
					<h2 class="fw-bold mb-2 text-white">Create Your Own Event</h2>
					<p class="mb-0 opacity-75 text-white">Join thousands of organizers. Sell tickets, manage check-ins, and grow your community.</p>
				</div>
				<div class="col-lg-4 text-center text-lg-end mt-4 mt-lg-0">

					<form asp-controller="Profile" asp-action="RequestBecomeOrganizerOtp" method="post" class="d-inline">
						<button type="submit" class="btn btn-light rounded-pill px-5 py-3 fw-bold text-primary shadow">
							Become an Organizer
						</button>
					</form>

				</div>
			</div>
		</section>
	}
	<section class="mb-5">
		<div class="d-flex justify-content-between align-items-end mb-4">
			<div>
				<h2 class="fw-bold mb-1">Trending Events</h2>
				<p class="text-muted mb-0">Explore popular music festivals, conferences, and tech workshops</p>
			</div>
			<a asp-action="Search" asp-controller="Home" class="btn btn-outline-dark rounded-pill px-4">View All (@(Model.Events?.Count() ?? 0))</a>
		</div>

		<div class="row g-4">
			@if (Model.Events != null && Model.Events.Any())
			{
				foreach (var item in Model.Events.Take(6))
				{
					var minPrice = item.TicketTypes != null && item.TicketTypes.Any()
					? item.TicketTypes.Min(t => t.Price)
					: 0;

					var imgUrl = string.IsNullOrEmpty(item.PosterUrl)
					? "https://images.unsplash.com/photo-1470225620780-dba8ba36b745"
					: item.PosterUrl;
					bool isWishlisted = Model.WishlistedEventIds != null && Model.WishlistedEventIds.Contains(item.EventId);
					bool isEnded = DateTime.Now > item.EndDate;
					<div class="col-md-4">
						<div class="card event-card h-100 shadow-sm border-0 rounded-4 overflow-hidden">
							<div class="position-relative">
								<img src="@imgUrl" class="card-img-top" alt="@item.Title" style="height: 220px; object-fit: cover;">

								<div class="wishlist-btn @(isWishlisted ? "active" : "")"
									 onclick="toggleWishlist(@item.EventId, this)"
									 style="cursor: pointer; position: absolute; top: 12px; right: 12px; background: rgba(255,255,255,0.85); width: 36px; height: 36px; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #ef4444; backdrop-filter: blur(4px);">
									<i class="@(isWishlisted ? "fas" : "far") fa-heart"></i>
								</div>

								<span class="badge @(isEnded ? "bg-secondary" : "bg-primary") position-absolute top-0 start-0 m-3 px-3 py-2 rounded-pill fw-bold shadow-sm">
									@(isEnded ? "Ended" : "Upcoming")
								</span>
							</div>
							<div class="card-body p-3">
								<div class="event-date mb-2 text-primary fw-semibold small">
									<i class="fa-regular fa-calendar me-1"></i> @item.StartDate.ToString("MMM dd, yyyy • h:mm tt")
								</div>
								<h5 class="card-title fw-bold text-truncate" title="@item.Title">
									<a asp-action="EventDetails" asp-controller="Home" asp-route-id="@item.EventId" class="text-decoration-none text-dark">
										@item.Title
									</a>
								</h5>
								<p class="card-text text-muted small mb-3 text-truncate">
									<i class="fa-solid fa-location-dot me-1 text-danger"></i> @item.Location
								</p>
								<hr class="opacity-25 my-2">
								<div class="d-flex justify-content-between align-items-center gap-2">
									<span class="event-price fw-bold text-success fs-6">
										@(minPrice == 0 ? "Free" : $"{minPrice:N0} đ")
									</span>
									<div class="d-flex gap-2">
										@if (item.ConversationId.HasValue && item.ConversationId > 0)
										{
											<a href="/chats?conversationId=@item.ConversationId"
											   class="btn btn-sm btn-outline-info rounded-pill px-2 fw-bold"
											   title="Join event chat">
												<i class="fa-solid fa-comments"></i>
											</a>
										}
										<a asp-controller="Home" asp-action="EventDetails" asp-route-id="@item.EventId"
										   class="btn btn-sm btn-primary rounded-pill px-3 fw-bold">Details</a>
									</div>
								</div>
							</div>
						</div>
					</div>
				}
			}
			else
			{
				<div class="col-12 text-center py-5">
					<p class="text-muted">No trending events found.</p>
				</div>
			}
		</div>
	</section>

	<section class="mb-5">
		<h3 class="fw-bold mb-4">📅 More Featured Events</h3>

		<div class="row">
			<div class="col-lg-8">
				@if (Model.Events != null && Model.Events.Skip(6).Any())
				{
					foreach (var item in Model.Events.Skip(6).Take(4))
					{
						var minPrice = item.TicketTypes != null && item.TicketTypes.Any()
						? item.TicketTypes.Min(t => t.Price)
						: 0;
						var imgUrl = string.IsNullOrEmpty(item.PosterUrl)
						? "https://images.unsplash.com/photo-1540575467063-178a50c2df87"
						: item.PosterUrl;

						<a asp-controller="Home" asp-action="EventDetails" asp-route-id="@item.EventId" class="d-flex align-items-center p-3 bg-white rounded-3 shadow-sm mb-3 text-decoration-none text-dark border hover-shadow transition">
							<img src="@imgUrl" alt="@item.Title" class="rounded-3 me-3" width="90" height="90" style="object-fit: cover;">
							<div class="flex-grow-1">
								<h6 class="mb-1 fw-bold text-truncate" style="max-width: 350px;">@item.Title</h6>
								<p class="mb-1 small text-muted text-truncate" style="max-width: 350px;"><i class="fa-solid fa-location-dot me-1"></i> @item.Location • @item.StartDate.ToString("MMM dd, yyyy")</p>
								<span class="badge bg-light text-primary border border-primary-subtle">@item.StartDate.ToString("h:mm tt")</span>
							</div>
							<div class="text-end ms-2">
								<div class="fw-bold text-success fs-6">@(minPrice == 0 ? "Free" : $"{minPrice:N0} đ")</div>
								<small class="text-muted"><i class="fa-solid fa-chevron-right"></i></small>
							</div>
						</a>
					}
				}
				else
				{
					<p class="text-muted">Check back soon for more events!</p>
				}
			</div>

			<div class="col-lg-4">
				<div class="h-100 p-4 rounded-3 text-white d-flex flex-column justify-content-center align-items-center text-center shadow-sm" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
					<i class="fa-solid fa-gift fa-3x mb-3"></i>
					<h4>Special Offer</h4>
					<p class="small opacity-75">Get 20% off your first booking with promo code: <strong>WELCOME2026</strong></p>
				</div>
			</div>
		</div>
	</section>

	<section class="organizer-banner mb-5 text-center text-lg-start">
		<div class="row align-items-center">
			<div class="col-lg-8">
				<h2 class="fw-bold mb-2">Create Your Own Event</h2>
				<p class="mb-0 opacity-75">Join thousands of organizers. Sell tickets, manage check-ins, and grow your community.</p>
			</div>
			<div class="col-lg-4 text-center text-lg-end mt-4 mt-lg-0">
				<a href="#" class="btn btn-light rounded-pill px-5 py-3 fw-bold text-primary shadow">Start for Free</a>
			</div>
		</div>
	</section>

</div>

@section Scripts {
	<script src="./js/home_page/home_page.js"></script>
	<script src="~/js/common/toast.js"></script>

	<script>
		async function toggleWishlist(eventId, element) {

			const isAdding = !element.classList.contains('active');

			element.style.pointerEvents = 'none';

			try {
				// 2. Call API
				const response = await fetch('/Wishlist/ToggleWishlist', {
					method: 'POST',
					headers: {
						'Content-Type': 'application/json'
					},
					body: JSON.stringify({
						eventId: eventId,
						isAdding: isAdding
					})
				});

				const data = await response.json();

				if (data.success) {
					if (isAdding) {
						element.classList.add('active');
					} else {
						element.classList.remove('active');
					}
				}
				else if (data.message === "unauthorized") {
					if (typeof showToast === "function") showToast("error", "Please log in to save events!");
				}
				else {
					if (typeof showToast === "function") showToast("error", "An error occurred, please try again.");
				}
			} catch (error) {
				console.error("Error:", error);
				if (typeof showToast === "function") showToast("error", "Unable to connect to the server.");
			} finally {
				element.style.pointerEvents = 'auto';
			}
		}
	</script>
}
@if (TempData["ToastMessage"] != null)
{
	<script>
		document.addEventListener("DOMContentLoaded", function () {
			showToast(
				"@TempData["ToastType"]",
				"@TempData["ToastMessage"]"
			);
		});
	</script>
}