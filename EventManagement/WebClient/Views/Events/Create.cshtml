@using WebClient.Controllers
@model WebClient.Controllers.CreateEventViewModel
@{
    ViewData["Title"] = "Create Event";
    Layout = "_LayoutStaff";
}

<style>
    .wizard-stepper {
        display: flex;
        justify-content: space-between;
        margin-bottom: 2rem;
        position: relative;
        background: white;
        padding: 1.25rem 2rem;
        border-radius: 16px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.03);
    }
    .wizard-step {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-weight: 600;
        color: #94a3b8;
        cursor: pointer;
        transition: all 0.3s ease;
        z-index: 2;
    }
    .wizard-step.active {
        color: #4f46e5;
    }
    .wizard-step.completed {
        color: #10b981;
    }
    .step-badge {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: #f1f5f9;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.9rem;
    }
    .wizard-step.active .step-badge {
        background: #4f46e5;
        color: white;
        box-shadow: 0 4px 12px rgba(79, 70, 229, 0.3);
    }
    .wizard-step.completed .step-badge {
        background: #10b981;
        color: white;
    }

    .card-section {
        background: white;
        border-radius: 16px;
        padding: 2rem;
        margin-bottom: 1.5rem;
        box-shadow: 0 4px 6px -1px rgba(0,0,0,0.04);
        border: 1px solid #f1f5f9;
    }

    #map {
        height: 360px;
        width: 100%;
        border-radius: 12px;
        margin-top: 10px;
        z-index: 1;
    }

    .search-container {
        position: relative;
    }
    .search-results {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 0 0 10px 10px;
        max-height: 220px;
        overflow-y: auto;
        z-index: 100;
        box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        display: none;
    }
    .search-results div {
        padding: 10px 14px;
        cursor: pointer;
        border-bottom: 1px solid #f8fafc;
        font-size: 0.9rem;
        transition: background 0.2s;
    }
    .search-results div:hover {
        background: #eff6ff;
        color: #2563eb;
    }

    /* Live Preview Card */
    .preview-card {
        background: white;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        border: 1px solid #e2e8f0;
        position: sticky;
        top: 90px;
    }
    .preview-card-img {
        height: 200px;
        width: 100%;
        object-fit: cover;
        background: #f1f5f9;
    }
    .preview-badge-cat {
        background: rgba(79, 70, 229, 0.1);
        color: #4f46e5;
        font-size: 0.75rem;
        font-weight: 700;
        padding: 0.35rem 0.75rem;
        border-radius: 20px;
        text-transform: uppercase;
    }

    .btn-preset-ticket {
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 600;
        padding: 0.4rem 1rem;
        transition: all 0.2s;
    }
    .btn-preset-ticket:hover {
        transform: translateY(-2px);
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-3">
    <a asp-action="Index" class="text-decoration-none text-muted small fw-500">
        <i class="fa-solid fa-arrow-left me-1"></i> Back to Events
    </a>
    <span class="badge bg-primary-subtle text-primary px-3 py-2 rounded-pill fw-bold">
        <i class="fa-solid fa-wand-magic-sparkles me-1"></i> Next-Gen Event Creator
    </span>
</div>

<!-- Wizard Stepper -->
<div class="wizard-stepper">
    <div class="wizard-step active" id="stepIndicator1" onclick="goToStep(1)">
        <div class="step-badge"><i class="fa-solid fa-file-pen"></i></div>
        <div>
            <div class="small text-uppercase text-muted" style="font-size:0.7rem;">Step 1</div>
            <div>General Info & Media</div>
        </div>
    </div>
    <div class="wizard-step" id="stepIndicator2" onclick="goToStep(2)">
        <div class="step-badge"><i class="fa-solid fa-location-dot"></i></div>
        <div>
            <div class="small text-uppercase text-muted" style="font-size:0.7rem;">Step 2</div>
            <div>Schedule & Venue</div>
        </div>
    </div>
    <div class="wizard-step" id="stepIndicator3" onclick="goToStep(3)">
        <div class="step-badge"><i class="fa-solid fa-ticket"></i></div>
        <div>
            <div class="small text-uppercase text-muted" style="font-size:0.7rem;">Step 3</div>
            <div>Tickets & Pricing</div>
        </div>
    </div>
</div>

<form asp-action="Create" method="post" enctype="multipart/form-data" id="eventCreateForm" novalidate>
    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="alert alert-danger mb-3"></div>
    }

    <div id="stepErrorAlert" class="alert alert-danger alert-dismissible fade show" style="display:none;" role="alert">
        <i class="fa-solid fa-triangle-exclamation me-2"></i> <span id="stepErrorText">Please fill in all required fields before proceeding.</span>
        <button type="button" class="btn-close" onclick="document.getElementById('stepErrorAlert').style.display='none'"></button>
    </div>

    <div class="row g-4">
        <!-- Main Form Wizard Column -->
        <div class="col-lg-7 col-xl-8">
            
            <!-- STEP 1: General Info & Media -->
            <div class="step-pane" id="stepPane1">
                <div class="card-section">
                    <h5 class="fw-bold mb-3 d-flex align-items-center">
                        <i class="fa-solid fa-circle-info text-primary me-2"></i> Event Basic Information
                    </h5>
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label fw-semibold">Event Title <span class="text-danger">*</span></label>
                            <input asp-for="Title" id="inputTitle" class="form-control form-control-lg" placeholder="e.g. Summer Indie Music Festival 2026" maxlength="200" oninput="updateLivePreview()" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Category <span class="text-danger">*</span></label>
                            <select asp-for="CategoryId" id="selectCategory" class="form-select" onchange="updateLivePreview()">
                                @foreach (var c in ViewBag.Categories)
                                {
                                    <option value="@c.CategoryId">@c.CategoryName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Event Cover Poster</label>
                            <div class="input-group">
                                <input asp-for="PosterImage" id="inputPosterFile" type="file" class="form-control" accept="image/*" onchange="previewUploadImage(this)" />
                                <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#unsplashModal" title="Pick stock cover">
                                    <i class="fa-solid fa-images me-1"></i> Stock
                                </button>
                            </div>
                            <input type="hidden" id="inputPosterUrl" name="PosterUrl" />
                        </div>
                        
                        <div class="col-12">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label class="form-label fw-semibold mb-0">Event Description</label>
                                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3" onclick="generateAiDescription()">
                                    <i class="fa-solid fa-wand-magic-sparkles me-1"></i> Auto-Generate Description
                                </button>
                            </div>
                            <textarea asp-for="Description" id="inputDescription" class="form-control" rows="5" placeholder="Write compelling event details, highlights, and schedule..." oninput="updateLivePreview()"></textarea>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end">
                    <button type="button" class="btn btn-primary px-4 rounded-pill" onclick="goToStep(2)">
                        Next: Schedule & Venue <i class="fa-solid fa-arrow-right ms-1"></i>
                    </button>
                </div>
            </div>

            <!-- STEP 2: Schedule & Venue -->
            <div class="step-pane" id="stepPane2" style="display:none;">
                <div class="card-section">
                    <h5 class="fw-bold mb-3 d-flex align-items-center">
                        <i class="fa-solid fa-clock-stopwatch text-warning me-2"></i> Date & Time Schedule
                    </h5>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Event Start Date & Time <span class="text-danger">*</span></label>
                            <input asp-for="StartDate" id="inputStartDate" type="datetime-local" class="form-control" value="@DateTime.Now.AddDays(7).ToString("yyyy-MM-ddTHH:mm")" onchange="updateLivePreview()" />
                            <span asp-validation-for="StartDate" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Event End Date & Time <span class="text-danger">*</span></label>
                            <input asp-for="EndDate" id="inputEndDate" type="datetime-local" class="form-control" value="@DateTime.Now.AddDays(7).AddHours(4).ToString("yyyy-MM-ddTHH:mm")" onchange="updateLivePreview()" />
                            <span asp-validation-for="EndDate" class="text-danger small"></span>
                        </div>
                    </div>

                    <h5 class="fw-bold mb-3 d-flex align-items-center">
                        <i class="fa-solid fa-map-location-dot text-danger me-2"></i> Venue & Geocoding Location
                    </h5>
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label fw-semibold">Search Venue Address (Autocomplete & FlyTo)</label>
                            <div class="search-container mb-2">
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fa-solid fa-magnifying-glass"></i></span>
                                    <input type="text" id="searchBox" class="form-control" placeholder="Type venue name or address (e.g. Saigon Exhibition Center, District 7)..." autocomplete="off" />
                                </div>
                                <div id="searchResults" class="search-results"></div>
                            </div>
                        </div>

                        <input type="hidden" id="latitudeInput" name="Latitude" />
                        <input type="hidden" id="longitudeInput" name="Longitude" />

                        <div class="col-12">
                            <label class="form-label fw-semibold">Confirmed Address Description <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="fa-solid fa-location-dot text-danger"></i></span>
                                <input asp-for="Location" id="locationInput" class="form-control" placeholder="Select location on map or search above..." oninput="updateLivePreview()" />
                            </div>
                        </div>

                        <div class="col-12">
                            <div id="map"></div>
                            <small class="text-muted"><i class="fa-solid fa-info-circle me-1"></i> Click anywhere on the interactive map or drag the pin to set precise coordinates.</small>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between">
                    <button type="button" class="btn btn-outline-secondary px-4 rounded-pill" onclick="goToStep(1)">
                        <i class="fa-solid fa-arrow-left me-1"></i> Back
                    </button>
                    <button type="button" class="btn btn-primary px-4 rounded-pill" onclick="goToStep(3)">
                        Next: Tickets & Pricing <i class="fa-solid fa-arrow-right ms-1"></i>
                    </button>
                </div>
            </div>

            <!-- STEP 3: Tickets & Pricing -->
            <div class="step-pane" id="stepPane3" style="display:none;">
                <div class="card-section">
                    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
                        <h5 class="fw-bold mb-0 d-flex align-items-center">
                            <i class="fa-solid fa-tags text-success me-2"></i> Ticket Types Configuration
                        </h5>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-sm btn-outline-success btn-preset-ticket" onclick="addPresetTicket('free')">
                                <i class="fa-solid fa-gift me-1"></i> + Free Pass
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-warning btn-preset-ticket text-dark" onclick="addPresetTicket('early')">
                                <i class="fa-solid fa-bolt me-1"></i> + Early Bird
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-primary btn-preset-ticket" onclick="addPresetTicket('vip')">
                                <i class="fa-solid fa-crown me-1"></i> + VIP Pass
                            </button>
                            <button type="button" class="btn btn-sm btn-primary rounded-pill px-3" onclick="addTicketRow()">
                                <i class="fa-solid fa-plus me-1"></i> Custom Row
                            </button>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table align-middle table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="min-width: 140px;">Ticket Name <span class="text-danger">*</span></th>
                                    <th style="min-width: 110px;">Price (VND)</th>
                                    <th style="min-width: 80px;">Qty</th>
                                    <th style="min-width: 60px;">Badge</th>
                                    <th style="min-width: 150px;">Sale Start</th>
                                    <th style="min-width: 150px;">Sale End</th>
                                    <th style="width: 40px;"></th>
                                </tr>
                            </thead>
                            <tbody id="ticketList">
                                <tr>
                                    <td><input name="TicketTypes[0].TypeName" class="form-control form-control-sm" required maxlength="100" placeholder="Standard Ticket" value="Standard Pass" oninput="updateLivePreview()" /></td>
                                    <td><input name="TicketTypes[0].Price" type="number" class="form-control form-control-sm" value="150000" min="0" max="100000000" oninput="updateLivePreview()" /></td>
                                    <td><input name="TicketTypes[0].Quantity" type="number" class="form-control form-control-sm" value="100" min="1" max="100000" /></td>
                                    <td><input name="TicketTypes[0].ColorCode" type="color" class="form-control form-control-color w-100" value="#4f46e5" /></td>
                                    <td><input name="TicketTypes[0].SaleStartDate" type="datetime-local" class="form-control form-control-sm" /></td>
                                    <td><input name="TicketTypes[0].SaleEndDate" type="datetime-local" class="form-control form-control-sm" /></td>
                                    <td></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center">
                    <button type="button" class="btn btn-outline-secondary px-4 rounded-pill" onclick="goToStep(2)">
                        <i class="fa-solid fa-arrow-left me-1"></i> Back
                    </button>
                    <button type="submit" class="btn btn-success px-5 py-2.5 rounded-pill fw-bold shadow-sm">
                        <i class="fa-solid fa-paper-plane me-2"></i> Create Event Now
                    </button>
                </div>
            </div>

        </div>

        <!-- Right Side Live Preview Panel -->
        <div class="col-lg-5 col-xl-4">
            <div class="preview-card">
                <div class="position-relative">
                    <img id="livePreviewImg" src="https://images.unsplash.com/photo-1501386761578-eac5c94b800a?auto=format&fit=crop&w=800&q=80" class="preview-card-img" alt="Live Preview" />
                    <span id="livePreviewCat" class="preview-badge-cat position-absolute top-0 start-0 m-3 shadow-sm">Category</span>
                </div>
                <div class="p-3">
                    <div id="livePreviewDate" class="text-danger fw-bold small text-uppercase mb-1">
                        <i class="fa-regular fa-calendar me-1"></i> Sat, Aug 15 • 19:00
                    </div>
                    <h5 id="livePreviewTitle" class="fw-bold mb-2 text-dark">Event Title Placeholder</h5>
                    <div id="livePreviewLocation" class="text-muted small mb-3">
                        <i class="fa-solid fa-location-dot text-danger me-1"></i> Venue location will appear here...
                    </div>
                    <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                        <span class="text-muted small">Starting Price</span>
                        <span id="livePreviewPrice" class="fw-bold text-success fs-5">150,000 ₫</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

<!-- Stock Covers Modal -->
