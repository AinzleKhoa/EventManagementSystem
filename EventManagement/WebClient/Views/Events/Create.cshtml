                        <div class="text-center small fw-semibold mt-1">Tech & Conference</div>
                    </div>
                    <div class="col-md-4">
                        <img src="https://images.unsplash.com/photo-1511578314322-379afb476865?auto=format&fit=crop&w=600&q=80" class="img-fluid rounded border cursor-pointer hover-shadow" onclick="selectStockCover(this.src)" alt="Workshop" />
                        <div class="text-center small fw-semibold mt-1">Business & Workshop</div>
                    </div>
                    <div class="col-md-4">
                        <img src="https://images.unsplash.com/photo-1555396273-367ea4eb4db5?auto=format&fit=crop&w=600&q=80" class="img-fluid rounded border cursor-pointer hover-shadow" onclick="selectStockCover(this.src)" alt="Food" />
