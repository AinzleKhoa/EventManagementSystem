@model WebClient.DTOs.Response.PaginatedResultDTO<WebClient.DTOs.Response.ReadEventDTO>
@{
    ViewData["Title"] = "Organizer Dashboard";
    Layout = "_LayoutStaff";
    string GetSortIcon(string column)
    {
        if (ViewData["SortBy"]?.ToString() != column) return "fa-sort";
        return ViewData["SortOrder"]?.ToString() == "asc" ? "fa-sort-up" : "fa-sort-down";
    }

    string GetNextSortOrder(string column)
    {
        if (ViewData["SortBy"]?.ToString() != column) return "asc";
        return ViewData["SortOrder"]?.ToString() == "asc" ? "desc" : "asc";
    }
}
<link rel="stylesheet" href="~/css/common/page_header_dashboard.css" />

<style>
    /* Top Bar */
    .top-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
    }

    .btn-create {
        background: var(--primary-color);
        color: white;
        border: none;
        padding: 0.7rem 1.5rem;
        border-radius: 10px;
        font-weight: 600;
        box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
        transition: 0.3s;
    }

        .btn-create:hover {
            transform: translateY(-2px);
            background-color: #4f46e5;
        }

    /* Stats Cards */
    .stat-card {
        background: white;
        border-radius: 16px;
        padding: 1.5rem;
        border: none;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        height: 100%;
        transition: 0.3s;
    }

        .stat-card:hover {
            transform: translateY(-5px);
        }

    .stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        margin-bottom: 1rem;
    }

    .bg-icon-primary {
        background: #e0e7ff;
        color: var(--primary-color);
    }

    .bg-icon-success {
        background: #dcfce7;
        color: #10b981;
    }

    .bg-icon-warning {
        background: #fef3c7;
        color: #f59e0b;
    }

    .bg-icon-info {
        background: #e0f2fe;
        color: #0ea5e9;
    }

    /* Tables */
    .table-card {
        background: white;
        border-radius: 16px;
        padding: 1.5rem;
        border: none;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }

    .table th {
        font-weight: 600;
        color: #64748b;
        border-bottom-width: 1px;
        padding-bottom: 1rem;
        cursor: pointer;
    }

    .table td {
        vertical-align: middle;
        padding: 1rem 0.5rem;
        color: #334155;
    }

    .status-badge {
        padding: 5px 12px;
        border-radius: 50px;
        font-size: 0.8rem;
        font-weight: 600;
    }


    .status-approved {
        background: #dcfce7;
        color: #166534;
    }

    .status-pending {
        background: #ffedd5;
        color: #9a3412;
    }

    .status-draft {
        background: #f1f5f9;
        color: #475569;
    }

    .status-hidden {
        background: #e2e8f0;
        color: #475569;
    }

    .action-btn {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: none;
        background: transparent;
        color: #64748b;
        transition: 0.2s;
        text-decoration: none;
    }

        .action-btn:hover {
            background: #f1f5f9;
            color: var(--primary-color);
        }
</style>

<div>
    <header class="top-bar page-header">
        <div>
            <h3 class="fw-bold mb-1">Dashboard</h3>
            <p class="text-secondary mb-0">Welcome back 👋</p>
        </div>

        <a asp-controller="Events" asp-action="Create" class="btn btn-create">
            <i class="fa-solid fa-plus me-2"></i>Create Event
        </a>
    </header>

    <div class="row g-4 mb-5">
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-icon bg-icon-success">
                    <i class="fa-solid fa-dollar-sign"></i>
                </div>
                <h6 class="text-muted small fw-bold text-uppercase">Total Revenue</h6>
                <h3 class="fw-bold mb-0 text-success" id="txtTotalRevenue">@string.Format("{0:N0}", ViewBag.TotalRevenue ?? 0) ₫</h3>
                <small class="text-muted">All time revenue</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-icon bg-icon-primary">
                    <i class="fa-solid fa-ticket"></i>
                </div>
                <h6 class="text-muted small fw-bold text-uppercase">Tickets Sold</h6>
                <h3 class="fw-bold mb-0 text-primary" id="txtTicketsSold">@(ViewBag.TotalTicketsSold ?? 0)</h3>
                <small class="text-muted">Total sold tickets</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-icon bg-icon-info">
                    <i class="fa-solid fa-calendar-check"></i>
                </div>
                <h6 class="text-muted small fw-bold text-uppercase">Active Events</h6>
                <h3 class="fw-bold mb-0" id="txtActiveEvents">@(ViewBag.ActiveEvents ?? 0)</h3>
                <small class="text-muted">Currently Approved</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-icon bg-icon-warning">
                    <i class="fa-solid fa-star"></i>
                </div>
                <h6 class="text-muted small fw-bold text-uppercase">Total Events</h6>
                <h3 class="fw-bold mb-0">@(Model?.TotalCount ?? 0)</h3>
                <small class="text-muted">In system</small>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-md-8">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 16px;">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-4 text-dark">Revenue & Tickets Trends</h5>
                    <div style="height: 300px; width: 100%;">
                        <canvas id="revenueChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 16px;">
                <div class="card-body p-4 d-flex flex-column align-items-center">
                    <h5 class="fw-bold mb-4 text-dark w-100 text-start">Events Status Overview</h5>
                    <div style="height: 250px; width: 100%; display: flex; justify-content: center;">
                        <canvas id="statusChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <form method="get" asp-action="Organizer" class="card p-3 mb-4 border-0 shadow-sm" style="border-radius: 16px;">
        <div class="row g-3 align-items-end">
            <div class="col-md-5">
                <label class="form-label fw-semibold text-muted small mb-2">
                    <i class="fa-solid fa-magnifying-glass me-1"></i> Search
                </label>
                <input type="text"
                       name="searchTerm"
                       value="@ViewData["SearchTerm"]"
                       class="form-control bg-light border-0"
                       placeholder="Search by title..."
                       style="border-radius: 10px; padding: 0.65rem 1rem;">
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold text-muted small mb-2">
                    <i class="fa-solid fa-filter me-1"></i> Status
                </label>
                <select name="status" class="form-select bg-light border-0" style="border-radius: 10px; padding: 0.65rem 1rem;">
                    <option value="">All Status</option>
                    <option value="Approved" selected="@(ViewData["Status"]?.ToString() == "Approved")">✓ Approved</option>
                    <option value="Pending" selected="@(ViewData["Status"]?.ToString() == "Pending")">⏳ Pending</option>
                    <option value="Draft" selected="@(ViewData["Status"]?.ToString() == "Draft")">✎ Draft</option>
                </select>
            </div>
            <div class="col-md-4">
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-grow-1" style="border-radius: 10px; font-weight: 600;">
                        <i class="fa-solid fa-search me-2"></i> Search
                    </button>
                    <a asp-action="Organizer" class="btn btn-light" title="Reset filters" style="border-radius: 10px;">
                        <i class="fa-solid fa-rotate-right"></i>
                    </a>
                </div>
            </div>
        </div>
    </form>

    <div class="row">
        <div class="col-12">
            <div class="table-card">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="fw-bold mb-0">Recent Events</h5>
                    <a href="#" class="text-decoration-none small fw-bold text-primary">View All</a>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover border-top">
                        <thead>
                            <tr>
                                <th onclick="location.href='?searchTerm=@ViewData["SearchTerm"]&status=@ViewData["Status"]&sortBy=Title&sortOrder=@GetNextSortOrder("Title")&pageNumber=1'">
                                    Event Name <i class="fa-solid @GetSortIcon("Title")"></i>
                                </th>
                                <th onclick="location.href='?searchTerm=@ViewData["SearchTerm"]&status=@ViewData["Status"]&sortBy=StartDate&sortOrder=@GetNextSortOrder("StartDate")&pageNumber=1'">
                                    Date <i class="fa-solid @GetSortIcon("StartDate")"></i>
                                </th>
                                <th onclick="location.href='?searchTerm=@ViewData["SearchTerm"]&status=@ViewData["Status"]&sortBy=Status&sortOrder=@GetNextSortOrder("Status")&pageNumber=1'">
                                    Status <i class="fa-solid @GetSortIcon("Status")"></i>
                                </th>
                                <th>Sold</th>
                                <th>Revenue</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Items.Any())
                            {
                                foreach (var e in Model.Items)
                                {
                                    <tr id="event-row-@e.EventId">
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <img src="https://placehold.co/40x40" class="rounded me-3" alt="Thumb">
                                                <div>
                                                    <div class="fw-bold">@e.Title</div>
                                                    <small class="text-muted">Event ID: @e.EventId</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td>@e.StartDate.ToString("MMM dd, yyyy")</td>
                                        <td>
                                            @if (e.Status == "Approved")
                                            {
                                                <span class="status-badge status-approved">Approved</span>
                                            }
                                            else if (e.Status == "Pending")
                                            {
                                                <span class="status-badge status-pending">Pending</span>
                                            }
                                            else if (e.Status == "Draft")
                                            {
                                                <span class="status-badge status-draft">Draft</span>
                                            }
                                            else
                                            {
                                                <span class="status-badge status-hidden">@e.Status</span>
                                            }
                                        </td>
                                        <td class="fw-bold text-primary">
                                            @if (ViewBag.EventTickets != null && ViewBag.EventTickets.ContainsKey(e.EventId))
                                            {
                                                @ViewBag.EventTickets[e.EventId]
                                            }
                                            else
                                            {
                                                @:0
                                            }
                                        </td>

                                        <td class="fw-bold text-success">
                                            @if (ViewBag.EventRevenues != null && ViewBag.EventRevenues.ContainsKey(e.EventId))
                                            {
                                                var rev = (long)ViewBag.EventRevenues[e.EventId];
                                                @string.Format("{0:N0} ₫", rev)
                                            }
                                            else
                                            {
                                                @:0 ₫
                                            }
                                        </td>
                                        <td class="text-end">
                                            <a asp-action="EventOrders" asp-route-eventId="@e.EventId" class="action-btn text-success" title="View Orders">
                                                <i class="fa-solid fa-cart-shopping"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-5">
                                        <div class="empty-state">
                                            <i class="fa-solid fa-calendar-days fa-3x text-muted mb-3 opacity-50"></i>
                                            <h6 class="text-muted">No Events Found</h6>
                                            <p class="text-muted small mb-3">Try adjusting your search or filters</p>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (Model != null && Model.TotalPages > 1)
                {
                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <div class="text-muted small">
                            Showing <strong>@((Model.PageNumber - 1) * Model.PageSize + 1)–@(Math.Min(Model.PageNumber * Model.PageSize, Model.TotalCount))</strong>
                            of <strong>@Model.TotalCount</strong> events
                        </div>
                        <nav>
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                                    <a class="page-link" asp-action="Organizer" asp-route-pageNumber="@(Model.PageNumber - 1)" asp-route-searchTerm="@ViewData["SearchTerm"]" asp-route-status="@ViewData["Status"]" asp-route-sortBy="@ViewData["SortBy"]" asp-route-sortOrder="@ViewData["SortOrder"]">
                                        <i class="fa-solid fa-chevron-left"></i>
                                    </a>
                                </li>
                                @for (int i = Math.Max(1, Model.PageNumber - 2); i <= Math.Min(Model.TotalPages, Model.PageNumber + 2); i++)
                                {
                                    <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                        <a class="page-link" asp-action="Organizer" asp-route-pageNumber="@i" asp-route-searchTerm="@ViewData["SearchTerm"]" asp-route-status="@ViewData["Status"]" asp-route-sortBy="@ViewData["SortBy"]" asp-route-sortOrder="@ViewData["SortOrder"]">@i</a>
                                    </li>
                                }
                                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                                    <a class="page-link" asp-action="Organizer" asp-route-pageNumber="@(Model.PageNumber + 1)" asp-route-searchTerm="@ViewData["SearchTerm"]" asp-route-status="@ViewData["Status"]" asp-route-sortBy="@ViewData["SortBy"]" asp-route-sortOrder="@ViewData["SortOrder"]">
                                        <i class="fa-solid fa-chevron-right"></i>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@if (TempData["ToastMessage"] != null)
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            showToast("@TempData["ToastType"]", "@TempData["ToastMessage"]");
        });
    </script>
}

@section Scripts {
    <script src="~/js/common/toast.js"></script>
    <script src="~/js/common/confirm_popup.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const revCtx = document.getElementById('revenueChart').getContext('2d');

            const revLabels = @Html.Raw(Json.Serialize(ViewBag.RevenueMonthLabels));
            const revData = @Html.Raw(Json.Serialize(ViewBag.RevenueData));
            const ticketData = @Html.Raw(Json.Serialize(ViewBag.TicketsData));

            new Chart(revCtx, {
                type: 'bar',
                data: {
                    labels: revLabels,
                    datasets: [
                        {
                            label: 'Revenue (VNĐ)',
                            data: revData,
                            backgroundColor: 'rgba(99, 102, 241, 0.8)',
                            borderRadius: 6,
                            yAxisID: 'y'
                        },
                        {
                            label: 'Tickets Sold',
                            data: ticketData,
                            type: 'line',
                            borderColor: '#10b981',
                            backgroundColor: '#10b981',
                            borderWidth: 3,
                            tension: 0.3,
                            yAxisID: 'y1'
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: { mode: 'index', intersect: false },
                    plugins: { legend: { position: 'top' } },
                    scales: {
                        y: {
                            type: 'linear', display: true, position: 'left',
                            title: { display: true, text: 'Revenue (VNĐ)' }
                        },
                        y1: {
                            type: 'linear', display: true, position: 'right',
                            grid: { drawOnChartArea: false },
                            title: { display: true, text: 'Tickets' }
                        }
                    }
                }
            });


            const statusCtx = document.getElementById('statusChart').getContext('2d');

            const statusLabels = @Html.Raw(Json.Serialize(ViewBag.StatusLabels));
            const statusData = @Html.Raw(Json.Serialize(ViewBag.StatusData));

            new Chart(statusCtx, {
                type: 'doughnut',
                data: {
                    labels: statusLabels,
                    datasets: [{
                        data: statusData,
                        backgroundColor: ['#10b981', '#f59e0b', '#94a3b8', '#475569'],
                        borderWidth: 0,
                        hoverOffset: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '70%',
                    plugins: { legend: { position: 'bottom' } }
                }
            });

            const organizerId = "@(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "3")";

            function formatCurrency(amount) {
                return new Intl.NumberFormat('vi-VN').format(amount) + ' ₫';
            }

            function fetchNewData() {
                fetch('/Dashboard/GetDashboardStats')
                    .then(response => response.json())
                    .then(data => {

                        document.getElementById('txtTotalRevenue').innerText =
                            new Intl.NumberFormat('vi-VN').format(data.revenue) + ' ₫';
                        document.getElementById('txtTicketsSold').innerText = data.tickets;
                        document.getElementById('txtActiveEvents').innerText = data.active;
                    });
            }
        const connection = new signalR.HubConnectionBuilder()
                        .withUrl("https://localhost:7158/notification-gateway/dashboardHub", {
                            skipNegotiation: true,
                            transport: signalR.HttpTransportType.WebSockets
                        })
                        .withAutomaticReconnect([0, 2000, 5000, 10000, 20000])
                        .configureLogging(signalR.LogLevel.Information)
                        .build();

            connection.on("UpdateDashboard", function () {
                console.log("New order received! Reloading data...");
                fetchNewData();
                showToast("success", "A new ticket has been sold!");
            });

            connection.start().then(function () {
                console.log("SignalR connection established via the Gateway.");
               @if (Model != null && Model.Items.Any())
                {
                                    foreach (var e in Model.Items)
                                    {
                                                        <text>
                                                        connection.invoke("JoinEventGroup", @e.EventId)
                                                                  .catch(err => console.error("Lỗi join group:", err.toString()));
                                                        </text>
                                    }
                }
            }).catch(function (err) {
                return console.error("Lỗi kết nối SignalR:", err.toString());
            });

        });

    </script>
}